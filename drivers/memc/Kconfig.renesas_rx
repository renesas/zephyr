config MEMC_RENESAS_RX_XSPI_CONTROLLER_PSRAM
	bool "Renesas RX XSPI Controller PSRAM controller"
	default y
	depends on DT_HAS_RENESAS_RX_XSPI_PSRAM_ENABLED
	select USE_RX_FSP_XSPI_CONTROLLER
	select PINCTRL
	help
	  Enable Renesas RX XSPI Controller PSRAM controller

config MEMC_RENESAS_RX_SDRAM
	bool "Renesas RX sdram controller"
	default y
	depends on DT_HAS_RENESAS_RX_SDRAM_ENABLED
	select USE_RX_FSP_SDRAM
	help
	  Enable Renesas RX sdram controller
