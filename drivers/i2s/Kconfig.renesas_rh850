config I2S_RENESAS_RH850_SSIF
	bool "Renesas RH850 I2S SSIF"
	default y
	depends on DT_HAS_RENESAS_RH850_I2S_SSIF_ENABLED
	select USE_RH850_FSP_SSI
	select PINCTRL
	help
	  Enable Renesas RH850 I2S SSIF Driver.

if I2S_RENESAS_RH850_SSIF

config I2S_RENESAS_RH850_SSIF_RX_BLOCK_COUNT
	int "RX queue length"
	default 4
	range 1 255

config I2S_RENESAS_RH850_SSIF_TX_BLOCK_COUNT
	int "TX queue length"
	default 4
	range 1 255

endif # I2S_RENESAS_RH850_SSIF
