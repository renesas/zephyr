config PHY_RENESAS_PCS
	bool "Renesas R-Car Ethernet PCS channel driver"
	select RENESAS_RCAR_MP_PHY
	help
	  Enable this to support the Ethernet Physical Coding Sublayer (PCS)
	  channels found on Renesas R-Car SoCs. Each channel acts as an
	  internal PHY, connecting the MAC to a SERDES lane (MP-PHY).

if PHY_RENESAS_PCS

config PHY_RENESAS_PCS_BLOCK_INIT_PRIORITY
	int "Renesas R-Car Ethernet PCS block init priority"
	default 51
	help
	  Renesas R-Car Ethernet PCS block (renesas,r8a78000-ether-pcs)
	  initialization priority. Releases Module Standby for every PCS
	  channel underneath it. Must run after the MP-PHY device and before
	  PHY_RENESAS_PCS_INIT_PRIORITY.

config PHY_RENESAS_PCS_INIT_PRIORITY
	int "Renesas R-Car Ethernet PCS channel init priority"
	default 52
	help
	  Renesas R-Car Ethernet PCS channel initialization priority.
	  This must run after the PCS block device and before R-Switch 3.

config PHY_RENESAS_PCS_TIMEOUT_US
	int "Register access timeout (us)"
	default 100000
	help
	  Timeout in microseconds for waiting on PCS register bit changes
	  during SERDES bring-up.

endif # PHY_RENESAS_PCS

config PHY_RENESAS_Q32XX
	bool "Renesas Q32XX PHY Driver"
	default y
	depends on DT_HAS_RENESAS_Q32XX_PHY_ENABLED
	select MDIO
	help
	  Enable Renesas Q32XX Ethernet PHY driver
