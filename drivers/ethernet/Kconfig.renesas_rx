config ETH_RENESAS_RX_RMAC
	bool "Renesas RX RMAC Ethernet"
	default y
	depends on DT_HAS_RENESAS_RX_RMAC_ENABLED
	select USE_RX_FSP_RMAC
	select RENESAS_RX_GRP_INTC_FSP
	select MDIO
	help
	  Enable Renesas RX RMAC Ethernet Driver.

if ETH_RENESAS_RX_RMAC

config ETH_RENESAS_RX_RMAC_THREAD_STACK_SIZE
	int "Stack size for internal incoming packet handler"
	default 1500
	help
	  Size of the stack used for internal thread which is ran for
	  incoming packet processing.

config ETH_RENESAS_RX_RMAC_THREAD_PRIORITY
	int "Renesas RX RMAC Ethernet receive thread priority"
	default 2

config ETH_RENESAS_RX_RMAC_BUF_SIZE
	int "TX/RX data buffer size"
	default 1536
	range 1514 1536
	help
	  Size, in bytes, of the TX data buffer. The size must be big enough to
	  store one complete Ethernet frame, and be a multiple of 8.

config ETH_RENESAS_RX_RMAC_BROADCAST_FILTER
	int "TX/RX data buffer size"
	default 65535
	range 0 65535
	help
	  Limit of the number broadcast frame received continuously.

endif
