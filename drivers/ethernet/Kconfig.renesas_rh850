config ETH_RENESAS_RH850_ETNF
	bool "Renesas RH850 Ethernet T1S (10BASE-T1S) MAC Driver"
	default y
	depends on DT_HAS_RENESAS_RH850_ETHERNET_ETNF_ENABLED
	select USE_RH850_FSP_ETHER_ETNF if RH850
	select PINCTRL
	select CLOCK_CONTROL
	help
	  Enable Ethernet T1S (10BASE-T1S, IEEE 802.3cg) MAC driver for the
	  Renesas RH850 family based on the ETNF0 controller.
	  Uses the Renesas FSP r_ether_t1s HAL module.

if ETH_RENESAS_RH850_ETNF

config ETH_RENESAS_RH850_ETNF_RX_THREAD_STACK_SIZE
	int "RX processing thread stack size (bytes)"
	default 1500
	help
	  Stack size in bytes for the dedicated RX packet processing thread.
	  Increase this value if net_pkt allocation or L3 processing causes
	  stack overflows.

config ETH_RENESAS_RH850_ETNF_RX_THREAD_PRIORITY
	int "RX thread cooperative priority"
	default 2

config ETH_RENESAS_RH850_ETNF_USE_ZEROCOPY
	bool "RH850 Ethernet T1S zero-copy TX/RX mode"
	help
	  When enabled, the driver uses zero-copy mode: RX buffer pointers are
	  passed directly to the network stack without memcpy, and TX buffers
	  are provided by the caller. Reduces CPU overhead and memory usage.
	  Maps to ETHER_ZEROCOPY_ENABLE in the FSP ether_cfg_t.

endif # ETH_RENESAS_RH850_ETNF

config ETH_RENESAS_RH850_ETND
	bool "Renesas RH850 MCU Ethernet TSN (ETND) MAC Driver"
	default y
	depends on DT_HAS_RENESAS_RH850_ETHERNET_ETND_ENABLED
	select USE_RH850_FSP_ETHER_ETND
	select PINCTRL
	select CLOCK_CONTROL
	help
	  Enable the Ethernet TSN (ETND) MAC driver for the Renesas RH850 MCU
	  family. Uses the Renesas FSP r_ether_tsn HAL module together with an
	  external 10/100 PHY (e.g. LAN8700) via r_ether_phy.

if ETH_RENESAS_RH850_ETND

config ETH_RENESAS_RH850_ETND_RX_THREAD_STACK_SIZE
	int "RX processing thread stack size (bytes)"
	default 1600
	help
	  Stack size in bytes for the dedicated RX packet processing thread.
	  Increase this value if net_pkt allocation or L3 processing causes
	  stack overflows.

config ETH_RENESAS_RH850_ETND_RX_THREAD_PRIORITY
	int "RX thread cooperative priority"
	default 2
	help
	  The driver reads received frames and hands them to the network
	  stack in a cooperative thread, so other threads cannot preempt it
	  for every frame. This option sets its priority, passed through
	  K_PRIO_COOP(): a lower value means a higher priority.

config ETH_RENESAS_RH850_ETND_USE_ZEROCOPY
	bool "Zero-copy TX/RX mode"
	default y
	help
	  Maps to ETHER_ZEROCOPY_ENABLE in the FSP ether_cfg_t.

config ETH_RENESAS_RH850_ETND_ADDR_FILTER
	bool "Destination address filter table"
	help
	  Program r_ether_tsn's destination-address filter table (up to 32
	  entries). This is a software filter inside the FSP RX path: the HAL
	  still receives every frame into memory, then drops the ones whose
	  destination address is not in the table before handing them to the
	  driver, instead of passing all multicast frames through.
	  Broadcast and the interface's own unicast address always pass.

	  The table comes from the "zephyr,mac-address-filter" devicetree
	  property of the ETND node and is programmed once at
	  R_ETHER_TSN_Open(); it is not updated at runtime when the network
	  stack joins or leaves multicast groups. Any multicast address the
	  application needs must be listed there, otherwise it is dropped
	  (e.g. with IPv6, 33:33:00:00:00:01 and the solicited-node address
	  33:33:ff:xx:xx:xx are required for neighbor discovery).

endif # ETH_RENESAS_RH850_ETND
