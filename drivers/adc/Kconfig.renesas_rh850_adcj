config ADC_RENESAS_RH850_ADCJ
	bool "Renesas RH850 ADCJ ADC driver"
	default y
	depends on DT_HAS_RENESAS_RH850_ADCJ_ENABLED
	depends on ADC
	select USE_RH850_FSP_ADCJ
	help
	  Enable the Renesas RH850 ADCJ driver.
	  This driver uses the Renesas RH850 FSP ADCJ implementation as the
	  hardware access layer.

config ADC_RENESAS_RH850_ADCJ_STREAM
	bool "Renesas RH850 ADCJ ADC streaming support"
	default n
	depends on ADC_RENESAS_RH850_ADCJ
	depends on ADC_STREAM
	help
	  Use this configuration option to enable streaming ADC data via RTIO.

config ADC_RENESAS_RH850_ADCJ_STREAM_DMA
	bool "ADCJ DMA-backed streaming"
	default n
	depends on ADC_RENESAS_RH850_ADCJ_STREAM
	select DMA
	help
	  Use this configuration option to enable DMA for streaming ADC.
