config ADC_RENESAS_RH850_ADCK
	bool "Renesas RH850 ADCK ADC driver"
	default y
	depends on DT_HAS_RENESAS_RH850_ADCK_ENABLED
	depends on ADC
	select USE_RH850_FSP_ADCK
	help
	  Enable the ADC driver for the Renesas RH850 ADCK peripheral.
	  The driver uses the Renesas RH850 FSP ADCK implementation as its
	  hardware access layer.

config ADC_RENESAS_RH850_ADCK_STREAM
	bool "Renesas RH850 ADCK ADC streaming support"
	default n
	depends on ADC_RENESAS_RH850_ADCK
	depends on ADC_STREAM
	help
	  Use this configuration option to enable streaming ADC data via RTIO.

config ADC_RENESAS_RH850_ADCK_STREAM_DMA
	bool "ADCK DMA-backed streaming"
	default n
	depends on ADC_RENESAS_RH850_ADCK_STREAM
	select DMA
	help
	  Use this configuration option to enable DMA for streaming ADC.
