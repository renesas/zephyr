/ {
	chosen {
		zephyr,sram = &sram1;
		zephyr,ipc_rsc_table = &rpmsg_rsc_table1;
		zephyr,ipc_shm = &linux_cma_pool;
		zephyr,ipc = &mbox_consumer;
	};

	mbox_consumer: mbox-consumer {
		compatible = "vnd,mbox-consumer";
		mboxes = <&mfis_common 1>, <&mfis_common 1>;
		mbox-names = "tx", "rx";
	};

	linux_cma_pool: memory@a2600000 {
		compatible = "mmio-sram";
		reg = <0xa2600000 0x1da00000>;
	};
};

&rpmsg_rsc_table1 {
	compatible = "zephyr,memory-region", "mmio-sram";
	zephyr,memory-region = "RPMSG_RSC_TABLE";
};

&mfis_common {
	status = "okay";

	channel@1 {
		reg = <1>;
		renesas,local-side = "s-side";
	};
};
