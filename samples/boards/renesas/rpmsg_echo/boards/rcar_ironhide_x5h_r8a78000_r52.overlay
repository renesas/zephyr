/ {
	chosen {
		zephyr,sram = &sram0;
		zephyr,ipc_rsc_table = &rpmsg_rsc_table0;
		zephyr,ipc_shm = &rpmsg_shm0;
		zephyr,ipc = &mbox_consumer;
	};

	mbox_consumer: mbox-consumer {
		compatible = "vnd,mbox-consumer";
		mboxes = <&mfis_common 0>, <&mfis_common 0>;
		mbox-names = "tx", "rx";
	};
};

&mfis_common {
	status = "okay";

	channel@0 {
		reg = <0>;
		renesas,local-side = "s-side";
	};
};
