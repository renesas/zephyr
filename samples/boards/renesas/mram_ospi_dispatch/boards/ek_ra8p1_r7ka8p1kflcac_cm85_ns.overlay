/*
 * Application runs from MRAM. Only the code relocated with
 * "EXTFLASH_TEXT NOCOPY" lives in the octal flash and is executed in place
 * through the OSPI_B memory-mapped window at 0x90000000.
 *
 * The OSPI_B controller and the MX25LW51245G are described in ek_ra8p1.dtsi
 * (disabled by default): enable them and reserve the auto-calibration sector.
 */
&ext_flash_ctrl {
	status = "okay";
};

&ext_flash {
	status = "okay";

	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		auto_calib_partition: partition@3fff000 {
			compatible = "zephyr,mapped-partition";
			label = "auto-calib-pattern";
			reg = <0x3fff000 DT_SIZE_K(4)>;
		};
	};
};
