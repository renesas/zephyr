/* PHY reset: P10_8 on board revision 3, P12_3 on revisions 1 and 2 */
&ioport10 {
	status = "okay";
};

&ioport12 {
	status = "okay";
};

&etnd0_mdio {
	status = "okay";
};

&eth_phy0 {
	status = "okay";
};

&etnd0 {
	rxb0-num = <64>;
	status = "okay";
};
