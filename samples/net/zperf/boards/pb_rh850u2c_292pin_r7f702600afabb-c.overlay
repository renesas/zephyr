&etnf0 {
	pinctrl-0 = <&etnf0_default>;
	pinctrl-names = "default";
	local-mac-address = [74 90 50 12 34 56];
	status = "okay";

	ct25205: phy {
		status = "okay";
	};
};

&etnd0 {
	rxb0-num = <64>;
};
