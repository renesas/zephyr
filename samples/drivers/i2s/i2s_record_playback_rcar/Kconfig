source "Kconfig.zephyr"

config I2S_INITIAL_BUFFERS
	int "Initial count of audio data blocks"
	default 4
	help
	  Controls the initial count of audio data blocks.

config SAMPLE_FREQUENCY
	int "Sample rate"
	default 16000
	help
	  Sample frequency of the system.

config NUMBER_OF_CHANNELS
	int "Number of channels"
	default 2
	help
	  Number of channels

config SAMPLE_BIT_WIDTH
	int "Sample bit width"
	default 16
	help
	  PCM sample bit width.

config RECORD_TIME
	int "Recording time"
	default 5
	help
	  Recording Time in Second
