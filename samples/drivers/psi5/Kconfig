config SAMPLE_PSI5_CHANNEL
	int "PSI5 channel used by the sample"
	range 0 7
	default 1
	help
	  Channel ID passed to psi5_register_callback(), psi5_start_sync()
	  and psi5_send(). It must match the channel node enabled in the
	  board overlay.

source "Kconfig.zephyr"
