/delete-node/ &zephyr_udc0;
/delete-node/ &zephyr_uhc0;

&usbfs {
	pinctrl-0 = <&usbfs_default>;
	pinctrl-names = "default";
	maximum-speed = "full-speed";
	status = "okay";

	zephyr_udc0: udc {
		compatible = "renesas,ra-udc";
		status = "okay";
	};
};

&usbhs {
	pinctrl-0 = <&usbhs_default>;
	pinctrl-names = "default";
	maximum-speed = "high-speed";
	status = "okay";

	zephyr_uhc0: uhc {
		compatible = "renesas,ra-uhc";
		status = "okay";
	};
};
