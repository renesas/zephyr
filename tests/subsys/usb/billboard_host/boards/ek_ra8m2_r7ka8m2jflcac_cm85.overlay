#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	usbh_billboard: usbh_billboard {
		compatible = "zephyr,usbh-billboard";

		#address-cells = <1>;
		#size-cells = <0>;

		any_billboard_device: billboard-device@ffffffff {
			compatible = "zephyr,usbh-billboard-device";
			reg = <0xffffffff>;
			status = "okay";
			match-class;
		};
	};
};
