#include <dt-bindings/pinctrl/renesas/pinctrl-rh850u2c.h>

&pinctrl {
	mspi0_default: mspi0_default {
		group1 {
			psels = <RH850_PSEL(PORT_06, 6, ALT_IN2)>,
				<RH850_PSEL(PORT_06, 7, ALT_OUT1)>;
			drive-strength = "medium";
			renesas,direct-control;
		};

		group2 {
			psels = <RH850_PSEL(PORT_06, 5, ALT_IN1)>,
				<RH850_PSEL(PORT_06, 9, ALT_OUT1)>;
			drive-strength = "medium";
		};
	};

	mspi1_default: mspi1_default {
		group1 {
			psels = <RH850_PSEL(PORT_02, 3, ALT_IN1)>,
				<RH850_PSEL(PORT_02, 5, ALT_OUT1)>;
			drive-strength = "medium";
			renesas,direct-control;
		};

		group2 {
			psels = <RH850_PSEL(PORT_02, 2, ALT_IN1)>,
				<RH850_PSEL(PORT_02, 4, ALT_IN1)>;
			drive-strength = "medium";
		};
	};
};

&mspitx_ored0 {
	interrupts = <88 11>;
	status = "okay";
};

&mspirx_ored0 {
	interrupts = <89 12>;
	status = "okay";
};

&mspite_ored0 {
	interrupts = <90 13>;
	status = "okay";
};

&mspier_ored0 {
	interrupts = <91 15>;
	status = "okay";
};

&mspitx_ored1 {
	interrupts = <92 8>;
	status = "okay";
};

&mspirx_ored1 {
	interrupts = <93 7>;
	status = "okay";
};

&mspite_ored1 {
	interrupts = <94 10>;
	status = "okay";
};

&mspier_ored1 {
	interrupts = <95 15>;
	status = "okay";
};

&mspi0 {
	interrupts-extended = <&mspitx_ored0>,
			      <&mspirx_ored0>,
			      <&mspite_ored0>,
			      <&mspier_ored0>;
	status = "okay";
	pinctrl-0 = <&mspi0_default>;
	pinctrl-names = "default";

	dut_spi_dt: test-spi-dev@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

dut_spis: &mspi1 {
	interrupts-extended = <&mspitx_ored1>,
			      <&mspirx_ored1>,
			      <&mspite_ored1>,
			      <&mspier_ored1>;
	status = "okay";
	pinctrl-0 = <&mspi1_default>;
	pinctrl-names = "default";
};
