config TEST_PSI5_CHANNEL
	int "PSI5 channel used by the test"
	range 0 7
	default 1
	help
	  Channel ID used by the psi5_api test suite. It must match the
	  channel node enabled in the board overlay.

source "Kconfig.zephyr"
