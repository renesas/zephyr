#include <zephyr/dt-bindings/sent/sent.h>

/ {
	aliases {
		sent-taud-emulator-secondary = &pwm0_ch2;
	};
};

/*
 * Enable TAUD0 channel 2 as the second synchronized PWM output.
 * The master channel and primary slave are enabled by the board overlay.
 */
&pwm0_ch2 {
	channel-mode = "synchronized";
	status = "okay";
};

/*
 * Keep these pin configurations test-local instead of exposing them as
 * default board pinctrl nodes.
 */
&pinctrl {
	sent2_default: sent2_default {
		group1 {
			psels = <RH850_PSEL(PORT_04, 13, ALT_IN2)>;
		};
	};

	sent3_default: sent3_default {
		group1 {
			psels = <RH850_PSEL(PORT_04, 12, ALT_IN4)>;
		};
	};

	sent4_default: sent4_default {
		group1 {
			psels = <RH850_PSEL(PORT_06, 13, ALT_IN3)>;
		};
	};
};

/* SENT1 is already enabled by the board overlay. */
&sent0 {
	pinctrl-0 = <&sent0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sent0_ch0 {
	num-data-nibbles = <6>;
	fast-crc = <FAST_CRC_DISABLE>;
	short-serial-crc = <SHORT_CRC_DISABLE>;
	clock-tick-length-us = <3>;
	slow-message-format = "enhanced-serial";
	successive-calib-pulse-method = <2>;
	status = "okay";
};

&sent2 {
	pinctrl-0 = <&sent2_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sent2_ch0 {
	num-data-nibbles = <6>;
	fast-crc = <FAST_CRC_DISABLE>;
	short-serial-crc = <SHORT_CRC_DISABLE>;
	clock-tick-length-us = <3>;
	slow-message-format = "enhanced-serial";
	successive-calib-pulse-method = <2>;
	status = "okay";
};

&sent3 {
	pinctrl-0 = <&sent3_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sent3_ch0 {
	num-data-nibbles = <6>;
	fast-crc = <FAST_CRC_DISABLE>;
	short-serial-crc = <SHORT_CRC_DISABLE>;
	clock-tick-length-us = <3>;
	slow-message-format = "enhanced-serial";
	successive-calib-pulse-method = <2>;
	status = "okay";
};

&sent4 {
	pinctrl-0 = <&sent4_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sent4_ch0 {
	num-data-nibbles = <6>;
	fast-crc = <FAST_CRC_DISABLE>;
	short-serial-crc = <SHORT_CRC_DISABLE>;
	clock-tick-length-us = <3>;
	slow-message-format = "enhanced-serial";
	successive-calib-pulse-method = <2>;
	status = "okay";
};

#undef SENT_CHANNEL_CONFIG
