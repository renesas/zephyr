#include <arm/renesas/ra/ra8/r7ka8p1xf.dtsi>
#include <zephyr/dt-bindings/mipi_dsi/mipi_dsi.h>

/ {
	soc {
		mram-controller@4013c000 {
			code_mram_cm85: mram@2000000 {
				compatible = "renesas,ra-nv-mram", "soc-nv-flash";
				reg = <0x2000000 DT_SIZE_K(768)>;
				ranges = <0x0 0x2000000 DT_SIZE_K(768)>;
				write-block-size = <1>;
				erase-block-size = <32>;
				#address-cells = <1>;
				#size-cells = <1>;
			};

			code_mram_cm33: mram@20c0000 {
				compatible = "renesas,ra-nv-mram", "soc-nv-flash";
				reg = <0x20c0000 DT_SIZE_K(256)>;
				ranges = <0x0 0x20c0000 DT_SIZE_K(256)>;
				write-block-size = <1>;
				erase-block-size = <32>;
				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		sram0: memory@22000000 {
			compatible = "mmio-sram";
			reg = <0x22000000 DT_SIZE_M(1)>;
			ranges = <0x0 0x22000000 DT_SIZE_M(1)>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		sram1: memory@22100000 {
			compatible = "mmio-sram";
			reg = <0x22100000 DT_SIZE_K(640)>;
			ranges = <0x0 0x22100000 DT_SIZE_K(640)>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		mbox0: ipc@400200c0 {
			compatible = "renesas,ra-ipc-mbox";
			reg = <0x400200c0 0x20>, <0x40020100 0x20>;
			reg-names = "ipc00", "ipc10";
			unit = <0>;
			channel-mask = <0xff>;
			#mbox-cells = <1>;
			status = "disabled";
		};

		mbox1: ipc@400200e0 {
			compatible = "renesas,ra-ipc-mbox";
			reg = <0x400200e0 0x20>, <0x40020120 0x20>;
			reg-names = "ipc01", "ipc11";
			unit = <1>;
			channel-mask = <0xff>;
			#mbox-cells = <1>;
			status = "disabled";
		};

		lcdif: display-controller@40342000 {
			compatible = "renesas,ra-glcdc";
			reg = <0x40342000 0x1454>;
			clocks = <&lcdclk MSTPC 4>;
			status = "disabled";
		};

		mipi_dsi: dsihost@40346000 {
			compatible = "renesas,ra-mipi-dsi";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x40346000 0xc00>;
			clocks = <&lcdclk MSTPC 10>;
			phys = <&mipi_phy 1>;
			phy-names = "dphy";
			status = "disabled";
		};

		/*
		 * Shared CSI/DSI D-PHY block. DPHYMDC.MASTEREN selects the
		 * operating mode: CSI receiver (slave) or DSI transmitter (master).
		 * Only one mode can be active at a time.
		 */
		mipi_phy: mipi-dphy@40346c00 {
			compatible = "renesas,ra-mipi-dphy";
			reg = <0x40346c00 0x400>;
			clocks = <&pclka MSTPC 16>;
			#phy-cells = <1>;
			status = "disabled";
		};

		mipi_csi: csihost@40347000 {
			compatible = "renesas,ra-mipi-csi";
			reg = <0x40347000 0x1000>;
			clocks = <&pclka MSTPC 17>;
			clock-names = "vclk";
			phys = <&mipi_phy 0>;
			phy-names = "dphy";
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					/* sensor-facing input: the sensor's endpoint and
					 * this port's own endpoint are both added by the
					 * board/shield overlay, e.g.:
					 * &mipi_csi {
					 *     ports {
					 *         port@0 {
					 *             csi_ep_in: endpoint {
					 *                 remote-endpoint-label = "sensor_ep_out";
					 *             };
					 *         };
					 *     };
					 * };
					 */
					reg = <0>;
				};

				port@1 {
					/* VIN-facing output */
					reg = <1>;
					csi_ep_out: endpoint {
						remote-endpoint-label = "vin_ep_in";
					};
				};
			};
		};

	};
};

/*
 * The family-level VIN node (&vin) is already defined in ra8x2.dtsi.
 * Only add the OF-graph link to &mipi_csi here.
 */
&vin {
	port {
		vin_ep_in: endpoint {
			remote-endpoint-label = "csi_ep_out";
		};
	};
};
