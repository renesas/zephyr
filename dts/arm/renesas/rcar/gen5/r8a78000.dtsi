		};

		ssi0: ssi@ec549000 {
			compatible = "renesas,rcar-i2s-ssi";
			reg = <0xec549000 0x34>,
			      <0xec540000 0xa004>,
			      <0xec100000 0x7004>;
			reg-names = "ssi", "ssiu", "ssip";
			dmas = <&audio_dmac0 0 0x7c>,
			       <&audio_dmac0 1 0x7d>;
			dma-names = "rx", "tx";
			interrupts = <GIC_SPI 513 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clocks = <&clkc CLKC_MOD R8A78000_MOD_SSI00>,
				 <&clkc CLKC_MOD R8A78000_MOD_SSI0>,
				 <&adg0 ADG_CLKSRC(BRGA)>;
			clock-names = "ssi", "ssi-domain", "audio-clk";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

