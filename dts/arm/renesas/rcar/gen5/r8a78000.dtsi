#include <renesas/rcar/gen5/rcar_gen5_cr52.dtsi>
#include <zephyr/dt-bindings/clock/r8a7800_clkc_mdlc.h>
#include <zephyr/dt-bindings/clock/renesas_rcar_adg.h>

/ {
	soc {
		pfc: pin-controller@c1080000 {
			compatible = "renesas,rcar-pfc-x5h";
			reg = <0xc1080000 0x16c>, <0xc1080800 0x16c>,
			      <0xc1081000 0x16c>, <0xc0800000 0x16c>,
			      <0xc0800800 0x16c>, <0xc0400000 0x16c>,
			      <0xc0400800 0x16c>, <0xc0401000 0x16c>,
			      <0xc0401800 0x16c>, <0xc9b00000 0x16c>,
			      <0xc9b00800 0x16c>;
		};

		clkc: clock-controller@c08f0000 {
			compatible = "renesas,r8a7800-clkc-mdlc";
			reg = <0xc08f0000 0x4000>;
			#clock-cells = <2>;
		};

		adg0: audio-clock@ec530000 {
			compatible = "renesas,rcar-adg";
			reg = <0xec530000 0x140>;
			clocks = <&clkc CLKC_MOD R8A78000_MOD_ADG0>,
				 <&clkc CLKC_CORE R8A78000_CLK_ADGHD1CK_MP_BUS>,
				 <&clkc CLKC_CORE R8A78000_CLK_ADGHD4CK_MP_BUS>,
				 <&audio_clk_a>, <&audio_clk_b>, <&audio_clk_c>;
			clock-names = "pclk", "s0d1", "s0d4",
				      "clk_a", "clk_b", "clk_c";
			#clock-cells = <1>;
			audio-clkout-sel = <ADG_CLKSRC(NONE) ADG_CLKSRC(NONE)
					    ADG_CLKSRC(NONE) ADG_CLKSRC(NONE)>;
			brga-clk-sel = <ADG_BRGSRC(S0D4)>;
			brgb-clk-sel = <ADG_BRGSRC(S0D4)>;
		};

		adg1: audio-clock@ed530000 {
			compatible = "renesas,rcar-adg";
			reg = <0xed530000 0x140>;
			clocks = <&clkc CLKC_MOD R8A78000_MOD_ADG1>,
				 <&clkc CLKC_CORE R8A78000_CLK_ADGHD1CK_MP_BUS>,
				 <&clkc CLKC_CORE R8A78000_CLK_ADGHD4CK_MP_BUS>,
				 <&audio_clk_a>, <&audio_clk_b>, <&audio_clk_c>;
			clock-names = "pclk", "s0d1", "s0d4",
				      "clk_a", "clk_b", "clk_c";
			#clock-cells = <1>;
			audio-clkout-sel = <ADG_CLKSRC(NONE) ADG_CLKSRC(NONE)
					    ADG_CLKSRC(NONE) ADG_CLKSRC(NONE)>;
			brga-clk-sel = <ADG_BRGSRC(S0D4)>;
			brgb-clk-sel = <ADG_BRGSRC(S0D4)>;
		};

		gpio0: gpio@c1080100 {
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clocks = <&clkc CLKC_MOD R8A78000_MOD_PFC_PERE_GPIODM0>;
		};

		gpio6: gpio@c0400900 {
			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clocks = <&clkc CLKC_MOD R8A78000_MOD_PFC_PERE_GPIODM0>;
		};

		gpio9: gpio@c9b00100 {
			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clocks = <&clkc CLKC_MOD R8A78000_MOD_PFC_PERE_GPIODM0>;
		};

		audio_dmac0: dma@ec700000 {
			interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>,
				     <GIC_SPI 203 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>,
				     <GIC_SPI 204 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>,
				     <GIC_SPI 205 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>,
