			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			sent3_ch0: channel@0 {
				reg = <0>;
				status = "disabled";
			};
		};

		sent4: sent@ffd33800 {
			compatible = "renesas,rh850-sent";
			reg = <0xffd33800 0x64>;
			unit = <4>;
			interrupts = <472 1>, <478 1>;
			interrupt-names = "rxi", "eri";
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RSENT, 4, HSB)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			sent4_ch0: channel@0 {
				reg = <0>;
				status = "disabled";
			};
		};
	};

	/* External CAN clock - to be overridden by boards that provide it */
	can_clk: can-clk {
		compatible = "fixed-clock";
		clock-frequency = <0>;
		#clock-cells = <0>;
	};
};
