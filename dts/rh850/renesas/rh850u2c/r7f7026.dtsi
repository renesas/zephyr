#include <rh850/renesas/rh850u2c/u2c-g4kh-common.dtsi>
#include <zephyr/dt-bindings/clock/renesas_rh850u2c_clock.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <freq.h>

/ {
	clocks {
		mosc: main-osc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			status = "okay";
			clock-frequency = <DT_FREQ_M(20)>;
		};

		hsiosc: hs-int-osc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			status = "okay";
			clock-frequency = <DT_FREQ_M(200)>;
		};

		lsiosc: ls-int-osc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			status = "okay";
			clock-frequency = <32768>;
		};

		sscg0: sscg0 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			status = "okay";
			clock-frequency = <DT_FREQ_M(640)>;
			clocks = <&mosc>;
		};

		pll: pll {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			status = "okay";
			clock-frequency = <DT_FREQ_M(800)>;
			clocks = <&mosc>;
		};

		sosc: sosc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			status = "disabled";
			clock-frequency = <0>;
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		sram0: memory@fe000000 {
			compatible = "mmio-sram";
			reg = <0xfe000000 DT_SIZE_K(384)>;
		};

		flash0: flash@0 {
			compatible = "renesas,rh850-code-flash";
			renesas,programming-enable;
		};

		pinctrl: pin-controller@ffd90000 {
			compatible = "renesas,rh850-pinctrl";
			reg = <0xffd90000 0x40>;
			status = "okay";
		};

		swint0: swint@ffc00000 {
			compatible = "renesas,rh850-swint";
			reg = <0xffc00000 0x01>;
			interrupts-extended = <&intc1_pe0 14 14>,
					      <&intc1_pe1 14 14>;
			interrupt-names = "swint_pe0", "swint_pe1";
			status = "okay";
		};

		pwm0_ch0: pwm@ffbf4000 {
			compatible = "renesas,rh850-taud-pwm";
			reg = <0xffbf4000 0x100>;
			unit = <0>;
			channel = <0>;
			interrupt-parent = <&intc1_pe0>;
			clocks = <&cgc RH850_PCLK(TAUD, 0, PCLK)>;
			clock-source = <0>;
			clock-divider = <5>;
			interrupts = <10 1>;
			#pwm-cells = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			pwm0_ch1: channel@1 {
				reg = <1>;
				channel-mode = "synchronized";
				status = "disabled";
			};

			pwm0_ch2: channel@2 {
				reg = <2>;
				channel-mode = "synchronized";
				status = "disabled";
			};
		};

		pic0: pic@ffbfaf00 {
			compatible = "renesas,rh850-pic";
			reg = <0xffbfaf00 0x5d4>;
			status = "disabled";
		};

		taud3p0: taud3p0@ffbf4008 {
			compatible = "renesas,rh850-taud3p-pwm3p";
			reg = <0xffbf4008 0x2000>;
			taud-three-phase-unit = <0>;
			clocks = <&cgc RH850_PCLK(TAUD, 0, PCLK)>;
			period-counts = <0xfa0>;
			deadtime-counts = <240>;
			operation-clk = <0>;
			clk-div = <0>;
			interrupts = <11 1>;
			interrupt-parent = <&intc2>;
			status = "disabled";
		};

		taud3p1: taud3p1@ff894008 {
			compatible = "renesas,rh850-taud3p-pwm3p";
			reg = <0xff894008 0x2000>;
			taud-three-phase-unit = <1>;
			clocks = <&cgc RH850_PCLK(TAUD, 1, PCLK)>;
			period-counts = <0xfa0>;
			deadtime-counts = <240>;
			operation-clk = <0>;
			clk-div = <0>;
			interrupts = <159 1>;
			interrupt-parent = <&intc2>;
			status = "disabled";
		};

		cgc: clock-controller@ff980000 {
			compatible = "renesas,rh850-cgc";
			reg = <0xff980000 0x734>, <0xff988000 0x30c>;
			#clock-cells = <1>;
			status = "okay";

			clk_sys_sscg0: clk-sys-sscg0 {
				compatible = "renesas,rh850-cgc-sysclk";
				clock-source = <&sscg0>;
				#clock-cells = <0>;
				status = "okay";
				modulation-value = <30>;
				modulation-dithered-range = <0>;
				renesas,cyclicrun-clock-source = <&clk_sys_iosc>;
				div = <1>;
				renesas,cyclicrun-div = <1>;
			};

			clk_sys_clean: clk-sys-clean {
				compatible = "renesas,rh850-cgc-sysclk";
				clock-source = <&pll>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&clk_sys_iosc>;
				div = <1>;
				renesas,cyclicrun-div = <1>;
			};

			iosc: int-osc {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&hsiosc>;
				div = <1>;
			};

			clk_sys_iosc: clk-sys-iosc {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&hsiosc>;
				div = <1>;
			};

			clk_emg: clk-emg {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&hsiosc>;
				renesas,cyclicrun-clock-source = <&hsiosc>;
				div = <20>;
				renesas,cyclicrun-div = <20>;
			};

			clk_ecmcnt: clk-ecmcnt {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&hsiosc>;
				div = <20>;
			};

			clk_fli: clk-fli {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_cpu>;
				div = <1>;
			};

			clk_faci: clk-faci {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_lsb>;
				div = <1>;
			};

			clka_lps: clka-lps {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&hsiosc>;
				div = <20>;
			};

			clk_cpu: clk-cpu {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_sscg0>;
				div = <2>;
			};

			clk_sbus: clk-sbus {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_sscg0>;
				div = <4>;
			};

			clk_hbus: clk-hbus {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_sscg0>;
				div = <8>;
			};

			clk_uhsb: clk-uhsb {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_sscg0>;
				div = <4>;
			};

			clk_hsb: clk-hsb {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_sscg0>;
				div = <8>;
			};

			clk_lsb: clk-lsb {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_sscg0>;
				div = <16>;
			};

			clkc_sbus: clkc-sbus {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_clean>;
				div = <4>;
			};

			clkc_hbus: clkc-hbus {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_clean>;
				div = <8>;
			};

			clkc_uhsb: clkc-uhsb {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_clean>;
				div = <5>;
			};

			clkc_hsb: clkc-hsb {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_clean>;
				div = <10>;
			};

			clkc_lsb: clkc-lsb {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clk_sys_clean>;
				div = <20>;
			};

			clk_gtm: clk-gtm {
				compatible = "renesas,rh850-cgc-pclk";
				#clock-cells = <0>;
				status = "okay";
				clock-source = <&clkc_sbus>;
				div = <1>;
			};

			clk_rlin3: clk-rlin3 {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&clkc_hsb>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&clkc_hsb>;
				div = <1>;
				renesas,cyclicrun-div = <1>;
			};

			clk_rlin3_ch23: clk-rlin3-ch23 {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&clkc_hbus>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&clkc_hbus>;
				div = <1>;
				renesas,cyclicrun-div = <1>;
			};

			clk_canfd_c: clk-canfd-c {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&clkc_hsb>;
				#clock-cells = <0>;
				status = "okay";
				div = <1>;
			};

			clk_canfd_xin: clk-canfd-xin {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&mosc>;
				#clock-cells = <0>;
				status = "okay";
				div = <1>;
			};

			clkc_canxl_ch0: clkc-canxl-ch0 {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&clkc_hsb>;
				#clock-cells = <0>;
				status = "okay";
				div = <1>;
			};

			clk_mspi: clk-mspi {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&clkc_hsb>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&clkc_hsb>;
				div = <1>;
				renesas,cyclicrun-div = <1>;
			};

			clk_swdt: clk-swdt {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&hsiosc>;
				#clock-cells = <0>;
				status = "okay";
				div = <20>;
			};

			clka_wdtba: clka-wdtba {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&lsiosc>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&lsiosc>;
				div = <128>;
				renesas,cyclicrun-div = <128>;
			};

			clka_tauj: clka-tauj {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&lsiosc>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&lsiosc>;
				div = <1>;
				renesas,cyclicrun-div = <1>;
			};

			clka_rtca: clka-rtca {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&lsiosc>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&lsiosc>;
				div = <1>;
				renesas,cyclicrun-div = <1>;
			};

			clka_adc: clka-adc {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&hsiosc>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-clock-source = <&hsiosc>;
				div = <20>;
				renesas,cyclicrun-div = <20>;
			};

			extclk0: extclk0 {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&clk_hsb>;
				div = <0>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-div = <0>;
				renesas,cyclicrun-clock-source = <&clk_hsb>;
			};

			extclk1: extclk1 {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&clk_hsb>;
				div = <0>;
				#clock-cells = <0>;
				status = "okay";
				renesas,cyclicrun-div = <0>;
				renesas,cyclicrun-clock-source = <&clk_hsb>;
			};

			clka_wdtb: clka-wdtb {
				compatible = "renesas,rh850-cgc-pclk";
				clock-source = <&hsiosc>;
				#clock-cells = <0>;
				status = "okay";
				div = <640>;
				renesas,cyclicrun-clock-source = <&hsiosc>;
				renesas,cyclicrun-div = <640>;
			};
		};

		ostm0: ostm0@ffbf0000 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0000 0x20>;
			channel = <0>;
			interrupts = <63 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(OSTM, 0, PCLK)>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm1: ostm1@ff89a100 {
			compatible = "renesas,rh850-ostm";
			reg = <0xff89a100 0x20>;
			channel = <1>;
			interrupts = <484 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(OSTM, 1, PCLK)>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		rlin30: rlin30@ffc7c000 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <173 1>, <174 1>, <175 1>, <176 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c000 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 0, RLIN3)>;
			status = "disabled";

			uart0: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <0>;
				status = "disabled";
			};
		};

		rlin31: rlin31@ff89b100 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <178 1>, <179 1>, <180 1>, <181 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xff89b100 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 1, RLIN3)>;
			status = "disabled";

			uart1: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <1>;
				status = "disabled";
			};
		};

		rlin32: rlin32@ffc7c200 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <183 1>, <184 1>, <185 1>, <186 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c200 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 2, RLIN3)>;
			status = "disabled";

			uart2: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <2>;
				status = "disabled";
			};
		};

		rlin33: rlin33@ff89b300 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <188 1>, <189 1>, <190 1>, <191 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xff89b300 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 3, RLIN3)>;
			status = "disabled";

			uart3: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <3>;
				status = "disabled";
			};
		};

		rlin34: rlin34@ffc7c400 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <193 1>, <194 1>, <195 1>, <196 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c400 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 4, RLIN3)>;
			status = "disabled";

			uart4: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <4>;
				status = "disabled";
			};
		};

		rlin35: rlin35@ff89b500 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <197 1>, <198 1>, <199 1>, <200 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xff89b500 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 5, RLIN3)>;
			status = "disabled";

			uart5: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <5>;
				status = "disabled";
			};
		};

		rlin36: rlin36@ffc7c600 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <201 1>, <202 1>, <203 1>, <204 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c600 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 6, RLIN3)>;
			status = "disabled";

			uart6: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <6>;
				status = "disabled";
			};
		};

		rlin37: rlin37@ff89b700 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <394 1>, <395 1>, <396 1>, <397 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xff89b700 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 7, RLIN3)>;
			status = "disabled";

			uart7: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <7>;
				status = "disabled";
			};
		};

		rlin38: rlin38@ffc7c800 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <398 1>, <399 1>, <400 1>, <401 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c800 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 8, RLIN3)>;
			status = "disabled";

			uart8: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <8>;
				status = "disabled";
			};
		};

		rlin39: rlin39@ff89b900 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <402 1>, <403 1>, <404 1>, <405 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xff89b900 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 9, RLIN3)>;
			status = "disabled";

			uart9: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <9>;
				status = "disabled";
			};
		};

		rlin310: rlin310@ffc7ca00 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <406 1>, <407 1>, <408 1>, <409 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7ca00 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 10, RLIN3)>;
			status = "disabled";

			uart10: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <10>;
				status = "disabled";
			};
		};

		rlin323: rlin323@ff978000 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <205 1>, <206 1>, <207 1>, <208 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xff978000 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 23, CH23_RLIN3)>;
			status = "disabled";

			uart23: uart {
