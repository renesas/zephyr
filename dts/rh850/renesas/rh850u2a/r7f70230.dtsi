#include <rh850/renesas/rh850u2a/u2a-g4mh-common.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/clock/renesas_rh850u2a_clock.h>
#include <freq.h>

/ {
	clocks {
		mosc: main-osc {
			compatible = "fixed-clock";
			clock-frequency = <DT_FREQ_M(20)>;
			#clock-cells = <0>;
			status = "okay";
		};

		hsiosc: hs-int-osc {
			compatible = "fixed-clock";
			clock-frequency = <DT_FREQ_M(200)>;
			#clock-cells = <0>;
			status = "okay";
		};

		lsiosc: ls-int-osc {
			compatible = "fixed-clock";
			clock-frequency = <DT_FREQ_K(240)>;
			#clock-cells = <0>;
			status = "okay";
		};

		iosc: int-osc {
			compatible = "fixed-clock";
			clock-frequency = <DT_FREQ_M(200)>;
			clocks = <&hsiosc>;
			#clock-cells = <0>;
			status = "okay";
		};

		pll: pll {
			compatible = "fixed-clock";
			clock-frequency = <DT_FREQ_M(800)>;
			clocks = <&mosc>;
			#clock-cells = <0>;
			status = "okay";
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		sram0: memory@fe000000 {
			compatible = "mmio-sram";
		};

		flash0: flash@0 {
			compatible = "renesas,rh850-code-flash";
			renesas,programming-enable;
		};

		pinctrl: pin-controller@ffd90000 {
			compatible = "renesas,rh850-pinctrl";
			reg = <0xffd90000 0x40>;
			status = "okay";
		};

		swint0: swint@ffc00000 {
			compatible = "renesas,rh850-swint";
			reg = <0xffc00000 0x01>;
			interrupts-extended = <&intc1_pe0 14 14>,
					      <&intc1_pe1 14 14>,
					      <&intc1_pe2 14 14>,
					      <&intc1_pe3 14 14>;
			interrupt-names = "swint_pe0", "swint_pe1",
					  "swint_pe2", "swint_pe3";
			status = "okay";
		};

		pwm0_master: pwm0_master@ffbf4000 {
			compatible = "renesas,rh850-taud-pwm";
			reg = <0xffbf4000 0x2000>;
			unit = <0>;
			channel = <0>;
			channel-type = "master";
			interrupts = <10 1>;
			interrupt-parent = <&intc2>;
			status = "disabled";
		};

		pwm0_slave: pwm0_slave@ffbf4004 {
			compatible = "renesas,rh850-taud-pwm";
			reg = <0xffbf4004 0x2000>;
			unit = <0>;
			channel = <1>;
			channel-type = "slave";
			master = <&pwm0_master>;
			interrupts = <376 1>;
			interrupt-parent = <&intc2>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		pwm1_slave: pwm1_slave@ffbf4008 {
			compatible = "renesas,rh850-taud-pwm";
			reg = <0xffbf4008 0x2000>;
			unit = <0>;
			channel = <2>;
			channel-type = "slave";
			master = <&pwm0_master>;
			interrupts = <1 1>;
			interrupt-parent = <&intc2>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		cgc: clock-controller@ff980000 {
			compatible = "renesas,rh850-cgc";
			reg = <0xff980000 0x830c>;
			#clock-cells = <1>;
			status = "okay";

			clk_sys: clk-sys {
				compatible = "renesas,rh850-cgc-sysclk";
				clk-source = <0>;
				#clock-cells = <0>;
				status = "okay";
			};

			clk_mspi: clk-mspi {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clk_rlin3: clk-rlin3 {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clk_wdt: clk-wdt {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clka_wdt: clka-wdt {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clka_tauj: clka-tauj {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clka_rtca: clka-rtca {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clka_adc: clka-adc {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				div = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clk_adc: clk-adc {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			clk_rcanosc: clk-rcanosc {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				#clock-cells = <0>;
				status = "okay";
			};

			extclk0: extclk0 {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				div = <0>;
				#clock-cells = <0>;
				status = "okay";
			};

			extclk1: extclk1 {
				compatible = "renesas,rh850-cgc-pclk";
				clk-source = <1>;
				div = <0>;
				#clock-cells = <0>;
				status = "okay";
			};
		};

		ostm0: ostm0@ffbf0000 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0000 0x21>;
			channel = <0>;
			interrupts = <199 0>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(OSTM, 0, PCLK)>;
			status = "disabled";

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm1: ostm1@ffbf0100 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0100 0x20>;
			channel = <1>;
			interrupts = <200 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm2: ostm2@ffbf0200 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0200 0x20>;
			channel = <2>;
			interrupts = <201 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm3: ostm3@ffbf0300 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0300 0x20>;
			channel = <3>;
			interrupts = <202 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm4: ostm4@ffbf0400 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0400 0x20>;
			channel = <4>;
			interrupts = <203 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm5: ostm5@ffbf0500 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0500 0x20>;
			channel = <5>;
			interrupts = <204 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm8: ostm8@ffbf0800 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0800 0x20>;
			channel = <8>;
			interrupts = <207 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		ostm9: ostm9@ffbf0900 {
			compatible = "renesas,rh850-ostm";
			reg = <0xffbf0900 0x20>;
			channel = <9>;
			interrupts = <208 1>;
			interrupt-names = "overflow";
			interrupt-parent = <&intc2>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		rlin30: rlin30@ffd28000 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <416 1>, <417 1>, <418 1>, <419 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffd28000 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 0, RLIN3)>;
			status = "disabled";

			uart0: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <0>;
				status = "disabled";
			};
		};

		rlin31: rlin31@ffc7c000 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <420 1>, <421 1>, <422 1>, <423 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c000 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 1, RLIN3)>;
			status = "disabled";

			uart1: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <1>;
				status = "disabled";
			};
		};

		rlin32: rlin32@ffd28200 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <424 1>, <425 1>, <426 1>, <427 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffd28200 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 2, RLIN3)>;
			status = "disabled";

			uart2: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <2>;
				status = "disabled";
			};
		};

		rlin33: rlin33@ffc7c080 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <428 1>, <429 1>, <430 1>, <431 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c080 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 3, RLIN3)>;
			status = "disabled";

			uart3: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <3>;
				status = "disabled";
			};
		};

		rlin34: rlin34@ffd28400 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <432 1>, <433 1>, <434 1>, <435 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffd28400 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 4, RLIN3)>;
			status = "disabled";

			uart4: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <4>;
				status = "disabled";
			};
		};

		rlin35: rlin35@ffc7c100 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <436 1>, <437 1>, <438 1>, <439 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c100 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 5, RLIN3)>;
			status = "disabled";

			uart5: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <5>;
				status = "disabled";
			};
		};

		rlin36: rlin36@ffd28600 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <440 1>, <441 1>, <442 1>, <443 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffd28600 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 6, RLIN3)>;
			status = "disabled";

			uart6: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <6>;
				status = "disabled";
			};
		};

		rlin37: rlin37@ffc7c180 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <444 1>, <445 1>, <446 1>, <447 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c180 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 7, RLIN3)>;
			status = "disabled";

			uart7: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <7>;
				status = "disabled";
			};
		};

		rlin38: rlin38@ffd28800 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <448 1>, <449 1>, <450 1>, <451 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffd28800 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 8, RLIN3)>;
			status = "disabled";

			uart8: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <8>;
				status = "disabled";
			};
		};

		rlin39: rlin39@ffc7c200 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <452 1>, <453 1>, <454 1>, <455 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c200 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 9, RLIN3)>;
			status = "disabled";

			uart9: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <9>;
				status = "disabled";
			};
		};

		rlin310: rlin310@ffd28a00 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <456 1>, <457 1>, <458 1>, <459 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffd28a00 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 10, RLIN3)>;
			status = "disabled";

			uart10: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <10>;
				status = "disabled";
			};
		};

		rlin311: rlin311@ffc7c280 {
			compatible = "renesas,rh850-rlin3";
			interrupts = <460 1>, <461 1>, <462 1>, <463 1>;
			interrupt-names = "rlin3i", "txi", "rxi", "eri";
			reg = <0xffc7c280 0x35>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(RLIN3, 11, RLIN3)>;
			status = "disabled";

			uart11: uart {
				compatible = "renesas,rh850-rlin3-uart";
				channel = <11>;
				status = "disabled";
			};
		};

		wdtba: watchdog@ff9a5000 {
			unit = <0>;
			compatible = "renesas,rh850-wdtb";
			interrupts = <705 0>;
			window-open-mode = "select-by-window-start";
			error-mode = "nmi-mode";
			clock-freq = <1875>;
			reg = <0xff9a5000 0x14>;
			interrupt-parent = <&intc2>;
			status = "disabled";
		};

		wdtb0: watchdog@ffbf1000 {
			unit = <1>;
			compatible = "renesas,rh850-wdtb";
			interrupts = <22 0>;
			window-open-mode = "select-by-window-start";
			error-mode = "nmi-mode";
			clock-freq = <312500>;
			reg = <0xffbf1000 0x14>;
			interrupt-parent = <&intc1_pe0>;
			status = "disabled";
		};

		wdtb1: watchdog@ffbf1100 {
			unit = <2>;
			compatible = "renesas,rh850-wdtb";
			interrupts = <22 0>;
			window-open-mode = "select-by-window-start";
			error-mode = "nmi-mode";
			clock-freq = <312500>;
			reg = <0xffbf1100 0x14>;
			interrupt-parent = <&intc1_pe1>;
			status = "disabled";
		};

		mspi0: spi@ffc76000 {
			compatible = "renesas,rh850-spi";
			interrupts = <250 1>, <251 1>, <252 1>, <253 1>;
			interrupt-names = "txi", "rxi", "tei", "eri";
			reg = <0xffc76000 0x680>;
			interrupt-parent = <&intc2>;
			#address-cells = <1>;
			#size-cells = <0>;
			channel = <0>;
			status = "disabled";
		};

		mspi1: spi@ffc7e000 {
			compatible = "renesas,rh850-spi";
			interrupts = <260 1>, <261 1>, <262 1>, <263 1>;
			interrupt-names = "txi", "rxi", "tei", "eri";
			reg = <0xffc7e000 0x680>;
			interrupt-parent = <&intc2>;
			#address-cells = <1>;
			#size-cells = <0>;
			channel = <1>;
			status = "disabled";
		};

		ioport2: gpio@ffd90080 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90080 0x40>;
			port = <2>;
			protected-write-mask = <3>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioport3: gpio@ffd900c0 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd900c0 0x40>;
			port = <3>;
			protected-write-mask = <4>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioport4: gpio@ffd90100 {
			compatible = "renesas,rh850-gpio";
