			gpio-controller;
			status = "disabled";
		};

		ioport17: gpio@ffd90440 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90440 0x40>;
			port = <17>;
			protected-write-mask = <13>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
