			gpio-controller;
			status = "disabled";
		};

		ioport22: gpio@ffd90580 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90580 0x40>;
			port = <22>;
			protected-write-mask = <18>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioport24: gpio@ffd90600 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90600 0x40>;
			port = <24>;
			protected-write-mask = <20>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioporta0: gpio@ffd90c80 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90c80 0x40>;
			port = <0>;
			protected-write-mask = <21>;
			port-type = "aport";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioporta1: gpio@ffd90cc0 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90cc0 0x40>;
			port = <1>;
			protected-write-mask = <22>;
			port-type = "aport";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioporta2: gpio@ffd90d00 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90d00 0x40>;
			port = <2>;
			protected-write-mask = <23>;
			port-type = "aport";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioporta3: gpio@ffd90d40 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90d40 0x40>;
			port = <3>;
			protected-write-mask = <24>;
			port-type = "aport";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioporta4: gpio@ffd90d80 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90d80 0x40>;
			port = <4>;
			protected-write-mask = <25>;
			port-type = "aport";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		iic0: iic0@fff22000 {
			compatible = "renesas,rh850-iic";
			interrupts = <686 1>, <687 1>, <685 1>, <688 1>;
			interrupt-names = "rxi", "txi", "eri", "tei";
			reg = <0xfff22000 0x2000>;
			interrupt-parent = <&intc2>;
			#address-cells = <1>;
			#size-cells = <0>;
			channel = <0>;
			status = "disabled";
		};

		iic1: iic1@fff23000 {
			compatible = "renesas,rh850-iic";
			interrupts = <690 1>, <691 1>, <689 1>, <692 1>;
			interrupt-names = "rxi", "txi", "eri", "tei";
			reg = <0xfff23000 0x2000>;
			interrupt-parent = <&intc2>;
			#address-cells = <1>;
			#size-cells = <0>;
			channel = <1>;
			status = "disabled";
		};

		dma0: dma@fff90000 {
			compatible = "renesas,rh850-dma";
			reg = <0xfff90000 0x5000>, <0xfff95000 0x020>;
			reg-names = "reg_main", "ext";
			interrupts = <47 1>, <48 1>, <49 1>, <50 1>,
				     <51 1>, <52 1>, <53 1>, <54 1>,
				     <55 1>, <56 1>, <57 1>, <58 1>,
				     <59 1>, <60 1>, <61 1>, <62 1>;
			interrupt-names = "ch0", "ch1", "ch2", "ch3",
					  "ch4", "ch5", "ch6", "ch7",
					  "ch8", "ch9", "ch10", "ch11",
					  "ch12", "ch13", "ch14", "ch15";
			interrupt-parent = <&intc2>;
			dma-unit = <0>;
			dma-channels = <16>;
			#dma-cells = <2>;
			status = "disabled";
		};

		dma1: dma@fff98000 {
			compatible = "renesas,rh850-dma";
			reg = <0xfff98000 0x5000>, <0xfff9d000 0x020>;
			reg-names = "reg_main", "ext";
			interrupts = <63 1>, <64 1>, <65 1>, <66 1>,
				     <67 1>, <68 1>, <69 1>, <70 1>,
				     <71 1>, <72 1>, <73 1>, <74 1>,
				     <75 1>, <76 1>, <77 1>, <78 1>;
			interrupt-names = "ch0", "ch1", "ch2", "ch3",
					  "ch4", "ch5", "ch6", "ch7",
					  "ch8", "ch9", "ch10", "ch11",
					  "ch12", "ch13", "ch14", "ch15";
			interrupt-parent = <&intc2>;
			dma-unit = <1>;
			dma-channels = <16>;
			#dma-cells = <2>;
			status = "disabled";
		};

		canfd_global: canfd-global@fff50000 {
			compatible = "renesas,rh850-canfd-global";
			reg = <0xfff50000 DT_SIZE_K(128)>;
			interrupts = <296 1>, <297 1>;
			interrupt-names = "g_err", "g_recc";
			interrupt-parent = <&intc2>;
			status = "disabled";

			canfd0: canfd0 {
				compatible = "renesas,rh850-canfd";
				channel = <0>;
				interrupts = <299 1>, <298 1>, <300 1>;
				interrupt-names = "rxi", "eri", "txi";
				interrupt-parent = <&intc2>;
				clock-frequency = <80000000>;
				status = "disabled";
			};
		};

		adcj0: adc@ffca0000 {
			compatible = "renesas,rh850-adcj";
			reg = <0xffca0000 0x1000>;
			interrupts = <227 1>, <228 1>, <229 1>, <230 1>, <231 1>;
			interrupt-names = "sg0", "sg1", "sg2", "sg3", "sg4";
			interrupt-parent = <&intc2>;
			#io-channel-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "disabled";
		};

		adcj1: adc@fff20000 {
			compatible = "renesas,rh850-adcj";
			reg = <0xfff20000 0x1000>;
			interrupts = <233 1>, <234 1>, <235 1>, <236 1>, <237 1>;
			interrupt-names = "sg0", "sg1", "sg2", "sg3", "sg4";
			interrupt-parent = <&intc2>;
			#io-channel-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "disabled";
		};

		adcj2: adc@ff9a2000 {
			compatible = "renesas,rh850-adcj";
			reg = <0xff9a2000 0x1000>;
			interrupts = <239 1>, <240 1>, <241 1>, <242 1>, <243 1>;
			interrupt-names = "sg0", "sg1", "sg2", "sg3", "sg4";
			interrupt-parent = <&intc2>;
			#io-channel-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "disabled";
		};

		rtc0: rtc@ff997000 {
			compatible = "renesas,rh850-rtc";
			reg = <0xff997000 0x4b>;
			interrupt-parent = <&intc2>;
			interrupts = <654 1>, <655 1>, <656 1>;
			interrupt-names = "one_second", "alarm", "periodic";
			clock-frequency = <DT_FREQ_K(240)>;
			alarms-count = <1>;
			status = "disabled";
		};

		crc0: crc0@ffd34000 {
			compatible = "renesas,rh850-crc";
			reg = <0xffd34000 0xb8>;
			channel = <0>;
			status = "disabled";
		};

		crc1: crc0@ffbff400 {
			compatible = "renesas,rh850-crc";
			reg = <0xffbff400 0xb8>;
			channel = <1>;
			status = "disabled";
		};

		crc2: crc0@ffd35000 {
			compatible = "renesas,rh850-crc";
			reg = <0xffd35000 0xb8>;
			channel = <2>;
			status = "disabled";
		};

		crc3: crc0@ffbff700 {
			compatible = "renesas,rh850-crc";
			reg = <0xffbff700 0xb8>;
			channel = <3>;
			status = "disabled";
		};

		crc4: crc0@ffd36000 {
			compatible = "renesas,rh850-crc";
			reg = <0xffd36000 0xb8>;
			channel = <4>;
			status = "disabled";
		};

		crc5: crc0@ffbffa00 {
			compatible = "renesas,rh850-crc";
			reg = <0xffbffa00 0xb8>;
			channel = <5>;
			status = "disabled";
		};

		crc6: crc0@ffd37000 {
			compatible = "renesas,rh850-crc";
			reg = <0xffd37000 0xb8>;
			channel = <6>;
			status = "disabled";
		};

		crc7: crc0@ffbffd00 {
			compatible = "renesas,rh850-crc";
			reg = <0xffbffd00 0xb8>;
			channel = <7>;
			status = "disabled";
		};
	};

	/* External CAN clock - to be overridden by boards that provide it */
	can_clk: can-clk {
		compatible = "fixed-clock";
		clock-frequency = <0>;
		#clock-cells = <0>;
	};
};
