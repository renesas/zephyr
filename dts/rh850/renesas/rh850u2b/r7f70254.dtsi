#include <rh850/renesas/rh850u2b/r7f70255.dtsi>

/* Peripheral definition following RH850/U2A 292pin devices */
/ {
	cpus {
		cpu3: cpu@3 {
			status = "disabled";
		};
	};

	soc {
		ioport15: gpio@ffd903c0 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd903c0 0x40>;
			port = <15>;
			protected-write-mask = <8>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioport24: gpio@ffd90600 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90600 0x40>;
			port = <24>;
			protected-write-mask = <13>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioport30: gpio@ffd90780 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd90780 0x40>;
			port = <30>;
			protected-write-mask = <17>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ioport31: gpio@ffd907c0 {
			compatible = "renesas,rh850-gpio";
			reg = <0xffd907c0 0x40>;
			port = <31>;
			protected-write-mask = <18>;
			port-type = "port";
			#gpio-cells = <2>;
			gpio-controller;
			status = "disabled";
		};

		ostm3: ostm3@ff89a300 {
			compatible = "renesas,rh850-ostm";
			reg = <0xff89a300 0x20>;
			channel = <3>;
			interrupt-names = "overflow";
			interrupts = <842 1>;
			interrupt-parent = <&intc2>;
			clocks = <&cgc RH850_PCLK(OSTM, 3, PCLK)>;
			status = "disabled";

			counter {
				compatible = "renesas,rh850-ostm-counter";
				status = "disabled";
			};

			timer {
				compatible = "renesas,rh850-ostm-timer";
				status = "disabled";
			};
		};

		wdtb3: watchdog@ff899200 {
			unit = <4>;
			compatible = "renesas,rh850-wdtb";
			interrupts = <22 0>;
			window-open-mode = "select-by-window-start";
			error-mode = "nmi-mode";
			clock-freq = <312500>;
			reg = <0xff899200 0x14>;
			interrupt-parent = <&intc2>;
			status = "disabled";
		};

		iic0: iic0@ff8e0000 {
			compatible = "renesas,rh850-iic";
			interrupts = <882 1>, <883 1>, <886 1>, <887 1>;
			interrupt-names = "rxi", "txi", "eri", "tei";
			reg = <0xff8e0000 0x2000>;
			interrupt-parent = <&intc2>;
			#address-cells = <1>;
			#size-cells = <0>;
			channel = <0>;
			status = "disabled";
		};

		iic1: iic1@ff8e2000 {
			compatible = "renesas,rh850-iic";
			interrupts = <884 1>, <885 1>, <888 1>, <889 1>;
			interrupt-names = "rxi", "txi", "eri", "tei";
			reg = <0xff8e2000 0x2000>;
			interrupt-parent = <&intc2>;
			#address-cells = <1>;
			#size-cells = <0>;
			channel = <1>;
			status = "disabled";
		};

		dma1: dma@fff98000 {
			compatible = "renesas,rh850-dma";
			reg = <0xfff98000 0x5000>, <0xfff9d000 0x020>;
			reg-names = "reg_main", "ext";
			interrupts = <825 1>, <826 1>, <827 1>, <828 1>,
				     <829 1>, <830 1>, <831 1>, <832 1>,
				     <833 1>, <834 1>, <835 1>, <836 1>,
				     <837 1>, <838 1>, <839 1>, <840 1>;
			interrupt-names = "ch0", "ch1", "ch2", "ch3",
					  "ch4", "ch5", "ch6", "ch7",
					  "ch8", "ch9", "ch10", "ch11",
					  "ch12", "ch13", "ch14", "ch15";
			interrupt-parent = <&intc2>;
			dma-unit = <1>;
			dma-channels = <16>;
			#dma-cells = <2>;
			status = "disabled";
		};

		adck3: adc@fff21000 {
			compatible = "renesas,rh850-adck";
			reg = <0xfff21000 0x1000>;
			interrupts = <456 1>, <457 1>, <458 1>, <459 1>, <460 1>;
			interrupt-names = "sg0", "sg1", "sg2", "sg3", "sg4";
			interrupt-parent = <&intc2>;
			#io-channel-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			renesas,physical-channel-mask = <0xffffffff 0xffffffff>;
			status = "disabled";
		};
	};
};
