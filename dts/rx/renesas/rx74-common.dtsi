		port_irq0: external-interrupt@87006c20 {
			compatible = "renesas,rx-external-interrupt-icum";
			reg = <0x87006C20 0x1>;
			interrupts = <64 12>;
			channel = <0>;
			renesas,sample-clock-div = <64>;
			#port-irq-cells = <0>;
			status = "disabled";
		};

		port_irq1: external-interrupt@87006c21 {
			compatible = "renesas,rx-external-interrupt-icum";
			reg = <0x87006C21 0x1>;
			interrupts = <65 12>;
			channel = <1>;
			renesas,sample-clock-div = <64>;
			#port-irq-cells = <0>;
			status = "disabled";
		};

		port_irq2: external-interrupt@87006c22 {
			compatible = "renesas,rx-external-interrupt-icum";
