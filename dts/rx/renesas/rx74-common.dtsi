#include <mem.h>
#include <zephyr/dt-bindings/clock/rx_clock.h>
#include <zephyr/dt-bindings/pinctrl/renesas/pinctrl-rx-pfs.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "renesas,rxv3e";
			device_type = "cpu";
			reg = <0>;
			status = "okay";
		};
	};

	icu: interrupt-controller@87006000 {
		#interrupt-cells = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "renesas,rx-icum";
		interrupt-controller;
		reg = <0x87006000 0x100>,
		      <0x87006200 0x20>,
		      <0x87006300 0x100>,
		      <0x870062f0 0x02>,
		      <0x87006c20 0x20>;
		reg-names = "IR", "IER", "IPR", "FIR", "IRQCR";

		swint1: swint1@870062e0 {
			compatible = "renesas,rx-swint";
			reg = <0x870062e0 0x01>;
			interrupts = <27 14>;
			interrupt-parent = <&icu>;
			status = "okay";
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		device_type = "soc";
		compatible = "simple-bus";
		interrupt-parent = <&icu>;

		ioport0: gpio@87c00000 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00000 0x20>;
			port = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport1: gpio@87c00020 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00020 0x20>;
			port = <1>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport2: gpio@87c00040 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00040 0x20>;
			port = <2>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport3: gpio@87c00060 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00060 0x20>;
			port = <3>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport4: gpio@87c00080 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00080 0x20>;
			port = <4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport5: gpio@87c000a0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000A0 0x20>;
			port = <5>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport6: gpio@87c000c0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000C0 0x20>;
			port = <6>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport7: gpio@87c000e0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000E0 0x20>;
			port = <7>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport8: gpio@87c00100 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00100 0x20>;
			port = <8>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport9: gpio@87c00120 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00120 0x20>;
			port = <9>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioporta: gpio@87c00140 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00140 0x20>;
			port = <10>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportb: gpio@87c00160 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00160 0x20>;
			port = <11>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportc: gpio@87c00180 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00180 0x20>;
			port = <12>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportd: gpio@87c001a0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001A0 0x20>;
			port = <13>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioporte: gpio@87c001c0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001C0 0x20>;
			port = <14>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportf: gpio@87c001e0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001E0 0x20>;
			port = <15>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportg: gpio@87c00200 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00200 0x20>;
			port = <16>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		sci0: sci0@87458000 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458000 0x100>;
			clocks = <&sciclk MSTPB 31>;
			status = "disabled";
			channel = <0>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci1: sci1@87458100 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458100 0x100>;
			clocks = <&sciclk MSTPB 30>;
			status = "disabled";
			channel = <1>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci2: sci2@87458200 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458200 0x100>;
			clocks = <&sciclk MSTPB 29>;
			status = "disabled";
			channel = <2>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci3: sci3@87458300 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458300 0x100>;
			clocks = <&sciclk MSTPB 28>;
			status = "disabled";
			channel = <3>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci4: sci4@87458400 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458400 0x100>;
			clocks = <&sciclk MSTPB 27>;
			status = "disabled";
			channel = <4>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci5: sci5@87458500 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458500 0x100>;
			clocks = <&sciclk MSTPB 26>;
			status = "disabled";
			channel = <5>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci6: sci6@87458600 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458600 0x100>;
			clocks = <&sciclk MSTPB 25>;
			status = "disabled";
			channel = <6>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci7: sci7@87458700 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458700 0x100>;
			clocks = <&sciclk MSTPB 24>;
			status = "disabled";
			channel = <7>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci8: sci8@87458800 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458800 0x100>;
			clocks = <&sciclk MSTPB 23>;
			status = "disabled";
			channel = <8>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci9: sci9@87458900 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458900 0x100>;
			clocks = <&sciclk MSTPB 22>;
			status = "disabled";
			channel = <9>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci10: sci10@87458a00 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458a00 0x100>;
			clocks = <&sciclk MSTPB 21>;
			status = "disabled";
			channel = <10>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci11: sci11@87458b00 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458b00 0x100>;
			clocks = <&sciclk MSTPB 20>;
			status = "disabled";
			channel = <11>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci12: uart12@87458c00 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458c00 0x100>;
			clocks = <&sciclk MSTPB 0>;
			status = "disabled";
			channel = <12>;

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		cmt: timer@87826000 {
			compatible = "renesas,rx-timer-cmt-start-control";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x87826000 0x02>;
			clocks = <&pclkb MSTPF 15>;
			reg-names = "CMSTR0";
			status = "okay";

			cmt0: timer@87826002 {
				compatible = "renesas,rx-timer-cmt";
				#address-cells = <1>;
				#size-cells = <1>;
				reg = <0x87826002 0x02>,
				      <0x87826004 0x02>,
				      <0x87826006 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <28 1>;
				interrupt-names = "cmi";
				status = "okay";
			};

			cmt1: timer@87826008 {
				compatible = "renesas,rx-timer-cmt";
				reg = <0x87826008 0x02>,
				      <0x8782600A 0x02>,
				      <0x8782600C 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <29 1>;
				interrupt-names = "cmi";
				status = "disabled";
			};
		};

		pinctrl: pin-controller@87c00800 {
			compatible = "renesas,rx-pinctrl-pfs";
			reg = <0x87C00800 0x3c0>;
			status = "okay";
		};

		eswm: ethernet@874c0000 {
			compatible = "renesas,rx-eswm";
			reg = <0x874C0000 0xE000>;
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&eswclk MSTPC 30>, <&eswphyclk MSTPC 28>;
			clock-names = "esw", "eswphy";
			ranges;

			rmac0: ethernet@874cb000 {
				compatible = "renesas,rx-rmac";
				channel = <0>;
				reg = <0x874CB000 0x1000>;
				gwdi-ctrl = <&group_irq_al4>;
				gwdi-number = <12>;
				local-mac-address = [00 11 22 33 44 55];
				phy-connection-type = "gmii";
				status = "disabled";

				mdio0: mdio {
					compatible = "renesas,rx-rmac-mdio";
					#address-cells = <1>;
					#size-cells = <0>;
					clocks = <&ethphyclk MSTPC 28>;
					clock-names = "ethphy";
					status = "disabled";
				};
			};

			rmac1: ethernet@874cd000 {
				compatible = "renesas,rx-rmac";
				reg = <0x874CD000 0x1000>;
				channel = <1>;
				gwdi-ctrl = <&group_irq_al4>;
				gwdi-number = <25>;
				local-mac-address = [00 11 22 33 44 55];
				phy-connection-type = "gmii";
				status = "disabled";

				mdio1: mdio {
					compatible = "renesas,rx-rmac-mdio";
					#address-cells = <1>;
					#size-cells = <0>;
					clocks = <&ethphyclk MSTPC 28>;
					clock-names = "ethphy";
					status = "disabled";
				};
			};
		};

		option_setting_mem_cfg_sec: option-setting-mem-cfg-sec@86c2e850 {
			compatible = "renesas,ofs-memory";
			reg = <0x86c2e850 0x715b0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			option_setting_dualsel: option-setting-dualsel0@86c2e850 {
				compatible = "zephyr,memory-region";
				zephyr,memory-region = "OPTION_SETTING_DUALSEL";
				reg = <0x86c2e850 0x4>;
				status = "disabled";
			};

			option_setting_sas: option-setting-sas@86c2e870 {
				compatible = "zephyr,memory-region";
				zephyr,memory-region = "OPTION_SETTING_SAS";
				reg = <0x86c2e870 0x4>;
				status = "disabled";
			};

			option_setting_sas2: option-setting-sas2@86c2e874 {
				compatible = "zephyr,memory-region";
				reg = <0x86c2e874 0x4>;
				zephyr,memory-region = "OPTION_SETTING_SAS2";
				status = "disabled";
			};

			option_setting_banksel_sec: option-setting-banksel-sec@86c2e9b0 {
				compatible = "zephyr,memory-region";
				reg = <0x86c2e9b0 0x4>;
				zephyr,memory-region = "OPTION_SETTING_BANKSEL_SEC";
				status = "disabled";
			};

			option_setting_blsel_sec: option-setting-blsel-sec@86c2e9c0 {
				compatible = "zephyr,memory-region";
				reg = <0x86c2e9c0 0x4>;
				zephyr,memory-region = "OPTION_SETTING_BLSEL_SEC";
				status = "disabled";
			};

			option_setting_banksel_sel: option-setting-banksel-sel@86c2e9e0 {
				compatible = "zephyr,memory-region";
				reg = <0x86c2e9e0 0x4>;
				zephyr,memory-region = "OPTION_SETTING_BANKSEL_SEL";
				status = "disabled";
			};

			option_setting_blsel_sel: option-setting-blsel-sel@86c2e9f0 {
				compatible = "zephyr,memory-region";
				reg = <0x86c2e9f0 0x4>;
				zephyr,memory-region = "OPTION_SETTING_BLSEL_SEL";
				status = "disabled";
			};

			option_setting_bpsdm_sec: option-setting-bpsdm-sec@86c9f080 {
				compatible = "zephyr,memory-region";
				reg = <0x86c9f080 0x20>;
				zephyr,memory-region = "OPTION_SETTING_BPSDM_SEC";
				status = "disabled";
			};

			option_setting_bps_sec: option-setting-bps-sec@86c9f200 {
				compatible = "zephyr,memory-region";
				reg = <0x86c9f200 0x40>;
				zephyr,memory-region = "OPTION_SETTING_BPS_SEC";
				status = "disabled";
			};

			option_setting_bps_sec_dual: option-setting-bps-sec-dual@86c9f300 {
				compatible = "zephyr,memory-region";
				reg = <0x86c9f300 0x20>;
				zephyr,memory-region = "OPTION_SETTING_BPS_SEC_DUAL";
				status = "disabled";
			};
		};

		option_setting_opt_sec: option-setting-opt-sec@86e00000 {
			compatible = "renesas,ofs-memory";
			reg = <0x86e00000 0x00030ef0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			// option_setting_data_flash_hoemrtpk: option-setting-data-flash-hoemrtpk@86e00000 {
			// 	compatible = "zephyr,memory-region";
			// 	reg = <0x86e00000 0xc0>;
