#include <mem.h>
#include <zephyr/dt-bindings/clock/rx_clock.h>
#include <zephyr/dt-bindings/pinctrl/renesas/pinctrl-rx-pfs.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "renesas,rxv3e";
			device_type = "cpu";
			reg = <0>;
			status = "okay";
		};
	};

	icu: interrupt-controller@87006000 {
		#interrupt-cells = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "renesas,rx-icum";
		interrupt-controller;
		reg = <0x87006000 0x100>,
		<0x87006200 0x20>,
		<0x87006300 0x100>,
		<0x870062f0 0x02>,
		<0x87006c20 0x20>,
		<0x87006900 0x20>;
		reg-names = "IR", "IER", "IPR", "FIR", "IRQCR", "SLIXR";

		swint1: swint1@870062e0 {
			compatible = "renesas,rx-swint";
			reg = <0x870062e0 0x01>;
			interrupts = <27 14>;
			interrupt-parent = <&icu>;
			status = "okay";
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		device_type = "soc";
		compatible = "simple-bus";
		interrupt-parent = <&icu>;

		mram: mram-controller@8709c000 {
			compatible = "renesas,rx-mram-controller";
			reg = <0x8709c000 0x4000>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "okay";
		};

		ioport0: gpio@87c00000 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00000 0x20>;
			port = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq16 &port_irq17 &port_irq18 &port_irq19
			&port_irq20 &port_irq21 &port_irq22 &port_irq23
			&port_irq24 &port_irq25 &port_irq26 &port_irq27
			&port_irq28 &port_irq29 &port_irq30 &port_irq31>;
			port-irq-names = "port-irq16",
							 "port-irq17",
			                 "port-irq18",
			                 "port-irq19",
			                 "port-irq20",
			                 "port-irq21",
			                 "port-irq22",
			                 "port-irq23",
							 "port-irq24",
							 "port-irq25",
			                 "port-irq26",
			                 "port-irq27",
			                 "port-irq28",
			                 "port-irq29",
			                 "port-irq30",
			                 "port-irq31";
			port-irq16-pins = <0>;
			port-irq17-pins = <1>;
			port-irq18-pins = <2>;
			port-irq19-pins = <3>;
			port-irq20-pins = <4>;
			port-irq21-pins = <5>;
			port-irq22-pins = <6>;
			port-irq23-pins = <7>;
			port-irq24-pins = <8>;
			port-irq25-pins = <9>;
			port-irq26-pins = <10>;
			port-irq27-pins = <11>;
			port-irq28-pins = <12>;
			port-irq29-pins = <13>;
			port-irq30-pins = <14>;
			port-irq31-pins = <15>;
			status = "disabled";
		};

		ioport1: gpio@87c00020 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00020 0x20>;
			port = <1>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq0 &port_irq1 &port_irq2 &port_irq3
			&port_irq4 &port_irq29 &port_irq30 &port_irq31
			&port_irq16 &port_irq17 &port_irq18 &port_irq19
			&port_irq20 &port_irq21 &port_irq22 &port_irq23>;
			port-irq-names = "port-irq0",
							 "port-irq1",
			                 "port-irq2",
			                 "port-irq3",
			                 "port-irq4",
			                 "port-irq29",
			                 "port-irq30",
			                 "port-irq31",
							 "port-irq16",
							 "port-irq17",
			                 "port-irq18",
			                 "port-irq19",
			                 "port-irq20",
			                 "port-irq21",
			                 "port-irq22",
			                 "port-irq23";
			port-irq0-pins = <0>;
			port-irq1-pins = <1>;
			port-irq2-pins = <2>;
			port-irq3-pins = <3>;
			port-irq4-pins = <4>;
			port-irq29-pins = <5>;
			port-irq30-pins = <6>;
			port-irq31-pins = <7>;
			port-irq16-pins = <8>;
			port-irq17-pins = <9>;
			port-irq18-pins = <10>;
			port-irq19-pins = <11>;
			port-irq20-pins = <12>;
			port-irq21-pins = <13>;
			port-irq22-pins = <14>;
			port-irq23-pins = <15>;
			status = "disabled";
		};

		ioport2: gpio@87c00040 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00040 0x20>;
			port = <2>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq8 &port_irq9 &port_irq15 &port_irq3
			&port_irq12 &port_irq5 &port_irq2 &port_irq24
			&port_irq25 &port_irq26 &port_irq27 &port_irq28
			&port_irq29 &port_irq30 &port_irq31>;
			port-irq-names = "port-irq8",
					 		 "port-irq9",
							 "port-irq15",
					 		 "port-irq3",
							 "port-irq12",
					 		 "port-irq5",
							 "port-irq2",
							 "port-irq24",
							 "port-irq25",
			                 "port-irq26",
			                 "port-irq27",
			                 "port-irq28",
			                 "port-irq29",
			                 "port-irq30",
			                 "port-irq31";
			port-irq8-pins = <0>;
			port-irq9-pins = <1>;
			port-irq15-pins = <2>;
			port-irq3-pins = <3 7>;
			port-irq12-pins = <4>;
			port-irq5-pins = <5>;
			port-irq2-pins = <6>;
			port-irq24-pins = <8>;
			port-irq25-pins = <9>;
			port-irq26-pins = <10>;
			port-irq27-pins = <11>;
			port-irq28-pins = <12>;
			port-irq29-pins = <13>;
			port-irq30-pins = <14>;
			port-irq31-pins = <15>;
			status = "disabled";
		};

		ioport3: gpio@87c00060 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00060 0x20>;
			port = <3>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq6 &port_irq7 &port_irq4 &port_irq1
			&port_irq0 &port_irq18 &port_irq19 &port_irq20>;
			port-irq-names = "port-irq6",
			                 "port-irq7",
			                 "port-irq4",
			                 "port-irq1",
			                 "port-irq0",
			                 "port-irq18",
			                 "port-irq19",
			                 "port-irq20";
			port-irq6-pins = <0>;
			port-irq7-pins = <1>;
			port-irq4-pins = <2>;
			port-irq1-pins = <3>;
			port-irq0-pins = <4 5>;
			port-irq18-pins = <10>;
			port-irq19-pins = <11>;
			port-irq20-pins = <12>;
			status = "disabled";
		};

		ioport4: gpio@87c00080 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00080 0x20>;
			port = <4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq8 &port_irq9 &port_irq10 &port_irq11
			&port_irq12 &port_irq13 &port_irq14 &port_irq15
			&port_irq24 &port_irq25 &port_irq26 &port_irq27
			&port_irq28 &port_irq29 &port_irq30 &port_irq31>;
			port-irq-names = "port-irq8",
							 "port-irq9",
			                 "port-irq10",
			                 "port-irq11",
			                 "port-irq12",
			                 "port-irq13",
			                 "port-irq14",
			                 "port-irq15",
							 "port-irq24",
							 "port-irq25",
			                 "port-irq26",
			                 "port-irq27",
			                 "port-irq28",
			                 "port-irq29",
			                 "port-irq30",
			                 "port-irq31";
			port-irq8-pins = <0>;
			port-irq9-pins = <1>;
			port-irq10-pins = <2>;
			port-irq11-pins = <3>;
			port-irq12-pins = <4>;
			port-irq13-pins = <5>;
			port-irq14-pins = <6>;
			port-irq15-pins = <7>;
			port-irq24-pins = <8>;
			port-irq25-pins = <9>;
			port-irq26-pins = <10>;
			port-irq27-pins = <11>;
			port-irq28-pins = <12>;
			port-irq29-pins = <13>;
			port-irq30-pins = <14>;
			port-irq31-pins = <15>;
			status = "disabled";
		};

		ioport5: gpio@87c000a0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000A0 0x20>;
			port = <5>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq0 &port_irq1 &port_irq2 &port_irq3
			&port_irq4 &port_irq10 &port_irq6 &port_irq7
			&port_irq16 &port_irq17 &port_irq18 &port_irq19
			&port_irq20 &port_irq21 &port_irq22 &port_irq23>;
			port-irq-names = "port-irq0",
							 "port-irq1",
			                 "port-irq2",
			                 "port-irq3",
			                 "port-irq4",
			                 "port-irq10",
			                 "port-irq6",
			                 "port-irq7",
							 "port-irq16",
							 "port-irq17",
			                 "port-irq18",
			                 "port-irq19",
			                 "port-irq20",
			                 "port-irq21",
			                 "port-irq22",
			                 "port-irq23";
			port-irq0-pins = <0>;
			port-irq1-pins = <1>;
			port-irq2-pins = <2>;
			port-irq3-pins = <3>;
			port-irq4-pins = <4>;
			port-irq10-pins = <5>;
			port-irq6-pins = <6>;
			port-irq7-pins = <7>;
			port-irq16-pins = <8>;
			port-irq17-pins = <9>;
			port-irq18-pins = <10>;
			port-irq19-pins = <11>;
			port-irq20-pins = <12>;
			port-irq21-pins = <13>;
			port-irq22-pins = <14>;
			port-irq23-pins = <15>;
			status = "disabled";
		};

		ioport6: gpio@87c000c0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000C0 0x20>;
			port = <6>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			port-irqs = <&port_irq0 &port_irq1 &port_irq2 &port_irq3
			&port_irq4 &port_irq13 &port_irq14 &port_irq15>;
			port-irq-names = "port-irq0",
							 "port-irq1",
			                 "port-irq2",
			                 "port-irq3",
			                 "port-irq4",
			                 "port-irq13",
			                 "port-irq14",
			                 "port-irq15";
			port-irq0-pins = <0>;
			port-irq1-pins = <1>;
			port-irq2-pins = <2>;
			port-irq3-pins = <3>;
			port-irq4-pins = <4>;
			port-irq13-pins = <5>;
			port-irq14-pins = <6>;
			port-irq15-pins = <7>;
			status = "disabled";
		};

		ioport7: gpio@87c000e0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000E0 0x20>;
			port = <7>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq0 &port_irq1 &port_irq10 &port_irq8
			&port_irq12 &port_irq13 &port_irq14 &port_irq7
			&port_irq16 &port_irq17 &port_irq18 &port_irq19
			&port_irq20 &port_irq21 &port_irq22 &port_irq23>;
			port-irq-names = "port-irq0",
							 "port-irq1",
			                 "port-irq10",
			                 "port-irq8",
			                 "port-irq12",
			                 "port-irq13",
			                 "port-irq14",
			                 "port-irq7",
							 "port-irq16",
							 "port-irq17",
			                 "port-irq18",
			                 "port-irq19",
			                 "port-irq20",
			                 "port-irq21",
			                 "port-irq22",
			                 "port-irq23";
			port-irq0-pins = <0>;
			port-irq1-pins = <1>;
			port-irq10-pins = <2>;
			port-irq8-pins = <3>;
			port-irq12-pins = <4>;
			port-irq13-pins = <5>;
			port-irq14-pins = <6>;
			port-irq7-pins = <7>;
			port-irq16-pins = <8>;
			port-irq17-pins = <9>;
			port-irq18-pins = <10>;
			port-irq19-pins = <11>;
			port-irq20-pins = <12>;
			port-irq21-pins = <13>;
			port-irq22-pins = <14>;
			port-irq23-pins = <15>;
			status = "disabled";
		};

		ioport8: gpio@87c00100 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00100 0x20>;
			port = <8>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq8 &port_irq9 &port_irq2 &port_irq3
			&port_irq4 &port_irq5 &port_irq14 &port_irq15>;
			port-irq-names = "port-irq8",
							 "port-irq9",
			                 "port-irq2",
			                 "port-irq3",
			                 "port-irq4",
			                 "port-irq5",
			                 "port-irq14",
			                 "port-irq15";
			port-irq8-pins = <0>;
