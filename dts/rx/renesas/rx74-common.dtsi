			reg = <0x87C00180 0x20>;
			port = <12>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			port-irqs = <&port_irq14 &port_irq10 &port_irq11 &port_irq12
			&port_irq5 &port_irq13 &port_irq14>;
			port-irq-names = "port-irq14",
			                 "port-irq10",
			                 "port-irq11",
			                 "port-irq12",
			                 "port-irq5",
