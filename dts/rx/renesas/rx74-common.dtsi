			port-irq4-pins = <4>;
			port-irq5-pins = <5>;
			port-irq14-pins = <6>;
			port-irq15-pins = <7>;
			status = "disabled";
		};

		ioport9: gpio@87c00120 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00120 0x20>;
			port = <9>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			port-irqs = <&port_irq0 &port_irq9 &port_irq10 &port_irq11
			&port_irq12 &port_irq13 &port_irq14 &port_irq15>;
			port-irq-names = "port-irq0",
							 "port-irq9",
			                 "port-irq10",
			                 "port-irq11",
			                 "port-irq12",
			                 "port-irq13",
			                 "port-irq14",
			                 "port-irq15";
			port-irq0-pins = <0>;
			port-irq9-pins = <1>;
			port-irq10-pins = <2>;
			port-irq11-pins = <3>;
			port-irq12-pins = <4>;
			port-irq13-pins = <5>;
			port-irq14-pins = <6>;
			port-irq15-pins = <7>;
			status = "disabled";
		};

		ioporta: gpio@87c00140 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00140 0x20>;
			port = <10>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			port-irqs = <&port_irq1 &port_irq5 &port_irq6 &port_irq7
			&port_irq10 &port_irq11 &port_irq14>;
			port-irq-names = "port-irq1",
			                 "port-irq5",
			                 "port-irq6",
			                 "port-irq7",
			                 "port-irq10",
			                 "port-irq11",
			                 "port-irq14";
			port-irq1-pins = <0>;
			port-irq5-pins = <4 5>;
			port-irq6-pins = <3>;
			port-irq7-pins = <7>;
			port-irq10-pins = <2>;
			port-irq11-pins = <1>;
			port-irq14-pins = <6>;
			status = "disabled";
		};

		ioportb: gpio@87c00160 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00160 0x20>;
			port = <11>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			port-irqs = <&port_irq12 &port_irq4 &port_irq2 &port_irq3
			&port_irq13 &port_irq6 &port_irq15>;
			port-irq-names = "port-irq12",
			                 "port-irq4",
			                 "port-irq2",
			                 "port-irq3",
			                 "port-irq13",
			                 "port-irq6",
							 "port-irq15";
			port-irq12-pins = <0>;
			port-irq4-pins = <1 4>;
			port-irq2-pins = <2>;
