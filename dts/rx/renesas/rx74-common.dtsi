				reg = <0x86e1064c 0x4>;
				zephyr,memory-region = "OPTION_SETTING_MDE";
				status = "disabled";
			};

			option_setting_ofs1_sec: option-setting-ofs1-sec@86e107a0 {
				compatible = "zephyr,memory-region";
				reg = <0x86e107a0 0x4>;
				zephyr,memory-region = "OPTION_SETTING_OFS1_SEC";
