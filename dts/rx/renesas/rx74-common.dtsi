#include <mem.h>
#include <zephyr/dt-bindings/clock/rx_clock.h>
#include <zephyr/dt-bindings/pinctrl/renesas/pinctrl-rx-pfs.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "renesas,rxv3e";
			device_type = "cpu";
			reg = <0>;
			status = "okay";
		};
	};

	icu: interrupt-controller@87006000 {
		#interrupt-cells = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "renesas,rx-icum";
		interrupt-controller;
		reg = <0x87006000 0x100>,
		      <0x87006200 0x20>,
		      <0x87006300 0x100>,
		      <0x870062f0 0x02>,
		      <0x87006c20 0x20>;
		reg-names = "IR", "IER", "IPR", "FIR", "IRQCR";

		swint1: swint1@870062e0 {
			compatible = "renesas,rx-swint";
			reg = <0x870062e0 0x01>;
			interrupts = <27 14>;
			interrupt-parent = <&icu>;
			status = "okay";
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		device_type = "soc";
		compatible = "simple-bus";
		interrupt-parent = <&icu>;

		ioport0: gpio@87c00000 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00000 0x20>;
			port = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport1: gpio@87c00020 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00020 0x20>;
			port = <1>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport2: gpio@87c00040 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00040 0x20>;
			port = <2>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport3: gpio@87c00060 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00060 0x20>;
			port = <3>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport4: gpio@87c00080 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00080 0x20>;
			port = <4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport5: gpio@87c000a0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000A0 0x20>;
			port = <5>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport6: gpio@87c000c0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000C0 0x20>;
			port = <6>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport7: gpio@87c000e0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000E0 0x20>;
			port = <7>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport8: gpio@87c00100 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00100 0x20>;
			port = <8>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport9: gpio@87c00120 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00120 0x20>;
			port = <9>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioporta: gpio@87c00140 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00140 0x20>;
			port = <10>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportb: gpio@87c00160 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00160 0x20>;
			port = <11>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportc: gpio@87c00180 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00180 0x20>;
			port = <12>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportd: gpio@87c001a0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001A0 0x20>;
			port = <13>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioporte: gpio@87c001c0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001C0 0x20>;
			port = <14>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportf: gpio@87c001e0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001E0 0x20>;
			port = <15>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportg: gpio@87c00200 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00200 0x20>;
			port = <16>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		sci0: sci0@87458000 {
			compatible = "renesas,rx-sci";
			reg = <0x87458000 0x100>;
			status = "disabled";
			channel = <0>;

			uart {
				compatible = "renesas,rx-uart-sci-qemu";
				status = "disabled";
			};
		};

		cmt: timer@87826000 {
			compatible = "renesas,rx-timer-cmt-start-control";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x87826000 0x02>;
			clocks = <&pclkb MSTPF 15>;
			reg-names = "CMSTR0";
			status = "okay";

			cmt0: timer@87826002 {
				compatible = "renesas,rx-timer-cmt";
				#address-cells = <1>;
				#size-cells = <1>;
				reg = <0x87826002 0x02>,
				      <0x87826004 0x02>,
				      <0x87826006 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <28 1>;
				interrupt-names = "cmi";
				status = "okay";
			};

			cmt1: timer@87826008 {
				compatible = "renesas,rx-timer-cmt";
				reg = <0x87826008 0x02>,
				      <0x8782600A 0x02>,
				      <0x8782600C 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <29 1>;
				interrupt-names = "cmi";
				status = "disabled";
			};
		};

		pinctrl: pin-controller@87c00800 {
			compatible = "renesas,rx-pinctrl-pfs";
			reg = <0x87C00800 0x3c0>;
			status = "okay";
		};

		ofsm: ofsm@ffffff80 {
			compatible = "zephyr,memory-region";
			reg = <0xFFFFFF80 0x0F>;
			zephyr,memory-region = "OFSM";
			status = "okay";
		};
	};
};
