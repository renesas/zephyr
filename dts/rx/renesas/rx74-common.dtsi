				zephyr,memory-region = "OPTION_SETTING_DATA_FLASH_SAMR";
				status = "disabled";
			};

			option_setting_data_flash_sacc0: option-setting-data-flash-sacc0@86e00420 {
				compatible = "zephyr,memory-region";
				reg = <0x86e00420 0x4>;
				zephyr,memory-region = "OPTION_SETTING_DATA_FLASH_SACC0";
				status = "disabled";
			};

			option_setting_data_flash_sacc10: option-setting-data-flash-sacc10@86e00430 {
