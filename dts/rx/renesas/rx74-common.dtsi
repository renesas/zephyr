		// 	option_setting_arcnsn: option-setting-arcnsn@86f41e00 {
		// 		compatible = "renesas,ofs-memory";
		// 		reg = <0x86f41e00 0x80>;
		// 		status = "okay";
		// 	};

		// 	option_setting_arcns: option-setting-arcns0@86f41e00 {
		// 		compatible = "renesas,ofs-memory";
		// 		reg = <0x86f41e00 0x80>;
