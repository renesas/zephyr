#include <mem.h>
#include <zephyr/dt-bindings/clock/rx_clock.h>
#include <zephyr/dt-bindings/pinctrl/renesas/pinctrl-rx-pfs.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "renesas,rxv3e";
			device_type = "cpu";
			reg = <0>;
			status = "okay";
		};
	};

	icu: interrupt-controller@87006000 {
		#interrupt-cells = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "renesas,rx-icum";
		interrupt-controller;
		reg = <0x87006000 0x100>,
		      <0x87006200 0x20>,
		      <0x87006300 0x100>,
		      <0x870062f0 0x02>,
		      <0x87006c20 0x20>;
		reg-names = "IR", "IER", "IPR", "FIR", "IRQCR";

		swint1: swint1@870062e0 {
			compatible = "renesas,rx-swint";
			reg = <0x870062e0 0x01>;
			interrupts = <27 14>;
			interrupt-parent = <&icu>;
			status = "okay";
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		device_type = "soc";
		compatible = "simple-bus";
		interrupt-parent = <&icu>;

		ioport0: gpio@87c00000 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00000 0x20>;
			port = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport1: gpio@87c00020 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00020 0x20>;
			port = <1>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport2: gpio@87c00040 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00040 0x20>;
			port = <2>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport3: gpio@87c00060 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00060 0x20>;
			port = <3>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport4: gpio@87c00080 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00080 0x20>;
			port = <4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport5: gpio@87c000a0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000A0 0x20>;
			port = <5>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport6: gpio@87c000c0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000C0 0x20>;
			port = <6>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport7: gpio@87c000e0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C000E0 0x20>;
			port = <7>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport8: gpio@87c00100 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00100 0x20>;
			port = <8>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioport9: gpio@87c00120 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00120 0x20>;
			port = <9>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioporta: gpio@87c00140 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00140 0x20>;
			port = <10>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportb: gpio@87c00160 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00160 0x20>;
			port = <11>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportc: gpio@87c00180 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00180 0x20>;
			port = <12>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportd: gpio@87c001a0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001A0 0x20>;
			port = <13>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioporte: gpio@87c001c0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001C0 0x20>;
			port = <14>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportf: gpio@87c001e0 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C001E0 0x20>;
			port = <15>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		ioportg: gpio@87c00200 {
			compatible = "renesas,rx-gpio-ioport";
			reg = <0x87C00200 0x20>;
			port = <16>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "disabled";
		};

		sci0: sci0@87458000 {
			compatible = "renesas,rx-sci";
			reg = <0x87458000 0x100>;
			status = "disabled";
			channel = <0>;

			uart {
				compatible = "renesas,rx-uart-sci-qemu";
				status = "disabled";
			};
		};

		cmt: timer@87826000 {
			compatible = "renesas,rx-timer-cmt-start-control";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x87826000 0x02>;
			clocks = <&pclkb MSTPF 15>;
			reg-names = "CMSTR0";
			status = "okay";

			cmt0: timer@87826002 {
				compatible = "renesas,rx-timer-cmt";
				#address-cells = <1>;
				#size-cells = <1>;
				reg = <0x87826002 0x02>,
				      <0x87826004 0x02>,
				      <0x87826006 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <28 1>;
				interrupt-names = "cmi";
				status = "okay";
			};

			cmt1: timer@87826008 {
				compatible = "renesas,rx-timer-cmt";
				reg = <0x87826008 0x02>,
				      <0x8782600A 0x02>,
				      <0x8782600C 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <29 1>;
				interrupt-names = "cmi";
				status = "disabled";
			};
		};

		pinctrl: pin-controller@87c00800 {
			compatible = "renesas,rx-pinctrl-pfs";
			reg = <0x87C00800 0x3c0>;
			status = "okay";
		};

		option_setting_mem_cfg_sec: option-setting-mem-cfg-sec@86c2e850 {
			compatible = "zephyr,memory-region";
			reg = <0x86c2e850 0x715b0>;
			zephyr,memory-region = "OFS_MEM_CFG_SEC";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			option_setting_dualsel: option-setting-dualsel0@86c2e850 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c2e850 0x4>;
				status = "okay";
			};

			option_setting_sas: option-setting-sas@86c2e870 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c2e870 0x4>;
				status = "okay";
			};

			option_setting_sas2: option-setting-sas2@86c2e874 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c2e874 0x4>;
				status = "okay";
			};

			option_setting_banksel_sec: option-setting-banksel-sec@86c2e9b0 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c2e9b0 0x4>;
				status = "okay";
			};

			option_setting_blsel_sec: option-setting-blsel-sec@86c2e9c0 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c2e9c0 0x4>;
				status = "okay";
			};

			option_setting_banksel_sel: option-setting-banksel-sel@86c2e9e0 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c2e9e0 0x4>;
				status = "okay";
			};

			option_setting_blsel_sel: option-setting-blsel-sel@86c2e9f0 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c2e9f0 0x4>;
				status = "okay";
			};

			option_setting_bpsdm_sec: option-setting-bpsdm-sec@86c9f080 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c9f080 0x20>;
				status = "okay";
			};

			option_setting_bps_sec: option-setting-bps-sec@86c9f200 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c9f200 0x40>;
				status = "okay";
			};

			option_setting_bps_sec_dual: option-setting-bps-sec-dual@86c9f300 {
				compatible = "renesas,ofs-memory";
				reg = <0x86c9f300 0x20>;
				status = "okay";
			};
		};

		option_setting_opt_sec: option-setting-opt-sec@86e00000 {
			compatible = "zephyr,memory-region";
			reg = <0x86e00000 0x00030ef0>;
			zephyr,memory-region = "OFS_OPT_SEC";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			// option_setting_data_flash_hoemrtpk: option-setting-data-flash-hoemrtpk@86e00000 {
			// 	compatible = "renesas,ofs-memory";
			// 	reg = <0x86e00000 0xc0>;
			// 	status = "okay";
			// };

			option_setting_data_flash_fsblctrl0: option-setting-data-flash-fsblctrl@86e00400 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00400 0x4>;
				status = "okay";
			};

			option_setting_data_flash_fsblctrl1: option-setting-data-flash-fsblctrl@86e00404 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00404 0x4>;
				status = "okay";
			};

			option_setting_data_flash_fsblctrl2: option-setting-data-flash-fsblctrl2@86e00408 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00408 0x4>;
				status = "okay";
			};

			option_setting_data_flash_samr: option-setting-data-flash-samr@86e00414 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00414 0x4>;
				status = "okay";
			};

			option_setting_data_flash_sacc0: option-setting-data-flash-sacc0@86e00420 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00420 0x4>;
				status = "okay";
			};

			option_setting_data_flash_sacc10: option-setting-data-flash-sacc10@86e00430 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00430 0x4>;
				status = "okay";
			};

			option_setting_data_flash_sacc1: option-setting-data-flash-sacc1@86e00440 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00440 0x4>;
				status = "okay";
			};

			option_setting_data_flash_sacc11: option-setting-data-flash-sacc11@86e00450 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00450 0x4>;
				status = "okay";
			};

			option_setting_data_flash_sacc2: option-setting-data-flash-sacc2@86e00460 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00460 0x4>;
				status = "okay";
			};


			option_setting_data_flash_sacc12: option-setting-data-flash-sacc2@86e00470 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00470 0x4>;
				status = "okay";
			};

			option_setting_data_flash_sacc3: option-setting-data-flash-sacc3@86e00480 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00480 0x4>;
				status = "okay";
			};

			option_setting_data_flash_sacc13: option-setting-data-flash-sacc13@86e00490 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e00490 0x4>;
				status = "okay";
			};

			option_setting_gpotp: option-setting-gpotp@86e004a0 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e004a0 0x60>;
				status = "okay";
			};

			option_setting_ofs0: option-setting-ofs0@86e10640 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e10640 0x4>;
				status = "okay";
			};

			option_setting_ofs2: option-setting-ofs2@86e10644 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e10644 0x4>;
				status = "okay";
			};

			option_setting_mde: option-setting-mde@86e1064c {
				compatible = "renesas,ofs-memory";
				reg = <0x86e1064c 0x4>;
				status = "okay";
			};

			option_setting_ofs1_sec: option-setting-ofs1-sec@86e107a0 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e107a0 0x4>;
				status = "okay";
			};

			option_setting_ofs3_sec: option-setting-ofs3-sec@86e107a4 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e107a4 0x4>;
				status = "okay";
			};

			option_setting_ofs1_sel: option-setting-ofs1-sel@86e107d0 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e107d0 0x4>;
				status = "okay";
			};

			option_setting_ofs3_sel: option-setting-ofs3-sel@86e107d4 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e107d4 0x4>;
				status = "okay";
			};

			option_setting_pbps_sec: option-setting-pbps-sec@86e10a00 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e10a00 0x10>;
				status = "okay";
			};

			option_setting_pbps_sec_dual: option-setting-pbps-sec-dual@86e10a40 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e10a40 0x8>;
				status = "okay";
			};

			option_setting_pbpsdm_sec: option-setting-pbpsdm-sec@86e10a80 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e10a80 0x4>;
				status = "okay";
			};

			option_setting_revoke: option-setting-revoke@86e30e10 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e30e10 0x4>;
				status = "okay";
			};

			option_setting_zhuk: option-setting-zhuk@86e30e20 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e30e20 0x4>;
				status = "okay";
			};

			option_setting_arccs: option-setting-arccs@86e30e30 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e30e30 0x4>;
				status = "okay";
			};

			option_setting_ubcsr: option-setting-ufbcsr@86e30e50 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e30e50 0x4>;
				status = "okay";
			};

			option_setting_ofsps: option-setting-ofsps@86e30e60 {
				compatible = "renesas,ofs-memory";
				reg = <0x86e30e60 0x10>;
				status = "okay";
			};

			/* Since the RFP tool currently does not support the following OFS regions,
			 * they have been temporarily commented out to enable flashing via RFP.
			 */

			// option_setting_ofsps2: option-setting-ofsps2@86e30ee0 {
			// 	compatible = "renesas,ofs-memory";
			// 	reg = <0x86e30ee0 0x4>;
			// 	status = "okay";
			// };
		};

		// option_setting_anti_rollback_sec: option-setting-anti-rollback-sec@86f41d00 {
