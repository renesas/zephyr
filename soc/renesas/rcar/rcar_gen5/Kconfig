config SOC_R8A78000_R52
	select ARM
	select CPU_CORTEX_R52
	select GIC_SINGLE_SECURITY_STATE
	select CPU_HAS_DCLS
	select CPU_HAS_ARM_MPU
	select HAS_RENESAS_RCARSOC_DRV
	select SOC_EARLY_INIT_HOOK

config RCAR_BACKUP_BUFFER
	bool "R-Car Backup Buffer"
	default y
	depends on DT_HAS_RENESAS_RCAR_BACKUP_BUFFER_ENABLED
	help
	  Enable support for the Renesas R-Car backup buffer.

config RCAR_BACKUP_BUFFER_INIT_PRIORITY
	int "R-Car Backup Buffer init priority"
	default APPLICATION_INIT_PRIORITY
	depends on RCAR_BACKUP_BUFFER
	help
	  R-Car backup buffer device initialization priority.
