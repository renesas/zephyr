DT_CHOSEN_Z_ITCM := zephyr,itcm

config SOC_R8A78000_R52
	select ARM
	select CPU_CORTEX_R52
	select GIC_SINGLE_SECURITY_STATE
	select CPU_HAS_DCLS
	select CPU_HAS_ARM_MPU
	select HAS_RENESAS_RCARSOC_DRV
	select SOC_EARLY_INIT_HOOK
	select SOC_RESET_HOOK

config RCAR_BACKUP_BUFFER
	bool "R-Car Backup Buffer"
	default y
	depends on DT_HAS_RENESAS_RCAR_BACKUP_BUFFER_ENABLED
	help
	  Enable support for the Renesas R-Car backup buffer.

config RCAR_BACKUP_BUFFER_INIT_PRIORITY
	int "R-Car Backup Buffer init priority"
	default APPLICATION_INIT_PRIORITY
	depends on RCAR_BACKUP_BUFFER
	help
	  R-Car backup buffer device initialization priority.

config RCAR_GEN5_R52_ITCM_NET_HOT_PATH
	bool "Run the network per-packet path from ITCM"
	depends on SOC_R8A78000_R52
	depends on $(dt_chosen_enabled,$(DT_CHOSEN_Z_ITCM))
	depends on NETWORKING
	depends on !XIP
	help
	  Link the functions of the network per-packet path (sockets, UDP,
	  TCP, IPv4, Ethernet L2, R-Switch 3 GWCA driver, net_pkt/net_buf,
	  scheduler and memcpy) into the ITCM. The path is larger than the
	  32 KB L1 instruction cache, and running it from the TCM removes the
	  instruction cache misses (about 80 CPU cycles each) on every frame.
	  The list is in r52/itcm.ld; functions that are not built are
	  ignored. Not for XIP images: their boot code runs memset() and
	  memcpy() before arch_data_copy() has loaded the ITCM.

config RCAR_GEN5_R52_FAST_MEMCPY
	bool "Optimized memcpy for the Cortex-R52"
	depends on SOC_R8A78000_R52
	depends on PICOLIBC
	help
	  Replace the C library memcpy() with the Armv8-R routine of
	  hal_renesas. picolibc only builds its optimized ARM memcpy for the
	  A profile, so the R52 otherwise gets the generic C version. The
	  routine moves 32 bytes per iteration with LDM/STM, and is placed in
	  the ITCM when one is chosen and the image is not XIP.

config RCAR_GEN5_R52_FAST_MEMCPY_NEON
	bool "Use Advanced SIMD in the optimized memcpy"
	depends on RCAR_GEN5_R52_FAST_MEMCPY
	depends on FPU_SHARING
	help
	  Move 32 bytes per iteration with VLD1/VST1 of d0-d3 instead of
	  LDM/STM (the X5H realtime core implements Advanced SIMD). memcpy()
	  runs in every thread and ISR, so this needs FPU sharing: each thread
	  that copies then saves and restores its FP registers on context
	  switches, and an ISR that copies takes an undefined instruction
	  exception to save the FP registers it interrupted.
