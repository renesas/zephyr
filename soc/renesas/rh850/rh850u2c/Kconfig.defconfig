# SPDX-License-Identifier: Apache-2.0

if SOC_SERIES_RH850U2C

config CLOCK_CONTROL_INIT_PRIORITY
	default 30

config NUM_IRQS
	default 1024

DT_CHOSEN_SYSTEM_TIMER := zephyr,system-timer
DT_SYSTEM_TIMER_PATH := $(dt_chosen_path,$(DT_CHOSEN_SYSTEM_TIMER))

# System Clock Hardware cycles per second calculation
DT_CLKC_HSB_PATH := $(dt_nodelabel_path,clkc_hsb)
DT_CLKC_HSB_PARENT_PATH := $(dt_node_ph_prop_path,$(DT_CLKC_HSB_PATH),clock-source)
DT_CLKC_HSB_ROOT_PATH := $(dt_node_ph_prop_path,$(DT_CLKC_HSB_PARENT_PATH),clock-source)
DT_CLKC_HSB_ROOT_FREQ := $(dt_node_int_prop_int,$(DT_CLKC_HSB_ROOT_PATH),clock-frequency)
DT_CLKC_HSB_PARENT_DIV := $(max,1,$(dt_node_int_prop_int,$(DT_CLKC_HSB_PARENT_PATH),div))
DT_CLKC_HSB_DIV := $(max,1,$(dt_node_int_prop_int,$(DT_CLKC_HSB_PATH),div))

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(div,$(DT_CLKC_HSB_ROOT_FREQ),$(DT_CLKC_HSB_PARENT_DIV),$(DT_CLKC_HSB_DIV))

config BUILD_OUTPUT_HEX
	default y

config BUILD_OUTPUT_BIN
	default y

config BUILD_OUTPUT_S19
	default y

config CLOCK_CONTROL
	default y

config DYNAMIC_INTERRUPTS
	default y

config MULTITHREADING
	default y

# Address of the reset cause register used to determine memory initialization.
config RH850_RESET_CAUSE_REG_ADDR
	default 0xFF988500

# Mask used to evaluate reset cause for memory initialization.
config RH850_RESET_CAUSE_MASK
	default 0x301D0

# Set to the minimal size of data which can be written.
config FLASH_FILL_BUFFER_SIZE
	default 128

endif # SOC_SERIES_RH850U2C
