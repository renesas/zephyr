+    # RA_NS_WINDOW_STARTS/ENDS defaults in config.cmake).
+    set(SDRAM_CPU0_N_START "0x6c000000")
+    set(SDRAM_CPU0_N_SIZE "0x2000000")
+    set(OSPI0_CS0_CPU0_N_START "0x88000000")
