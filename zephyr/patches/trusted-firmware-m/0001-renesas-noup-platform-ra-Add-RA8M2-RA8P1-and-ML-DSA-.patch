diff --git a/platform/ext/target/renesas/ra/common/core/ns/common.cmake b/platform/ext/target/renesas/ra/common/core/ns/common.cmake
new file mode 100644
index 000000000..653d65a61
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/ns/common.cmake
@@ -0,0 +1,195 @@
+#-------------------------------------------------------------------------------
+# Copyright (c) 2026 Renesas Electronics Corporation
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#-------------------------------------------------------------------------------
+
+# Shared RA platform_ns build logic, included from each board's exported
+# ns/CMakeLists.txt. The board file must set FSP_SOC_TARGET (e.g. ra8p1) and
+# FSP_BOARD_TARGET (e.g. ra8p1_ek) before including this file; everything
+# else resolves through TARGET_PLATFORM_PATH (the board dir) and
+# RENESAS_RA_COMMON_SOURCE_DIR (ra/common, set by cpuarch.cmake/config.cmake).
+
+add_library(platform_ns)
+
+target_compile_definitions(platform_ns
+    PRIVATE
+        DOMAIN_NS=1
+)
+
+target_sources(platform_ns
+    PRIVATE
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/core/Device/Source/startup.c
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/core/CMSIS_Driver/Driver_USART.c
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/core/ns/tfm_platform_ns_init.c
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_ioctl_ns_api.c
+)
+
+if(RA_CM33_NS_PRESENT)
+    target_sources(platform_ns
+        PRIVATE
+            ${CONFIG_SPE_PATH}/interface/src/multi_core/platform_multicore.c
+    )
+
+    target_include_directories(platform_ns
+        PRIVATE
+            ${CONFIG_SPE_PATH}/interface/include/multi_core
+    )
+endif()
+
+target_include_directories(platform_ns
+    PUBLIC
+        ${TARGET_PLATFORM_PATH}
+        ${TARGET_PLATFORM_PATH}/CMSIS_Driver/Config
+        ${CMAKE_CURRENT_SOURCE_DIR}/include
+        ${CMAKE_CURRENT_SOURCE_DIR}/ext/cmsis/Include
+        ${CMAKE_CURRENT_SOURCE_DIR}/ext/cmsis/Include/m-profile
+        ${CMAKE_CURRENT_SOURCE_DIR}/ext/common
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/core/Native_Driver
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/inc
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/${FSP_SOC_TARGET}/partition
+)
+
+# Include region_defs.h and flash_layout.h
+target_include_directories(platform_region_defs
+    INTERFACE
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/${FSP_SOC_TARGET}/partition
+)
+
+# Include NS FSP library (reuses S-side FSP clone, includes the s_ns_*.cmake settings
+# and the SoC's fsp_post_config.cmake, whose fsp_library_config defs apply only to
+# the fsp_library sources)
+include(${RENESAS_RA_COMMON_SOURCE_DIR}/core/fsp/fsp_ns_lib.cmake)
+
+# Platform dependencies for the remote NSPE mailbox implementation.
+if(RA_CORE STREQUAL "cm33")
+    # app_broker also compiles mailbox sources in ns_multi_core, which links
+    # platform_ns but does not inherit tfm_api_ns_mailbox's compile options
+    # through tfm_api_ns's PRIVATE dependency. Share the configuration through
+    # both targets so all users of the mailbox structures agree on the layout.
+    add_library(ra_ns_mailbox_config INTERFACE)
+    target_include_directories(ra_ns_mailbox_config
+        INTERFACE
+            ${CONFIG_SPE_PATH}/interface/include
+    )
+    target_compile_options(ra_ns_mailbox_config
+        INTERFACE
+            "$<$<COMPILE_LANGUAGE:C>:SHELL:-include config_tfm.h>"
+    )
+
+    target_link_libraries(tfm_api_ns_mailbox
+        PRIVATE
+            platform_region_defs
+            fsp_library
+        PUBLIC
+            ra_ns_mailbox_config
+    )
+
+    target_link_libraries(platform_ns
+        PUBLIC
+            ra_ns_mailbox_config
+    )
+endif()
+
+# Link platform_ns against platform_region_defs to get memory region defines
+target_link_libraries(platform_ns
+    PUBLIC
+        platform_region_defs
+        fsp_library
+    INTERFACE
+        # FSP objects go straight onto the NS executable's link line
+        $<TARGET_OBJECTS:fsp_library>
+)
+
+target_compile_definitions(platform_ns
+    PUBLIC
+        $<$<BOOL:${PLATFORM_DEFAULT_CRYPTO_KEYS}>:PLATFORM_DEFAULT_CRYPTO_KEYS>
+)
+
+#===================== NS image signing (BL2) ===============================#
+
+# The S and NS images are separate MCUboot images and are never merged: the NS
+# image can be in another flash (RA_CPU0_NS_EXTERNAL / RA_CPU1_NS_EXTERNAL) and
+# is programmed on its own. TF-M's default signing in the installed spe
+# CMakeLists.txt (PLATFORM_DEFAULT_IMAGE_SIGNING) assembles a combined
+# tfm_s_ns_signed image with the CPU0 NS offset, and has no option to skip only
+# that step, so it is turned off (spe_config sets it in the spe directory scope,
+# which is read after this directory) and the NS image is signed here with the
+# layout and keys exported by the secure build. The S image is signed by the
+# secure build.
+#
+# CPU0 (TrustZone) is MCUboot image 1. CPU1 (mailbox) is image 2: it is signed
+# with the S key (the default provisioning stores the S key hash in
+# BL2_ROTPK_2) and its own layout, installed by the secure build. The _ns.o
+# suffix of the layouts makes the signing wrapper record the image as non-secure
+# for measured boot.
+if(BL2 AND MCUBOOT_IMAGE_NUMBER GREATER 1)
+    set(PLATFORM_DEFAULT_IMAGE_SIGNING OFF PARENT_SCOPE)
+
+    set(_ra_signing_dir ${CMAKE_CURRENT_SOURCE_DIR}/../image_signing)
+
+    if(RA_NS_INTERFACE_MAILBOX)
+        set(_ra_ns_layout       ${_ra_signing_dir}/layout_files/signing_layout_cpu1_ns.o)
+        set(_ra_ns_key          ${MCUBOOT_KEY_S})
+        set(_ra_ns_version      ${MCUBOOT_IMAGE_VERSION_CPU1_NS})
+        set(_ra_ns_counter      ${MCUBOOT_SECURITY_COUNTER_CPU1_NS})
+        set(_ra_ns_extra_args)
+    else()
+        set(_ra_ns_layout       ${_ra_signing_dir}/layout_files/signing_layout_ns.o)
+        set(_ra_ns_key          ${MCUBOOT_KEY_NS})
+        set(_ra_ns_version      ${MCUBOOT_IMAGE_VERSION_NS})
+        set(_ra_ns_counter      ${MCUBOOT_SECURITY_COUNTER_NS})
+        # The NS image depends on the S image (minimum version)
+        set(_ra_ns_extra_args
+            -d \"\(0, ${MCUBOOT_S_IMAGE_MIN_VER}\)\"
+            $<$<BOOL:${MCUBOOT_ENC_IMAGES}>:-E${MCUBOOT_KEY_ENC_NS}>
+        )
+        if(MCUBOOT_IMAGE_BINDING)
+            list(APPEND _ra_ns_extra_args
+                --extra-tlv "${TLV_METADATA}"
+                --extra-tlv "${TLV_BINDING_TAG}"
+            )
+        endif()
+        if(MCUBOOT_BUILTIN_KEY)
+            list(APPEND _ra_ns_extra_args --psa-key-ids ${TFM_NS_KEY_ID})
+        endif()
+    endif()
+
+    set(_ra_ns_wrapper_args
+        --version ${_ra_ns_version}
+        --layout ${_ra_ns_layout}
+        --key ${_ra_ns_key}
+        --public-key-format $<IF:$<BOOL:${MCUBOOT_HW_KEY}>,full,hash>
+        --align ${MCUBOOT_ALIGN_VAL}
+        --pad
+        --pad-header
+        -H ${BL2_HEADER_SIZE}
+        -s ${_ra_ns_counter}
+        -L ${MCUBOOT_ENC_KEY_LEN}
+        ${_ra_ns_extra_args}
+        $<$<STREQUAL:${MCUBOOT_UPGRADE_STRATEGY},OVERWRITE_ONLY>:--overwrite-only>
+        $<$<BOOL:${MCUBOOT_CONFIRM_IMAGE}>:--confirm>
+        $<$<BOOL:${MCUBOOT_MEASURED_BOOT}>:--measured-boot-record>
+        $<TARGET_FILE_DIR:${NS_TARGET_NAME}>/${NS_TARGET_NAME}.bin
+        ${CMAKE_BINARY_DIR}/bin/${NS_TARGET_NAME}_signed.bin
+    )
+
+    add_custom_target(${NS_TARGET_NAME}_signed_bin ALL
+        SOURCES ${CMAKE_BINARY_DIR}/bin/${NS_TARGET_NAME}_signed.bin
+    )
+    add_custom_command(OUTPUT ${CMAKE_BINARY_DIR}/bin/${NS_TARGET_NAME}_signed.bin
+        DEPENDS ${NS_TARGET_NAME}_bin
+        DEPENDS ${_ra_ns_layout}
+        WORKING_DIRECTORY ${_ra_signing_dir}/scripts
+        COMMAND mcuboot_imagesign_wrapper ${_ra_ns_wrapper_args}
+    )
+
+    add_convert_to_offset_hex_target(${NS_TARGET_NAME}_signed
+        INPUT_FILE          ${CMAKE_BINARY_DIR}/bin/${NS_TARGET_NAME}_signed.bin
+        OFFSET_MACRO_NAME   NS_CODE_START
+        INCLUDE_BL2_HEADER  TRUE
+        MIRROR_FILE         $<TARGET_PROPERTY:${NS_TARGET_NAME},LINK_DEPENDS>
+        OUTPUT_FILE         ${CMAKE_BINARY_DIR}/bin/${NS_TARGET_NAME}_signed.hex
+    )
+endif()
diff --git a/platform/ext/target/renesas/ra/common/core/ns/config.cmake.in b/platform/ext/target/renesas/ra/common/core/ns/config.cmake.in
new file mode 100644
index 000000000..e0ca1fbe4
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/ns/config.cmake.in
@@ -0,0 +1,92 @@
+#-------------------------------------------------------------------------------
+# Copyright (c) 2026 Renesas Electronics Corporation
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#-------------------------------------------------------------------------------
+
+# Generated from common/core/ns/config.cmake.in during the secure build and
+# installed as <spe>/platform/config.cmake. This file contains configuration
+# settings that depend on the NS target (CPU0 or CPU1) and the NS interface
+# (TrustZone or mailbox), and is used by the non-secure build to configure
+# the NS image.
+
+#===================== SoC hardware facts ======================================#
+include(${RENESAS_RA_SOC_SOURCE_DIR}/config.cmake)
+
+#===================== Used non-secure clients =================================#
+set(RA_CM85_NS_PRESENT "@RA_CM85_NS_PRESENT@" CACHE BOOL "Serve a local TrustZone NS client on CPU0 (Cortex-M85)")
+set(RA_CM33_NS_PRESENT "@RA_CM33_NS_PRESENT@" CACHE BOOL "Serve a remote mailbox NS client on CPU1 (Cortex-M33)")
+
+#===================== Resolved flash/RAM map ==================================#
+
+set(FLASH_AREA_BL2_OFFSET        "@FLASH_AREA_BL2_OFFSET@"        CACHE STRING "BL2 offset" FORCE)
+set(FLASH_AREA_BL2_SIZE          "@FLASH_AREA_BL2_SIZE@"          CACHE STRING "BL2 size" FORCE)
+set(FLASH_SLOTS_PER_IMAGE     "@FLASH_SLOTS_PER_IMAGE@"     CACHE INTERNAL "Number of MRAM slots per image (primary, plus secondary with BL2)" FORCE)
+set(FLASH_S_REGION_SIZE       "@FLASH_S_REGION_SIZE@"       CACHE INTERNAL "Size of the secure-attributed MRAM (BL2, S slots, storage)" FORCE)
+
+# Flash instances: 0 is the MRAM (FLASH0_*, from the SoC config.cmake above),
+# 1 the flash the NS images can be relocated to. FLASH_AREA_IMAGE_SECTOR_SIZE and FLASH_PROGRAM_UNIT are
+# the largest values of the instances that hold an image.
+set(FLASH1_DEV_NAME              "@FLASH1_DEV_NAME@"             CACHE STRING "CMSIS flash driver of flash instance 1" FORCE)
+set(FLASH1_SECTOR_SIZE           "@FLASH1_SECTOR_SIZE@"          CACHE STRING "Flash instance 1 FS block granularity" FORCE)
+set(FLASH1_PROGRAM_UNIT          "@FLASH1_PROGRAM_UNIT@"         CACHE STRING "Flash instance 1 minimum write size in bytes" FORCE)
+set(RA_CPU0_NS_EXTERNAL          "@RA_CPU0_NS_EXTERNAL@"         CACHE INTERNAL "CPU0 NS image is in flash instance 1" FORCE)
+set(RA_CPU1_NS_EXTERNAL          "@RA_CPU1_NS_EXTERNAL@"         CACHE INTERNAL "CPU1 NS image is in flash instance 1" FORCE)
+set(FLASH_AREA_IMAGE_SECTOR_SIZE "@FLASH_AREA_IMAGE_SECTOR_SIZE@" CACHE INTERNAL "Sector size used by the MCUboot flash map" FORCE)
+set(FLASH_PROGRAM_UNIT           "@FLASH_PROGRAM_UNIT@"          CACHE INTERNAL "Program unit used by the MCUboot flash map" FORCE)
+
+set(S_ROM_ALIAS_BASE             "@S_ROM_ALIAS_BASE@"       CACHE STRING "MRAM secure alias base" FORCE)
+set(S_RAM_ALIAS_BASE             "@S_RAM_ALIAS_BASE@"       CACHE STRING "SRAM secure alias base" FORCE)
+set(FLASH_S_PARTITION_SIZE       "@FLASH_S_PARTITION_SIZE@" CACHE STRING "Secure image slot size" FORCE)
+
+set(FLASH_PS_AREA_SIZE              "@FLASH_PS_AREA_SIZE@"              CACHE STRING "Protected Storage area size" FORCE)
+set(FLASH_ITS_AREA_SIZE             "@FLASH_ITS_AREA_SIZE@"             CACHE STRING "Internal Trusted Storage area size" FORCE)
+set(FLASH_OTP_NV_COUNTERS_AREA_SIZE "@FLASH_OTP_NV_COUNTERS_AREA_SIZE@" CACHE STRING "OTP/NV counters area size" FORCE)
+set(FLASH_STORAGE_TOTAL_SIZE        "@FLASH_STORAGE_TOTAL_SIZE@"        CACHE INTERNAL "Total storage area size" FORCE)
+
+set(S_DATA_SIZE                     "@S_DATA_SIZE@"                     CACHE STRING "Secure RAM size" FORCE)
+set(S_RAM_CODE_SIZE                 "@S_RAM_CODE_SIZE@"                 CACHE STRING "Secure RAM size for RAM-resident MRAM programming code" FORCE)
+
+set(FLASH_CPU0_NS_PARTITION_SIZE    "@FLASH_CPU0_NS_PARTITION_SIZE@"    CACHE STRING "CPU0 (local TrustZone) non-secure image slot size" FORCE)
+set(CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET "@CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET@" CACHE STRING "CPU0 NS image offset within its ROM alias" FORCE)
+set(CPU0_NS_RAM_DATA_SIZE  "@CPU0_NS_RAM_DATA_SIZE@"  CACHE STRING "CPU0 (local TrustZone) non-secure RAM size" FORCE)
+set(CPU0_NS_ROM_ALIAS_BASE "@CPU0_NS_ROM_ALIAS_BASE@" CACHE STRING "MRAM non-secure alias base" FORCE)
+set(CPU0_NS_RAM_ALIAS_BASE "@CPU0_NS_RAM_ALIAS_BASE@" CACHE STRING "SRAM non-secure alias base" FORCE)
+set(CPU0_NS_RAM_OFFSET     "@CPU0_NS_RAM_OFFSET@"     CACHE STRING "CPU0 RAM window offset within the SRAM bank" FORCE)
+set(FLASH_CPU0_C_SIZE      "@FLASH_CPU0_C_SIZE@"      CACHE STRING "CMSE veneer region size in MRAM" FORCE)
+
+set(FLASH_CPU1_NS_PARTITION_SIZE    "@FLASH_CPU1_NS_PARTITION_SIZE@"    CACHE STRING "CPU1 (remote) non-secure image slot size" FORCE)
+set(CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET "@CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET@" CACHE STRING "CPU1 (remote) NS image offset within its ROM alias" FORCE)
+set(CPU1_NS_ROM_ALIAS_BASE "@CPU1_NS_ROM_ALIAS_BASE@" CACHE STRING "CPU1 ROM alias base" FORCE)
+set(CPU1_NS_RAM_DATA_SIZE  "@CPU1_NS_RAM_DATA_SIZE@"  CACHE STRING "CPU1 RAM size" FORCE)
+set(CPU1_NS_RAM_ALIAS_BASE "@CPU1_NS_RAM_ALIAS_BASE@" CACHE STRING "CPU1 RAM alias base" FORCE)
+set(CPU1_NS_RAM_OFFSET     "@CPU1_NS_RAM_OFFSET@"     CACHE STRING "CPU1 RAM window offset within the SRAM bank" FORCE)
+
+set(MCUBOOT_IMAGE_VERSION_CPU1_NS    "@MCUBOOT_IMAGE_VERSION_CPU1_NS@"    CACHE STRING "Version number of the CPU1 NS image" FORCE)
+set(MCUBOOT_SECURITY_COUNTER_CPU1_NS "@MCUBOOT_SECURITY_COUNTER_CPU1_NS@" CACHE STRING "Security counter for the CPU1 NS image" FORCE)
+
+#===================== Transport selection =====================================#
+
+if(RA_NS_INTERFACE_TZ)
+    # CPU0: local non-secure image, veneer calls across the TrustZone boundary.
+    set(CONFIG_TFM_USE_TRUSTZONE       ON  CACHE BOOL "Use TrustZone to transition between NSPE and SPE" FORCE)
+    set(TFM_MULTI_CORE_TOPOLOGY        OFF CACHE BOOL "Build for a dual-cpu architecture" FORCE)
+    set(TFM_PARTITION_NS_AGENT_MAILBOX OFF CACHE BOOL "Enable the Non-Secure Mailbox Agent partition" FORCE)
+    set(TFM_NS_MAILBOX_API             OFF CACHE BOOL "Build NS code for a remote processing element using mailbox APIs" FORCE)
+elseif(RA_NS_INTERFACE_MAILBOX)
+    # CPU1: remote non-secure image, PSA calls forwarded over the mailbox.
+    set(CONFIG_TFM_USE_TRUSTZONE       OFF CACHE BOOL "Use TrustZone to transition between NSPE and SPE" FORCE)
+    set(TFM_MULTI_CORE_TOPOLOGY        ON  CACHE BOOL "Build for a dual-cpu architecture" FORCE)
+    set(TFM_PARTITION_NS_AGENT_MAILBOX ON  CACHE BOOL "Enable the Non-Secure Mailbox Agent partition" FORCE)
+    set(TFM_NS_MAILBOX_API             ON  CACHE BOOL "Build NS code for a remote processing element using mailbox APIs" FORCE)
+
+    # Selects tfm_ns_mailbox_thread.c over tfm_ns_mailbox.c in the NS interface
+    # (tf-m-tests app_broker). Off by default: the RA non-secure test app is
+    # bare-metal, so there is no RTOS to own a mailbox thread.
+    set(TFM_MULTI_CORE_NS_OS_MAILBOX_THREAD OFF CACHE BOOL "Use a dedicated RTOS thread to service the NS mailbox")
+endif()
+
+#===================== Map validation ==========================================#
+
+include(${CMAKE_CURRENT_LIST_DIR}/check_config.cmake)
