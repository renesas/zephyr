+if(DEFINED RA_NS_WINDOW_STARTS)
+    # Window order matches config.cmake: OSPI0 CS0, OSPI0 CS1, OSPI1 CS0,
+    # OSPI1 CS1, SDRAM.
+    list(GET RA_NS_WINDOW_STARTS 0 _ra_win0_start)
+    list(GET RA_NS_WINDOW_ENDS 0 _ra_win0_end)
+    list(GET RA_NS_WINDOW_STARTS 1 _ra_win1_start)
+    list(GET RA_NS_WINDOW_ENDS 1 _ra_win1_end)
+    list(GET RA_NS_WINDOW_STARTS 2 _ra_win2_start)
+    list(GET RA_NS_WINDOW_ENDS 2 _ra_win2_end)
+    list(GET RA_NS_WINDOW_STARTS 3 _ra_win3_start)
+    list(GET RA_NS_WINDOW_ENDS 3 _ra_win3_end)
+    list(GET RA_NS_WINDOW_STARTS 4 _ra_win4_start)
+    list(GET RA_NS_WINDOW_ENDS 4 _ra_win4_end)
+
+    _ra_define_n_window(OSPI0_CS0 "${_ra_win0_start}" "${_ra_win0_end}")
+    _ra_define_n_window(OSPI0_CS1 "${_ra_win1_start}" "${_ra_win1_end}")
+    _ra_define_n_window(OSPI1_CS0 "${_ra_win2_start}" "${_ra_win2_end}")
+    _ra_define_n_window(OSPI1_CS1 "${_ra_win3_start}" "${_ra_win3_end}")
+    _ra_define_n_window(SDRAM "${_ra_win4_start}" "${_ra_win4_end}")
+else()
