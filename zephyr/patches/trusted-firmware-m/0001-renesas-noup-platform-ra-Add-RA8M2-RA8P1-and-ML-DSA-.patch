+#===================== Module stop security attribute settings ================#
+set(RENESAS_RA_MSSAR_NS_SRAM0 ON CACHE BOOL "")
+set(RENESAS_RA_MSSAR_NS_SRAM1 ON CACHE BOOL "")
+set(RENESAS_RA_MSSAR_NS_SRAM2 ON CACHE BOOL "")
+set(RENESAS_RA_MSSAR_NS_SRAM3 ON CACHE BOOL "")
