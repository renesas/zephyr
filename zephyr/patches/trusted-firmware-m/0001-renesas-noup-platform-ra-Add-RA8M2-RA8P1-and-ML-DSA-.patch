+
+static int32_t sci_b_uart_control(sci_b_uart_data_t *data,
+                                   uint32_t control, uint32_t arg)
+{
+    volatile R_SCI_B0_Type *p_reg;
+    uint32_t operation;
+    uint32_t ccr2;
+    int32_t  err;
+    sci_b_uart_config_t cfg;
+
+    if ((data == NULL) || (data->p_reg == NULL)) {
+        return ARM_DRIVER_ERROR;
+    }
+
+    p_reg     = data->p_reg;
+    operation = control & ARM_USART_CONTROL_Msk;
+
+    switch (operation) {
+    case ARM_USART_MODE_ASYNCHRONOUS:
+            /* arg == 0 is only invalid for the baudrate here, not for
+             * ARM_USART_CONTROL_TX/RX below - scoped to this branch only.
+             */
+        if (arg == 0U) {
+            return ARM_USART_ERROR_BAUDRATE;
+        }
+
+        /* Validate data bits (return error for anything unsupported) */
+        switch (control & ARM_USART_DATA_BITS_Msk) {
+        case ARM_USART_DATA_BITS_7:
+        case ARM_USART_DATA_BITS_8:
+            break;
+        case ARM_USART_DATA_BITS_9:
+        default:
+            /* 9-bit is rejected: the TX/RX data path is byte-oriented
+             * (uint8_t buffers, TDR_BY/RDR 8-bit access), so the 9th bit
+             * would silently be lost if accepted here.
+             */
+            return ARM_USART_ERROR_DATA_BITS;
+        }
+
+
+        /* Validate parity (return error for anything unsupported) */
+        switch (control & ARM_USART_PARITY_Msk) {
+        case ARM_USART_PARITY_NONE:
+        case ARM_USART_PARITY_EVEN:
+        case ARM_USART_PARITY_ODD:
+            break;
+        default:
+            return ARM_USART_ERROR_PARITY;
+        }
+
+        /* Validate stop bits - only 1 and 2 stop bits are supported by
+         * this hardware/driver; 1.5 and 0.5 stop bits are rejected.
+         */
+        switch (control & ARM_USART_STOP_BITS_Msk) {
+        case ARM_USART_STOP_BITS_1:
+        case ARM_USART_STOP_BITS_2:
+            break;
+        default:
+            return ARM_USART_ERROR_STOP_BITS;
+        }
+
+        /* Validate flow control - RTS/CTS are not wired up in this
+         * driver yet, so only "none" is accepted.
+         */
+        switch (control & ARM_USART_FLOW_CONTROL_Msk) {
+        case ARM_USART_FLOW_CONTROL_NONE:
+            break;
+        default:
+            return ARM_USART_ERROR_FLOW_CONTROL;
+        }
+
+        /* Fully initialize cfg (avoids reading an uninitialized
+         * `channel` even though no helper currently reads it).
+         */
+        cfg = (sci_b_uart_config_t){
+            .channel  = 0U,   /* Not used while reconfiguring. */
+            .baudrate = arg,
+            .control  = control,
+        };
+
+        /* Compute the new baud rate setting before touching any hardware
+         * state, so a rejected baud rate leaves TE/RE untouched.
+         */
+        err = sci_b_ccr2_compute(cfg.baudrate, &ccr2);
+        if (err != ARM_DRIVER_OK) {
+            return err;
+        }
+
+        /* Make sure no transmission is in progress before clearing TE.
+         * Setting CCR0_b.TE to 0 while CSR_b.TEND is 0 causes the SCI
+         * peripheral to work abnormally (HWM / FSP r_sci_b_uart.c).
+         */
+        while ((p_reg->CSR & R_SCI_B0_CSR_TEND_Msk) == 0U) {
+            /* Wait until the current transmission stops */
+        }
+
+        /* RA8P1 HW manual 39.3.7: disable TE/RE before writing CCRx */
+        p_reg->CCR0 &= ~(R_SCI_B0_CCR0_TE_Msk | R_SCI_B0_CCR0_RE_Msk);
+        while (p_reg->CESR_b.TIST != 0U) {
+            /* Wait for the TX state machine to become inactive */
+        }
+
+        p_reg->CCR3 = sci_b_ccr3_val(&cfg);
+        p_reg->CCR2 = ccr2;
+        p_reg->CCR1 = sci_b_ccr1_val(&cfg);
+
+        /* Re-enable transmitter and receiver */
+        p_reg->CCR0 |= R_SCI_B0_CCR0_RE_Msk | R_SCI_B0_CCR0_TE_Msk;
+        while (p_reg->CESR_b.RIST == 0U) {
+            /* Wait for the receiver state machine to become ready */
+        }
+        return ARM_DRIVER_OK;
+
+    case ARM_USART_CONTROL_TX:
+        /* CMSIS contract: arg is 0=disabled, 1=enabled (exactly two
+         * valid values) - reject anything else instead of silently
+         * treating it as enable or disable.
+         */
+        if (arg > 1U) {
+            return ARM_DRIVER_ERROR_PARAMETER;
+        }
+        if (arg == 1U) {
+            p_reg->CCR0 |= R_SCI_B0_CCR0_TE_Msk;
+        } else {
+            /* Make sure no transmission is in progress before clearing
+             * TE (see note above).
+             */
+            while ((p_reg->CSR & R_SCI_B0_CSR_TEND_Msk) == 0U) {
+                /* Wait until the transmission has actually ended */
+            }
+            p_reg->CCR0 &= ~R_SCI_B0_CCR0_TE_Msk;
+            while (p_reg->CESR_b.TIST != 0U) {
+                /* Wait for the TX hardware state to go idle */
+            }
+        }
+        return ARM_DRIVER_OK;
+
+    case ARM_USART_CONTROL_RX:
+        /* Same {0,1}-only contract as TX above. */
+        if (arg > 1U) {
+            return ARM_DRIVER_ERROR_PARAMETER;
+        }
+        if (arg == 1U) {
+            p_reg->CCR0 |= R_SCI_B0_CCR0_RE_Msk;
+        } else {
+            p_reg->CCR0 &= ~R_SCI_B0_CCR0_RE_Msk;
+        }
+        return ARM_DRIVER_OK;
+
+    default:
+        return ARM_DRIVER_ERROR_UNSUPPORTED;
+    }
+}
+
+/* X-Macro: generate one CMSIS Driver_USART instance per SCI_B channel */
+#define SCI_B_UART_INSTANCE(ch)                                                \
+                                                                               \
+    static sci_b_uart_data_t sci_b_uart##ch##_data = {                         \
+        .p_reg    = NULL,                                                      \
+        .tx_count = 0u,                                                        \
+        .rx_count = 0u,                                                        \
+    };                                                                         \
+                                                                               \
+    static const sci_b_uart_config_t sci_b_uart##ch##_cfg = {                  \
+        .channel   = (uint8_t)(ch),                                            \
+        .baudrate  = DEFAULT_UART_BAUDRATE,                                    \
+        .control   =  ARM_USART_DATA_BITS_8 | ARM_USART_PARITY_NONE            \
+                    | ARM_USART_STOP_BITS_1 | ARM_USART_FLOW_CONTROL_NONE,     \
+    };                                                                         \
+                                                                               \
+    static int32_t ARM_USART##ch##_Initialize(                                 \
+                                ARM_USART_SignalEvent_t cb_event)              \
+    {                                                                          \
+        ARG_UNUSED(cb_event);                                                  \
+        return sci_b_uart_init(&sci_b_uart##ch##_data,                         \
+                               &sci_b_uart##ch##_cfg);                         \
+    }                                                                          \
+                                                                               \
+    static int32_t ARM_USART##ch##_Uninitialize(void)                          \
+    {                                                                          \
+        return sci_b_uart_deinit(&sci_b_uart##ch##_data,                       \
+                                 sci_b_uart##ch##_cfg.channel);                \
+    }                                                                          \
+                                                                               \
+    static int32_t ARM_USART##ch##_PowerControl(ARM_POWER_STATE state)         \
+    {                                                                          \
+        switch (state) {                                                       \
+        case ARM_POWER_FULL:                                                   \
+            return ARM_DRIVER_OK;                                              \
+        case ARM_POWER_OFF:                                                    \
+        case ARM_POWER_LOW:                                                    \
+        default:                                                               \
+            return ARM_DRIVER_ERROR_UNSUPPORTED;                               \
+        }                                                                      \
+    }                                                                          \
+                                                                               \
+    static int32_t ARM_USART##ch##_Send(const void *data, uint32_t num)        \
+    {                                                                          \
+        return sci_b_uart_send(&sci_b_uart##ch##_data,                         \
+                               (const uint8_t *)data, num);                    \
+    }                                                                          \
+                                                                               \
+    static int32_t ARM_USART##ch##_Receive(void *data, uint32_t num)           \
+    {                                                                          \
+        return sci_b_uart_receive(&sci_b_uart##ch##_data,                      \
+                                  (uint8_t *)data, num);                       \
+    }                                                                          \
+                                                                               \
+    static uint32_t ARM_USART##ch##_GetTxCount(void)                           \
+    {                                                                          \
+        return sci_b_uart##ch##_data.tx_count;                                 \
+    }                                                                          \
+                                                                               \
+    static uint32_t ARM_USART##ch##_GetRxCount(void)                           \
+    {                                                                          \
+        return sci_b_uart##ch##_data.rx_count;                                 \
+    }                                                                          \
+                                                                               \
+    static int32_t ARM_USART##ch##_Control(uint32_t control, uint32_t arg)     \
+    {                                                                          \
+        return sci_b_uart_control(&sci_b_uart##ch##_data, control, arg);       \
+    }                                                                          \
+                                                                               \
+    ARM_DRIVER_USART Driver_USART##ch = {                                      \
+        .GetVersion      = ARM_USART_GetVersion,                               \
+        .GetCapabilities = ARM_USART_GetCapabilities,                          \
+        .Initialize      = ARM_USART##ch##_Initialize,                         \
+        .Uninitialize    = ARM_USART##ch##_Uninitialize,                       \
+        .PowerControl    = ARM_USART##ch##_PowerControl,                       \
+        .Send            = ARM_USART##ch##_Send,                               \
+        .Receive         = ARM_USART##ch##_Receive,                            \
+        .Transfer        = ARM_USART_Transfer,                                 \
+        .GetTxCount      = ARM_USART##ch##_GetTxCount,                         \
+        .GetRxCount      = ARM_USART##ch##_GetRxCount,                         \
+        .Control         = ARM_USART##ch##_Control,                            \
+        .GetStatus       = ARM_USART_GetStatus,                                \
+        .SetModemControl = ARM_USART_SetModemControl,                          \
+        .GetModemStatus  = ARM_USART_GetModemStatus                            \
+    }
+
+/* Conditional instantiation */
+#if RTE_USART0
+SCI_B_UART_INSTANCE(0);
+#endif
+
+#if RTE_USART7
+SCI_B_UART_INSTANCE(7);
+#endif
+
+#if RTE_USART8
+SCI_B_UART_INSTANCE(8);
+#endif
+
+#if RTE_USART9
+SCI_B_UART_INSTANCE(9);
+#endif
diff --git a/platform/ext/target/renesas/ra/common/core/Device/Source/startup.c b/platform/ext/target/renesas/ra/common/core/Device/Source/startup.c
new file mode 100644
index 000000000..5bba6b925
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/Device/Source/startup.c
@@ -0,0 +1,152 @@
+/*
+ * Copyright (c) 2022 Arm Limited. All rights reserved.
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * This file is derivative of:
+ *  - CMSIS V6 startup_ARMCM85.c V1.0.0 (Apache-2.0)
+ *    Git SHA: 30a859f44ef8ab4dc8f84b03ed586fd16ccf9d74
+ *  - Renesas FSP v6.4.0 CMSIS device startup (BSD-3-Clause)
+ *    ra/fsp/src/bsp/cmsis/Device/RENESAS/Source/startup.c
+ *
+ * The C runtime is initialized through the CMSIS C environment start
+ * (__PROGRAM_START), using the copy/zero tables from the TF-M linker scripts.
+ * FSP BSP specifics: stack/heap are C objects (g_main_stack / g_heap), the
+ * vector table lives in ".fixed_vectors", stack setup and sealing are done in
+ * SystemInit(), and NMI is handled by the BSP (bsp_group_irq.c).
+ */
+
+#include "tfm_hal_device_header.h"
+
+/*----------------------------------------------------------------------------
+ * External References
+ *----------------------------------------------------------------------------
+ */
+extern uint32_t __INITIAL_SP;
+#if defined(__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U) && defined(CONFIG_TFM_USE_TRUSTZONE)
+extern uint64_t __STACK_SEAL;
+#endif
+extern __NO_RETURN void __PROGRAM_START(void);
+
+/* NMI is handled by the FSP BSP (bsp_group_irq.c). */
+extern void NMI_Handler(void);
+
+/*----------------------------------------------------------------------------
+ * Internal References
+ *----------------------------------------------------------------------------
+ */
+__NO_RETURN void Reset_Handler(void);
+            void Default_Handler(void);
+
+/*----------------------------------------------------------------------------
+ * Exception / Interrupt Handler
+ *----------------------------------------------------------------------------
+ */
+#define DEFAULT_IRQ_HANDLER(handler_name)  \
+void __WEAK handler_name(void); \
+void handler_name(void) \
+{ \
+    Default_Handler(); \
+}
+
+/* Exceptions */
+DEFAULT_IRQ_HANDLER(HardFault_Handler)
+DEFAULT_IRQ_HANDLER(MemManage_Handler)
+DEFAULT_IRQ_HANDLER(BusFault_Handler)
+DEFAULT_IRQ_HANDLER(UsageFault_Handler)
+DEFAULT_IRQ_HANDLER(SecureFault_Handler)
+DEFAULT_IRQ_HANDLER(SVC_Handler)
+DEFAULT_IRQ_HANDLER(DebugMon_Handler)
+DEFAULT_IRQ_HANDLER(PendSV_Handler)
+DEFAULT_IRQ_HANDLER(SysTick_Handler)
+
+/*----------------------------------------------------------------------------
+ * Exception / Interrupt Vector table
+ *----------------------------------------------------------------------------
+ */
+
+#if defined(__GNUC__)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wpedantic"
+#endif
+
+/**
+ * \brief Exception / Interrupt Handler Function Prototype
+ */
+typedef void (*VECTOR_TABLE_Type)(void);
+
+extern const VECTOR_TABLE_Type __VECTOR_TABLE[BSP_CORTEX_VECTOR_TABLE_ENTRIES];
+BSP_DONT_REMOVE const VECTOR_TABLE_Type __VECTOR_TABLE[BSP_CORTEX_VECTOR_TABLE_ENTRIES] BSP_PLACE_IN_SECTION(
+    BSP_SECTION_FIXED_VECTORS) = {
+  (VECTOR_TABLE_Type)(&__INITIAL_SP), /* Initial Stack Pointer */
+  Reset_Handler,                     /*      Reset Handler */
+  NMI_Handler,                       /* -14: NMI Handler */
+  HardFault_Handler,                 /* -13: Hard Fault Handler */
+  MemManage_Handler,                 /* -12: MPU Fault Handler */
+  BusFault_Handler,                  /* -11: Bus Fault Handler */
+  UsageFault_Handler,                /* -10: Usage Fault Handler */
+  SecureFault_Handler,               /*  -9: Secure Fault Handler */
+  0,                                 /*      Reserved */
+  0,                                 /*      Reserved */
+  0,                                 /*      Reserved */
+  SVC_Handler,                       /*  -5: SVCall Handler */
+  DebugMon_Handler,                  /*  -4: Debug Monitor Handler */
+  0,                                 /*      Reserved */
+  PendSV_Handler,                    /*  -2: PendSV Handler */
+  SysTick_Handler,                   /*  -1: SysTick Handler */
+};
+
+#if defined(__GNUC__)
+#pragma GCC diagnostic pop
+#endif
+
+/*----------------------------------------------------------------------------
+ * Reset Handler called on controller reset
+ *----------------------------------------------------------------------------
+ */
+void Reset_Handler(void)
+{
+    /* Stack pointers and stack limits are configured by the FSP BSP in SystemInit */
+#if defined(__ARM_FEATURE_CMSE) && (__ARM_FEATURE_CMSE == 3U)
+#ifdef CONFIG_TFM_USE_TRUSTZONE
+    __TZ_set_STACKSEAL_S((uint32_t *)(&__STACK_SEAL));
+#else
+    /* BL2: a flat project running in the secure state, built with the CMSE
+     * flag only for this file (bl2.cmake), as CMSIS declares the SAU only for
+     * CMSE builds.
+     * With the SAU disabled and ALLNS clear (reset state) every address is
+     * secure, so an access through a non-secure alias (e.g. the flash driver
+     * on a non-secure image slot) would be a secure transaction to a
+     * non-secure region. Setting ALLNS leaves the attribution to the IDAU
+     * (address bit 28 selects the alias), as the FSP BSP does without SAU
+     * regions. Done before SystemInit enables the caches.
+     */
+    SAU->CTRL = SAU_CTRL_ALLNS_Msk;
+    __DSB();
+    __ISB();
+#endif
+#endif
+
+    SystemInit();                             /* CMSIS System Initialization */
+    __PROGRAM_START();                        /* Enter PreMain (C library entry point) */
+}
+
+/*----------------------------------------------------------------------------
+ * Default Handler for Exceptions / Interrupts
+ *----------------------------------------------------------------------------
+ */
+void Default_Handler(void)
+{
+    /* An error has occurred. The user will need to investigate the cause. Common problems are stack corruption
+     * or use of an invalid pointer. Use the Fault Status window in e2 studio or manually check the fault status
+     * registers for more information.
+     */
+    BSP_CFG_HANDLE_UNRECOVERABLE_ERROR(0);
+
+    while (1) {
+        /* Infinite Loop. */
+    }
+}
diff --git a/platform/ext/target/renesas/ra/common/core/Native_Driver/RTE_PinCfg.h b/platform/ext/target/renesas/ra/common/core/Native_Driver/RTE_PinCfg.h
new file mode 100644
index 000000000..ddc1be218
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/Native_Driver/RTE_PinCfg.h
@@ -0,0 +1,53 @@
+/*
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef RTE_PIN_CFG_H_
+#define RTE_PIN_CFG_H_
+
+#include "RTE_Stdio.h"
+#include "bsp_api.h"
+#include "r_ioport.h"
+
+/*
+ * Helpers to construct FSP ioport_pin_cfg_t entries from the raw
+ * port/pin numbers defined in RTE_Device.h.
+ *
+ *   BSP_IO_PORT_xx_PIN_yy  = (port << 8) | pin      e.g. 0x0602 -> port 6, pin 2
+ */
+#define RTE_PORT_PIN(port, pin)  (((uint32_t)(port) << 8) | (uint32_t)(pin))
+
+/* Convert raw PSEL number to FSP peripheral value */
+#define RTE_PSEL(val)  ((uint32_t)(val) << IOPORT_PRV_PFS_PSEL_OFFSET)
+
+/* Generic pin entry - psel is the final FSP IOPORT_PERIPHERAL_* value */
+#define RTE_PIN_CFG(port, _pin, psel) \
+    {.pin = RTE_PORT_PIN(port, _pin), \
+     .pin_cfg = ((uint32_t) IOPORT_CFG_PERIPHERAL_PIN | (uint32_t)(psel))},
+
+/* UART PSEL - derived from FSP IOPORT_PERIPHERAL_SCI* macros */
+#define RTE_UART_PSEL(ch) \
+    ((ch) & 1) ? IOPORT_PERIPHERAL_SCI1_3_5_7_9 : IOPORT_PERIPHERAL_SCI0_2_4_6_8
+
+/* TX + RX pair for one UART channel (TXD first, then RXD) */
+#define RTE_PINS_UART(ch) \
+    RTE_PIN_CFG(RTE_USART##ch##_TXD_PORT, RTE_USART##ch##_TXD_PIN, RTE_UART_PSEL(ch)) \
+    RTE_PIN_CFG(RTE_USART##ch##_RXD_PORT, RTE_USART##ch##_RXD_PIN, RTE_UART_PSEL(ch))
+
+/* Extra level so the channel macro expands before RTE_PINS_UART pastes it */
+#define RTE_PINS_UART_CH(ch)  RTE_PINS_UART(ch)
+
+/* TX + RX pin entries of the stdio console UART */
+#define RTE_PINS_STDIO        RTE_PINS_UART_CH(RTE_STDIO_USART)
+
+/*
+ * The S console must not be NS-accessible. RENESAS_RA_PSAR_NS_SCIx come from
+ * s_ns_peripheral.cmake (1 = NS-accessible, 0 = S-only) and are only defined
+ * for the FSP sources.
+ */
+#define RTE_PSAR_NS_SCI_(ch)  RENESAS_RA_PSAR_NS_SCI##ch
+#define RTE_PSAR_NS_SCI(ch)   RTE_PSAR_NS_SCI_(ch)
+
+#endif /* RTE_PIN_CFG_H_ */
