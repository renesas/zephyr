+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "platform_multicore.h"
+#include "tfm_hal_mailbox.h"
+
+static void ra_mailbox_publish_empty(struct secure_mailbox_queue_t *s_queue)
+{
+    s_queue->ns_status = NULL;
+    s_queue->ns_slot_count = 0U;
+    s_queue->ns_slots = NULL;
+
+    __DMB();
+}
+
+int32_t tfm_mailbox_hal_init(struct secure_mailbox_queue_t *s_queue)
+{
+    struct mailbox_init_t init_snapshot;
+    fsp_err_t err;
+
+    if (s_queue == NULL) {
+        return MAILBOX_INVAL_PARAMS;
+    }
+
+    ra_mailbox_publish_empty(s_queue);
+
+    /* Request the mailbox descriptor from the remote NSPE. */
+    err = platform_mailbox_generate_event(IPC_GENERATE_EVENT_IRQ0);
+    if (err != FSP_SUCCESS) {
+        goto init_error;
+    }
+
+    do {
+        /* Wait for the remote NSPE to provide the mailbox descriptor. */
+        err = platform_mailbox_buffer_get(&init_snapshot);
+    } while (err == FSP_ERR_NOT_FOUND);
+
+    /* Any other error means the descriptor was consumed but rejected. */
+    if (err != FSP_SUCCESS) {
+        goto init_error;
+    }
+
+    /*
+     * platform_mailbox_buffer_get() has validated the descriptor,
+     * status object, slot array, slot count, and size calculation.
+     */
+    s_queue->ns_status = init_snapshot.status;
+    s_queue->ns_slot_count = init_snapshot.slot_count;
+    s_queue->ns_slots = init_snapshot.slots;
+
+    __DMB();
+
+    /* Notify the remote NSPE that mailbox initialization is complete. */
+    err = platform_mailbox_generate_event(IPC_GENERATE_EVENT_IRQ0);
+    if (err != FSP_SUCCESS) {
+        goto init_error;
+    }
+
+    return MAILBOX_SUCCESS;
+
+init_error:
+    ra_mailbox_publish_empty(s_queue);
+
+    return MAILBOX_INIT_ERROR;
+}
+
+int32_t tfm_mailbox_hal_notify_peer(void)
+{
+    if (platform_mailbox_generate_event(IPC_GENERATE_EVENT_IRQ0) != FSP_SUCCESS) {
+        return MAILBOX_CHAN_BUSY;
+    }
+
+    return MAILBOX_SUCCESS;
+}
+
+uint32_t tfm_mailbox_hal_enter_critical(void)
+{
+    while (platform_mailbox_semaphore_take() != FSP_SUCCESS) {
+    }
+
+    return 0;
+}
+
+void tfm_mailbox_hal_exit_critical(uint32_t key)
+{
+    (void) key;
+    (void) platform_mailbox_semaphore_give();
+}
diff --git a/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_multi_core.c b/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_multi_core.c
new file mode 100644
index 000000000..ede5ea9f7
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_multi_core.c
@@ -0,0 +1,65 @@
+/*
+ * Copyright (c) 2021-2024, Arm Limited. All rights reserved.
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/* SPE-side secondary-core boot and readiness synchronization. */
+
+#include <stdint.h>
+
+#include "utilities.h"
+#include "platform_multicore.h"
+#include "tfm_hal_multi_core.h"
+#include "tfm_peripherals_def.h"
+
+/* IPC event status value indicating that IRQ0 is pending */
+#define RA_PLATFORM_MAILBOX_EVENT_IRQ0_PENDING    ((uint32_t) IPC_EVENT_IRQ0)
+
+/* Each separately built image owns one common IPC control block. */
+extern ipc_instance_ctrl_t ra_ipc_ctrl;
+
+/* Open IPC, register the FSP ISR context, and start the remote core. */
+void tfm_hal_boot_ns_cpu(uintptr_t start_addr)
+{
+    fsp_err_t err;
+
+    (void) start_addr;
+
+    err = platform_mailbox_open();
+    if (err != FSP_SUCCESS) {
+        tfm_core_panic();
+    }
+
+    R_FSP_IsrContextSet(MAILBOX_IRQ, &ra_ipc_ctrl);
+    R_BSP_SecondaryCoreStart();
+}
+
+/* Notify the remote NSPE that the SPE is ready and wait for its reply. */
+void tfm_hal_wait_for_ns_cpu_ready(void)
+{
+    ipc_event_t event;
+    uint32_t event_status = 0U;
+    fsp_err_t err;
+
+    err = platform_mailbox_generate_event(IPC_GENERATE_EVENT_IRQ0);
+    if (err != FSP_SUCCESS) {
+        goto fatal_error;
+    }
+
+    do {
+        err = platform_mailbox_get_event(&event);
+        if (err == FSP_SUCCESS) {
+            event_status = (uint32_t) event & (uint32_t) IPC_EVENT_IRQ0;
+        }
+    } while (event_status != RA_PLATFORM_MAILBOX_EVENT_IRQ0_PENDING);
+
+    __DMB();
+
+    return;
+
+fatal_error:
+    (void) platform_mailbox_close();
+    tfm_core_panic();
+}
diff --git a/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_platform.c b/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_platform.c
new file mode 100644
index 000000000..9bb24679f
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_platform.c
@@ -0,0 +1,98 @@
+/*
+ * Copyright (c) 2021-2024, Arm Limited. All rights reserved.
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ */
+
+#include "common_target_cfg.h"
+#include "tfm_hal_device_header.h"
+#include "tfm_hal_platform.h"
+#include "tfm_plat_defs.h"
+#include "uart_stdout.h"
+
+#define ICU_BITS_PER_WORD    (32U)
+
+#if BSP_MULTICORE_PROJECT
+
+static void platform_icu_init(void)
+{
+    uint32_t intselr_count = sizeof(R_ICU->INTSELR) / sizeof(R_ICU->INTSELR[0]);
+    uint32_t volatile *p_icusarg = &R_CPSCU->ICUSARJ;
+
+    /* At boot time, the CM85 SPE will:
+     *  - Set all interrupts route to CM33 core
+     *  - Set all CM33 NSPE event link attribute to non-secure
+     *  - Set all CM85 SPE's event link attribute to secure, and other to NS attribute
+     * If the CM85 NSPE need to use an interrupt line, the NPSE firmware need to:
+     *  - Set that interrupt request to CM85 core via interrupt routing service
+     */
+
+    /* Route all interrupt request to CM33 */
+    for (uint32_t i = 0U; i < intselr_count; i++) {
+        R_ICU->INTSELR[i] = UINT32_MAX;
+    }
+
+    R_BSP_RegisterProtectDisable(BSP_REG_PROTECT_SAR);
+
+    /* Set the CM33's event link attribute to non-secure */
+    for (uint32_t i = 0U; i < BSP_ICU_VECTOR_MAX_ENTRIES / ICU_BITS_PER_WORD; i++) {
+        p_icusarg[i]  = UINT32_MAX;
+    }
+
+    R_BSP_RegisterProtectEnable(BSP_REG_PROTECT_SAR);
+}
+#endif
+
+enum tfm_hal_status_t tfm_hal_platform_init(void)
+{
+#ifndef TFM_MULTI_CORE_TOPOLOGY
+    R_BSP_RegisterProtectDisable(BSP_REG_PROTECT_SAR);
+    /* Mark CPU1 non-secure so the NSPE can reach its CPU_CTRL registers */
+    R_CPSCU->CPUSAR_b.CPUSA1 = 1U;
+    R_BSP_RegisterProtectEnable(BSP_REG_PROTECT_SAR);
+#endif
+
+#if BSP_MULTICORE_PROJECT
+    platform_icu_init();
+#endif
+
+    __enable_irq();
+    stdio_init();
+
+    return TFM_HAL_SUCCESS;
+}
+
+/*
+ * PPC (Peripheral Protection Controller) functions.
+ * These functions are provided as stubs since peripheral security is configured
+ * by the FSP during early boot.
+ *
+ * TODO: Provide PPC support when enabling higher isolation levels.
+ * Reference: tfm_hal_isolation_v8m.c implementation.
+ */
+
+void ppc_configure_to_secure(ppc_bank_t bank, uint32_t pos)
+{
+    (void)bank;
+    (void)pos;
+}
+
+void ppc_configure_to_non_secure(ppc_bank_t bank, uint32_t pos)
+{
+    (void)bank;
+    (void)pos;
+}
+
+void ppc_en_secure_unpriv(ppc_bank_t bank, uint32_t pos)
+{
+    (void)bank;
+    (void)pos;
+}
+
+void ppc_clr_secure_unpriv(ppc_bank_t bank, uint32_t pos)
+{
+    (void)bank;
+    (void)pos;
+}
diff --git a/platform/ext/target/renesas/ra/common/core/services/src/tfm_interrupts.c b/platform/ext/target/renesas/ra/common/core/services/src/tfm_interrupts.c
new file mode 100644
index 000000000..f37445dba
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/services/src/tfm_interrupts.c
@@ -0,0 +1,121 @@
+/*
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * Renesas RA8 SPE mailbox interrupt integration.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "r_ipc.h"
+#include "bsp_api.h"
+#include "interrupt.h"
+#include "load/interrupt_defs.h"
+#include "tfm_multi_core.h"
+#include "tfm_peripherals_def.h"
+#ifdef TFM_PARTITION_NS_AGENT_MAILBOX
+#include "platform_multicore.h"
+#endif /* TFM_PARTITION_NS_AGENT_MAILBOX */
+
+static struct irq_t timer0_irq = {0};
+
+#ifdef TFM_PARTITION_NS_AGENT_MAILBOX
+static struct irq_t mailbox_irq = {0};
+#endif /* TFM_PARTITION_NS_AGENT_MAILBOX */
+
+/*
+ * The ICU secure interrupt initialization for Renesas RA MCUs:
+ *  - Set the IRQ as secure in the ICU security attribution register (ICUSARG).
+ *  - Route the ELC event to the IRQ vector (IELSR) and select it (INTSELR).
+ */
+static void icu_secure_irq_setup(IRQn_Type irq, uint32_t elc_event)
+{
+    const uint32_t index = (uint32_t) irq / 32U;
+    const uint32_t bit   = (uint32_t) irq % 32U;
+    uint32_t volatile *p_icusarg = &R_CPSCU->ICUSARG;
+
+    R_BSP_RegisterProtectDisable(BSP_REG_PROTECT_SAR);
+    p_icusarg[index] &= ~(1U << bit);
+    R_BSP_RegisterProtectEnable(BSP_REG_PROTECT_SAR);
+    R_ICU->IELSR[irq] = elc_event;
+    R_ICU->INTSELR[elc_event >> 5U] &= ~(1U << (elc_event % 32U));
+}
+
+enum tfm_hal_status_t tfm_timer0_irq_init(void *p_pt, const struct irq_load_info_t *p_ildi)
+{
+    timer0_irq.p_pt   = p_pt;
+    timer0_irq.p_ildi = p_ildi;
+
+    icu_secure_irq_setup(TFM_TIMER0_IRQ, ELC_EVENT_AGT0_INT);
+
+    NVIC_ClearTargetState(TFM_TIMER0_IRQ);
+    NVIC_SetPriority(TFM_TIMER0_IRQ, DEFAULT_IRQ_PRIORITY);
+    NVIC_DisableIRQ(TFM_TIMER0_IRQ);
+
+    return TFM_HAL_SUCCESS;
+}
+
+IRQ_HANDLER(TFM_TIMER0_IRQ)
+{
+    spm_handle_interrupt(timer0_irq.p_pt, timer0_irq.p_ildi);
+}
+
+#ifdef TFM_PARTITION_NS_AGENT_MAILBOX
+
+/* Initialize the Secure runtime mailbox interrupt. */
+enum tfm_hal_status_t mailbox_irq_init(void *p_pt,
+                                       const struct irq_load_info_t *p_ildi)
+{
+    if ((p_pt == NULL) ||
+        (p_ildi == NULL) ||
+        (p_ildi->source != (uint32_t) MAILBOX_IRQ)) {
+        return TFM_HAL_ERROR_INVALID_INPUT;
+    }
+
+    /*
+     * Associate the remote NSPE client ID range with the mailbox interrupt
+     * source so that requests are routed to the correct NS Agent.
+     */
+    if (tfm_multi_core_register_client_id_range(
+            CLIENT_ID_OWNER_MAGIC,
+            p_ildi->source) != 0) {
+        return TFM_HAL_ERROR_INVALID_INPUT;
+    }
+
+    mailbox_irq.p_pt = p_pt;
+    mailbox_irq.p_ildi = p_ildi;
+    icu_secure_irq_setup(MAILBOX_IRQ, ELC_EVENT_IPC_IRQ0);
+
+    NVIC_ClearTargetState(MAILBOX_IRQ);
+    NVIC_SetPriority(MAILBOX_IRQ, DEFAULT_IRQ_PRIORITY);
+    NVIC_DisableIRQ(MAILBOX_IRQ);
+
+    return TFM_HAL_SUCCESS;
+}
+
+/* Handle a runtime mailbox notification through the FSP IPC ISR. */
+IRQ_HANDLER(MAILBOX_IRQ)
+{
+    /*
+     * The patched FSP ipc_isr() must tolerate a NULL callback. It clears
+     * the ICU request and acknowledges the received IPC event.
+     */
+    ipc_isr();
+
+    /* The FIFO is only used during init; keep a stale word from holding RDY. */
+    platform_mailbox_fifo_flush();
+
+    if ((mailbox_irq.p_pt == NULL) ||
+        (mailbox_irq.p_ildi == NULL)) {
+        tfm_core_panic();
+    }
+
+    spm_handle_interrupt(mailbox_irq.p_pt,
+                         mailbox_irq.p_ildi);
+}
+
+#endif /* TFM_PARTITION_NS_AGENT_MAILBOX */
diff --git a/platform/ext/target/renesas/ra/common/core/services/src/tfm_ioctl_ns_api.c b/platform/ext/target/renesas/ra/common/core/services/src/tfm_ioctl_ns_api.c
