--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/services/src/plat_test.c
@@ -0,0 +1,68 @@
+/*
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ */
+
+#include <stdbool.h>
+
+#include "tfm_plat_test.h"
+#include "tfm_peripherals_def.h"
+#include "bsp_api.h"
+#include "bsp_clock_cfg.h"
+#include "r_agt.h"
+
+extern void agt_int_isr(void);
+
+#define PCLKB_HZ                        (BSP_CFG_CLOCK_CPUCLK_SRC_FREQ / (1U << BSP_CFG_PCLKB_DIV))
+#define TIMER_FREQ_HZ                   (1000U)   /* 1 ms tick for this plat test */
+#define TIMER_PERIOD_COUNTS             (PCLKB_HZ / TIMER_FREQ_HZ)
+
+static agt_instance_ctrl_t agt0_ctrl;
+
+static const agt_extended_cfg_t agt0_extend = {
+    .count_source            = AGT_CLOCK_PCLKB,
+    .agto                    = AGT_PIN_CFG_DISABLED,
+    .agtoab_settings_b.agtoa = AGT_PIN_CFG_DISABLED,
+    .agtoab_settings_b.agtob = AGT_PIN_CFG_DISABLED,
+    .measurement_mode        = AGT_MEASURE_DISABLED,
+    .agtio_filter            = AGT_AGTIO_FILTER_NONE,
+    .enable_pin              = AGT_ENABLE_PIN_NOT_USED,
+    .trigger_edge            = AGT_TRIGGER_EDGE_RISING,
+    .counter_bit_width       = AGT_COUNTER_BIT_WIDTH_16,
+};
+
+static timer_cfg_t agt0_cfg = {
+    .mode          = TIMER_MODE_PERIODIC,
+    .source_div    = TIMER_SOURCE_DIV_1,
+    .period_counts = TIMER_PERIOD_COUNTS,
+    .channel       = 0U,
+    .cycle_end_ipl = DEFAULT_IRQ_PRIORITY,
+    .cycle_end_irq = FSP_INVALID_VECTOR,   /* Let the TF-M enable this IRQ */
+    .p_extend      = &agt0_extend,
+};
+
+void tfm_plat_test_secure_timer_start(void)
+{
+    if (!agt0_ctrl.open) {
+        R_AGT_Open(&agt0_ctrl, &agt0_cfg);
+        /* Set the interrupt context for FSP handlers */
+        R_FSP_IsrContextSet(TFM_TIMER0_IRQ, &agt0_ctrl);
+    }
+
+    R_AGT_Start(&agt0_ctrl);
+}
+
+void tfm_plat_test_secure_timer_clear_intr(void)
+{
+    /* This function is a FLIH (first-level interrupt handler).
+     * Clear the ICU IELSR.IR bit and all AGT status flags.
+     */
+    agt_int_isr();
+}
+
+void tfm_plat_test_secure_timer_stop(void)
+{
+    R_AGT_Stop(&agt0_ctrl);
+}
diff --git a/platform/ext/target/renesas/ra/common/core/services/src/platform_multicore.c b/platform/ext/target/renesas/ra/common/core/services/src/platform_multicore.c
new file mode 100644
index 000000000..975adf4ea
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/services/src/platform_multicore.c
@@ -0,0 +1,256 @@
+/*
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/* Common Renesas IPC operations shared by SPE and remote NSPE builds. */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "tfm_mailbox.h"
+#include "platform_multicore.h"
+
+#ifndef DOMAIN_NS
+#include "region_defs.h"
+#include "tfm_hal_mailbox.h"
+
+#if !defined(CPU1_NS_DATA_START) || !defined(CPU1_NS_RAM_DATA_SIZE)
+#error "CPU1_NS_DATA_START and CPU1_NS_RAM_DATA_SIZE must be defined"
+#endif
+#endif
+
+/* IPC channel used for the mailbox */
+#define RA_MAILBOX_IPC_CHANNEL            UINT32_C(0)
+
+/* IPC hardware semaphore guarding the NSPE mailbox  */
+#define RA_MAILBOX_IPC_SEMAPHORE          (8U)
+
+ipc_instance_ctrl_t ra_ipc_ctrl = {0};
+
+static const ipc_cfg_t ra_ipc_cfg = {
+    .channel = RA_MAILBOX_IPC_CHANNEL,
+    .irq = FSP_INVALID_VECTOR,
+    .ipl = BSP_IRQ_DISABLED,
+    .p_callback = NULL,
+    .p_context = NULL,
+};
+
+#ifndef DOMAIN_NS
+/* Check that an object lies completely in the remote NSPE data region. */
+static bool platform_mailbox_ns_range_valid(uintptr_t address, size_t size)
+{
+    const uintptr_t start = (uintptr_t) CPU1_NS_DATA_START;
+    const uintptr_t end = start + (uintptr_t) CPU1_NS_RAM_DATA_SIZE;
+
+    if ((address < start) || (address >= end)) {
+        return false;
+    }
+
+    return size <= (end - address);
+}
+#endif
+
+/* IPC STA bits that report events; RDY and FULL are FIFO state, not events. */
+#define RA_MAILBOX_IPC_EVENT_MASK (~(R_IPC_IPC_CH_STA_RDY_Msk | R_IPC_IPC_CH_STA_FULL_Msk))
+
+/* Return the mailbox IPC semaphore register. */
+static volatile uint32_t *platform_mailbox_semaphore_reg(void)
+{
+#ifdef DOMAIN_NS
+    return &(R_IPC->IPCSEM[RA_MAILBOX_IPC_SEMAPHORE]);
+#else
+    return (volatile uint32_t *)
+        ((uintptr_t) &(R_IPC->IPCSEM[RA_MAILBOX_IPC_SEMAPHORE]) | BSP_FEATURE_TZ_NS_OFFSET);
+#endif
+}
+
+/* Open the IPC hardware instance if it is not already open. */
+fsp_err_t platform_mailbox_open(void)
+{
+    fsp_err_t err;
+
+    if (ra_ipc_ctrl.open != 0) {
+        return FSP_SUCCESS;
+    }
+
+    err = R_IPC_Open((ipc_ctrl_t *) &ra_ipc_ctrl, &ra_ipc_cfg);
+    if (err != FSP_SUCCESS) {
+        return err;
+    }
+
+    return FSP_SUCCESS;
+}
+
+/* Read and validate the remote mailbox descriptor without polling. */
+fsp_err_t platform_mailbox_buffer_get(struct mailbox_init_t *p_mailbox_init)
+{
+#ifndef DOMAIN_NS
+    uint32_t raw_address;
+    uintptr_t ns_init_addr;
+
+    if (p_mailbox_init == NULL) {
+        return FSP_ERR_INVALID_ARGUMENT;
+    }
+
+    if (ra_ipc_ctrl.open == 0) {
+        return FSP_ERR_NOT_OPEN;
+    }
+
+    if (ra_ipc_ctrl.p_recv_reg->STA_b.RDY == 0U) {
+        return FSP_ERR_NOT_FOUND;
+    }
+
+    /* Reading RXD consumes one word from the receive FIFO. */
+    raw_address = ra_ipc_ctrl.p_recv_reg->RXD;
+    ns_init_addr = (uintptr_t) raw_address;
+
+    if (!platform_mailbox_ns_range_valid(ns_init_addr,
+                                         sizeof(*p_mailbox_init))) {
+        return FSP_ERR_INVALID_ADDRESS;
+    }
+
+    (void) memcpy(p_mailbox_init,
+                  (const void *) ns_init_addr,
+                  sizeof(*p_mailbox_init));
+
+    __DMB();
+
+    if ((p_mailbox_init->status == NULL) ||
+        (p_mailbox_init->slots == NULL) ||
+        (p_mailbox_init->slot_count == 0U) ||
+        (p_mailbox_init->slot_count > NUM_MAILBOX_QUEUE_SLOT) ||
+        (p_mailbox_init->slot_count >
+         (SIZE_MAX / sizeof(struct mailbox_slot_t)))) {
+        return FSP_ERR_INVALID_ARGUMENT;
+    }
+
+    if (!platform_mailbox_ns_range_valid((uintptr_t) p_mailbox_init->status,
+                                         sizeof(struct mailbox_status_t))) {
+        return FSP_ERR_INVALID_ADDRESS;
+    }
+
+    if (!platform_mailbox_ns_range_valid((uintptr_t) p_mailbox_init->slots,
+                                         sizeof(struct mailbox_slot_t) *
+                                         p_mailbox_init->slot_count)) {
+        return FSP_ERR_INVALID_ADDRESS;
+    }
+
+    return FSP_SUCCESS;
+#else
+    (void) p_mailbox_init;
+
+    return FSP_ERR_UNSUPPORTED;
+#endif
+}
+
+/* Send the mailbox descriptor address without polling. */
+fsp_err_t platform_mailbox_buffer_set(const struct mailbox_init_t *p_mailbox_init)
+{
+#ifdef DOMAIN_NS
+    if (p_mailbox_init == NULL) {
+        return FSP_ERR_INVALID_ARGUMENT;
+    }
+
+    if (ra_ipc_ctrl.open == 0) {
+        return FSP_ERR_NOT_OPEN;
+    }
+
+    __DMB();
+
+    return R_IPC_MessageSend((ipc_ctrl_t *) &ra_ipc_ctrl,
+                             (uint32_t)(uintptr_t) p_mailbox_init);
+#else
+    (void)p_mailbox_init;
+
+    return FSP_ERR_UNSUPPORTED;
+#endif
+}
+
+/* Read and acknowledge the IRQ0 event status once without polling. */
+fsp_err_t platform_mailbox_get_event(ipc_event_t *p_event)
+{
+    if (p_event == NULL) {
+        return FSP_ERR_INVALID_ARGUMENT;
+    }
+
+    if (ra_ipc_ctrl.open == 0) {
+        return FSP_ERR_NOT_OPEN;
+    }
+
+    /*
+     * Only event bits are acknowledged. CLR bit 16 is the FIFO reset (RST),
+     * which would alias STA.RDY and discard a pending message word.
+     */
+    *p_event = (ipc_event_t) (ra_ipc_ctrl.p_recv_reg->STA & RA_MAILBOX_IPC_EVENT_MASK);
+    ra_ipc_ctrl.p_recv_reg->CLR = (uint32_t) *p_event;
+    __DMB();
+
+    return FSP_SUCCESS;
+}
+
+/* Discard any unread word in the receive FIFO so RDY cannot keep the IRQ set. */
+void platform_mailbox_fifo_flush(void)
+{
+    if (ra_ipc_ctrl.open == 0) {
+        return;
+    }
+
+    if (ra_ipc_ctrl.p_recv_reg->STA_b.RDY != 0U) {
+        ra_ipc_ctrl.p_recv_reg->CLR = R_IPC_IPC_CH_CLR_RST_Msk;
+        __DMB();
+    }
+}
+
+/* Generate an IPC software event for the peer core. */
+fsp_err_t platform_mailbox_generate_event(ipc_generate_event_t event)
+{
+    if ((uint32_t) event == 0U) {
+        return FSP_ERR_INVALID_ARGUMENT;
+    }
+
+    if (ra_ipc_ctrl.open == 0) {
+        return FSP_ERR_NOT_OPEN;
+    }
+
+    __DMB();
+
+    return R_IPC_EventGenerate((ipc_ctrl_t *) &ra_ipc_ctrl,event);
+}
+
+/* Close the IPC hardware instance if it is open. */
+fsp_err_t platform_mailbox_close(void)
+{
+    if (ra_ipc_ctrl.open == 0) {
+        return FSP_SUCCESS;
+    }
+
+    return R_IPC_Close((ipc_ctrl_t *) &ra_ipc_ctrl);
+}
+
+/* Attempt once to take the mailbox IPC semaphore without polling. */
+fsp_err_t platform_mailbox_semaphore_take(void)
+{
+    volatile uint32_t * sem_ptr = platform_mailbox_semaphore_reg();
+
+    /* Reading 0 means the semaphore was free and is now owned by this core. */
+    if (*sem_ptr != 0U) {
+        return FSP_ERR_IN_USE;
+    }
+
+    return FSP_SUCCESS;
+}
+
+/* Give the mailbox IPC semaphore back. */
+fsp_err_t platform_mailbox_semaphore_give(void)
+{
+    volatile uint32_t * sem_ptr = platform_mailbox_semaphore_reg();
+
+    /* Writing 1 to releases the semaphore. */
+    *sem_ptr = 1U;
+
+    return FSP_SUCCESS;
+}
diff --git a/platform/ext/target/renesas/ra/common/core/services/src/platform_ns_mailbox.c b/platform/ext/target/renesas/ra/common/core/services/src/platform_ns_mailbox.c
new file mode 100644
index 000000000..e4d0f07e0
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/services/src/platform_ns_mailbox.c
@@ -0,0 +1,191 @@
+/*
+ * Copyright (c) 2021-2024, Arm Limited. All rights reserved.
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/* Remote NSPE mailbox initialization and runtime notification HAL. */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "tfm_ns_mailbox.h"
+#include "platform_multicore.h"
+#include "tfm_multi_core_api.h"
+#include "vector_data.h"
+
+/* IPC event status values for the remote NSPE mailbox */
+#define RA_PLATFORM_MAILBOX_EVENT_IRQ0_NONE       UINT32_C(0)
+#define RA_PLATFORM_MAILBOX_EVENT_IRQ0_PENDING    ((uint32_t)IPC_EVENT_IRQ0)
+
+/* Open IPC, wait for SPE readiness, and acknowledge remote readiness. */
+int32_t tfm_platform_ns_wait_for_s_cpu_ready(void)
+{
+    ipc_event_t event;
+    fsp_err_t err;
+    uint32_t event_status = RA_PLATFORM_MAILBOX_EVENT_IRQ0_NONE;
+
+    err = platform_mailbox_open();
+    if (err != FSP_SUCCESS) {
+        goto error;
+    }
+
+    do {
+        err = platform_mailbox_get_event(&event);
+        if (err == FSP_SUCCESS) {
+            event_status = (uint32_t) event &
+                           (uint32_t) IPC_EVENT_IRQ0;
+        }
+    } while (event_status != RA_PLATFORM_MAILBOX_EVENT_IRQ0_PENDING);
+
+    __DSB();
+
+    err = platform_mailbox_generate_event(IPC_GENERATE_EVENT_IRQ0);
+    if (err != FSP_SUCCESS) {
+        goto error;
+    }
+
+    return MAILBOX_SUCCESS;
+error:
+    (void) platform_mailbox_close();
+    return MAILBOX_INIT_ERROR;
+}
+
+/* SPE reply notification: wake the NS threads waiting for a mailbox reply. */
+IRQ_HANDLER(RA_NS_MAILBOX_IRQ)
+{
+    ipc_event_t event = (ipc_event_t) 0;
+
+    R_BSP_IrqStatusClear(RA_NS_MAILBOX_IRQ);
+
+    if (platform_mailbox_get_event(&event) != FSP_SUCCESS) {
+        return;
+    }
+
+    /* The FIFO is only used during init; keep a stale word from holding RDY. */
+    platform_mailbox_fifo_flush();
+
+    if (((uint32_t) event & (uint32_t) IPC_EVENT_IRQ0) != 0U) {
+        (void) tfm_ns_mailbox_wake_reply_owner_isr();
+    }
+}
+
+/* Exchange the mailbox descriptor with the SPE. */
+int32_t tfm_ns_mailbox_hal_init(struct ns_mailbox_queue_t *queue)
+{
+    struct mailbox_init_t ns_init MAILBOX_ALIGN;
+    ipc_event_t event;
+    fsp_err_t err;
+    uint32_t event_status = RA_PLATFORM_MAILBOX_EVENT_IRQ0_NONE;
+
+    if (queue == NULL) {
+        return MAILBOX_INVAL_PARAMS;
+    }
+
+    ns_init.status = &queue->status;
+    ns_init.slot_count = NUM_MAILBOX_QUEUE_SLOT;
+    ns_init.slots = &queue->slots[0];
+
+    /*
+     * Wait for the SPE to request the remote NSPE mailbox descriptor.
+     * The SPE generates IPC IRQ0 after it is ready to receive the
+     * descriptor address.
+     */
+    do {
+        err = platform_mailbox_get_event(&event);
+        if (err == FSP_SUCCESS) {
+            event_status = (uint32_t) event &
+                           (uint32_t) IPC_EVENT_IRQ0;
+        }
+    } while (event_status != RA_PLATFORM_MAILBOX_EVENT_IRQ0_PENDING);
+
+    __DSB();
+
+    /*
+     * Send the address of the remote NSPE mailbox descriptor to the SPE.
+     */
+    err = platform_mailbox_buffer_set(&ns_init);
+    if (err != FSP_SUCCESS) {
+        goto init_error;
+    }
+
+    /*
+     * Wait for the SPE to acknowledge that it has received, validated,
+     * and accepted the remote NSPE mailbox descriptor.
+     */
+    do {
+        err = platform_mailbox_get_event(&event);
+        if (err == FSP_SUCCESS) {
+            event_status = (uint32_t) event &
+                           (uint32_t) IPC_EVENT_IRQ0;
+        }
+    } while (event_status != RA_PLATFORM_MAILBOX_EVENT_IRQ0_PENDING);
+
+    __DSB();
+
+    /*
+     * Handshake done: from now on IRQ0 from the SPE means a reply is ready.
+     * Use the lowest priority so RTOS "from ISR" calls are always legal.
+     */
+    platform_mailbox_fifo_flush();
+    R_BSP_IrqStatusClear(RA_NS_MAILBOX_IRQ);
+    NVIC_ClearPendingIRQ(RA_NS_MAILBOX_IRQ);
+    NVIC_SetPriority(RA_NS_MAILBOX_IRQ, (1U << __NVIC_PRIO_BITS) - 1U);
+    NVIC_EnableIRQ(RA_NS_MAILBOX_IRQ);
+
+    return MAILBOX_SUCCESS;
+
+init_error:
+    (void) platform_mailbox_close();
+
+    return MAILBOX_INIT_ERROR;
+}
+
+/* Notify the SPE that a runtime mailbox request is pending. */
+int32_t tfm_ns_mailbox_hal_notify_peer(void)
+{
+    fsp_err_t err;
+
+    err = platform_mailbox_generate_event(IPC_GENERATE_EVENT_IRQ0);
+
+    return (err == FSP_SUCCESS) ? MAILBOX_SUCCESS :
+                                  MAILBOX_CHAN_BUSY;
+}
+
+/* Enter the mailbox critical section: mask local IRQs, then take IPCSEM8. */
+uint32_t tfm_ns_mailbox_hal_enter_critical(void)
+{
+    uint32_t state = __get_PRIMASK();
+
+    __disable_irq();
+
+    /* Take the IPC semaphore shared with the SPE mailbox critical section. */
+    while (platform_mailbox_semaphore_take() != FSP_SUCCESS) {
+    }
+
+    return state;
+}
+
+/* Exit the mailbox critical section and restore the local IRQ mask. */
+void tfm_ns_mailbox_hal_exit_critical(uint32_t state)
+{
+    (void) platform_mailbox_semaphore_give();
+
+    __set_PRIMASK(state);
+}
+
+/* ISR variant: IRQs are already masked by the caller's context. */
+uint32_t tfm_ns_mailbox_hal_enter_critical_isr(void)
+{
+    while (platform_mailbox_semaphore_take() != FSP_SUCCESS) {
+    }
+
+    return 0U;
+}
+
+void tfm_ns_mailbox_hal_exit_critical_isr(uint32_t state)
+{
+    (void) state;
+    (void) platform_mailbox_semaphore_give();
+}
diff --git a/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_mailbox.c b/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_mailbox.c
new file mode 100644
index 000000000..65baeba70
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/services/src/tfm_hal_mailbox.c
@@ -0,0 +1,96 @@
+/*
