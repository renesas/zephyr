index 000000000..e543101be
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/ra8m2/fsp/fsp_post_config.cmake
@@ -0,0 +1,414 @@
+#-------------------------------------------------------------------------------
+# Copyright (c) 2026 Renesas Electronics Corporation
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#-------------------------------------------------------------------------------
+
+# FSP post config for RA8M2. Included by fsp_s_lib.cmake and
+# fsp_ns_lib.cmake after s_ns_{memory,interrupt,peripheral}.cmake in this directory,
+# which hold only settings. All derived values and the compile definitions
+# exported on fsp_library_config (PRIVATE to the fsp_library sources) are computed
+# here. Nothing is exported to platform_region_defs: TF-M's region_defs.h and
+# flash_layout.h use only TF-M-level values from config.cmake / post_config.cmake.
+
+#==================== Partition settings for bsp_linker_info.h ================#
+# Veneer region MUST be allocated at the top of the S image code area: the end of
+# the S primary slot, below the image trailer (0 without BL2). Must match
+# TFM_LINKER_VENEERS_START in partition/region_defs.h.
+math(EXPR _VENEER_START "${S_ROM_ALIAS_BASE} + ${FLASH_AREA_BL2_OFFSET} + ${FLASH_AREA_BL2_SIZE} + ${FLASH_S_PARTITION_SIZE} - ${BL2_TRAILER_SIZE} - ${FLASH_CPU0_C_SIZE}" OUTPUT_FORMAT HEXADECIMAL)
+set(FLASH_CPU0_C_START "${_VENEER_START}" CACHE STRING "CMSE veneer region base in MRAM (NSC)" FORCE)
+
+if(DEFINED S_RAM_ALIAS_BASE)
+    # Values are available (this file is being included from the S-side
+    # CMakeLists.txt, after config.cmake has run).
+    set(RAM_CPU0_S_START ${S_RAM_ALIAS_BASE})
+    # The NSC carve-out (RAM_CPU0_C_SIZE) is excluded from the secure RAM
+    # partition so the FSP BSP's SAU secure region does not overlap it;
+    # RAM_CPU0_C_SIZE itself is declared in s_ns_memory.cmake.
+    math(EXPR RAM_CPU0_S_SIZE "${S_DATA_SIZE} - ${RAM_CPU0_C_SIZE}")
+    math(EXPR RAM_NS_CPU0_N_START "${CPU0_NS_RAM_ALIAS_BASE} + ${CPU0_NS_RAM_OFFSET}")
+    set(RAM_NS_CPU0_N_SIZE ${CPU0_NS_RAM_DATA_SIZE})
+else()
+    # Exceptional: config.cmake has not run (or its map was not exported to
+    # the NS build). These hardcoded values silently diverge from the
+    # config.cmake defaults if those change -- warn so it shows in build logs.
+    message(WARNING "RA8M2: fsp_post_config.cmake using hardcoded CPU0 RAM fallback values (S_RAM_ALIAS_BASE not defined); keep in sync with config.cmake")
+    set(RAM_CPU0_S_START "0x22000000")
+    set(RAM_CPU0_S_SIZE "0x80000")
+    set(RAM_NS_CPU0_N_START "0x32080000")
+    set(RAM_NS_CPU0_N_SIZE "0x80000")
+endif()
+
+if(DEFINED S_ROM_ALIAS_BASE)
+    set(FLASH_CPU0_S_START ${S_ROM_ALIAS_BASE})
+    set(FLASH_CPU0_S_SIZE ${FLASH_S_REGION_SIZE})
+    math(EXPR FLASH_NS_CPU0_N_START "${CPU0_NS_ROM_ALIAS_BASE} + ${CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET}")
+    set(FLASH_NS_CPU0_N_SIZE ${FLASH_CPU0_NS_PARTITION_SIZE})
+else()
+    # Exceptional: see the CPU0 RAM fallback above.
+    message(WARNING "RA8M2: fsp_post_config.cmake using hardcoded CPU0 FLASH fallback values (S_ROM_ALIAS_BASE not defined); keep in sync with config.cmake")
+    set(FLASH_CPU0_S_START "0x02000000")
+    set(FLASH_CPU0_S_SIZE "0x60000")
+    set(FLASH_NS_CPU0_N_START "0x12060000")
+    set(FLASH_NS_CPU0_N_SIZE "0x60000")
+endif()
+
+# CPU1 image/data partitions, derived from config.cmake's CPU1 map.
+if(DEFINED CPU1_NS_ROM_ALIAS_BASE)
+    math(EXPR _CPU1_FLASH_START "${CPU1_NS_ROM_ALIAS_BASE} + ${CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET}")
+    math(EXPR _CPU1_RAM_START "${CPU1_NS_RAM_ALIAS_BASE} + ${CPU1_NS_RAM_OFFSET}")
+    set(FLASH_NS_CPU1_N_START "${_CPU1_FLASH_START}")
+    set(FLASH_NS_CPU1_N_SIZE "${FLASH_CPU1_NS_PARTITION_SIZE}")
+    set(RAM_NS_CPU1_N_START "${_CPU1_RAM_START}")
+    set(RAM_NS_CPU1_N_SIZE "${CPU1_NS_RAM_DATA_SIZE}")
+else()
+    message(WARNING "RA8M2: fsp_post_config.cmake using hardcoded CPU1 fallback values (CPU1_NS_ROM_ALIAS_BASE not defined); keep in sync with config.cmake")
+    set(FLASH_NS_CPU1_N_START "0x0")
+    set(FLASH_NS_CPU1_N_SIZE "0x0")
+    set(RAM_NS_CPU1_N_START "0x0")
+    set(RAM_NS_CPU1_N_SIZE "0x0")
