+set(RENESAS_RA_PSAR_NS_GPT_COMMON ON CACHE BOOL "")
+set(RENESAS_RA_PSAR_NS_GPT13 ON CACHE BOOL "")
+set(RENESAS_RA_PSAR_NS_GPT12 ON CACHE BOOL "")
+set(RENESAS_RA_PSAR_NS_GPT11 ON CACHE BOOL "")
+set(RENESAS_RA_PSAR_NS_GPT10 ON CACHE BOOL "")
+set(RENESAS_RA_PSAR_NS_GPT4 ON CACHE BOOL "")
+set(RENESAS_RA_PSAR_NS_GPT3 ON CACHE BOOL "")
