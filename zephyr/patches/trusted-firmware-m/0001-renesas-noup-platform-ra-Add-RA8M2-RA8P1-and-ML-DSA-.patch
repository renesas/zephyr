diff --git a/platform/ext/target/renesas/ra/common/core/bl2.cmake b/platform/ext/target/renesas/ra/common/core/bl2.cmake
new file mode 100644
index 000000000..107690ecc
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/bl2.cmake
@@ -0,0 +1,126 @@
+#-------------------------------------------------------------------------------
+# Copyright (c) 2026 Renesas Electronics Corporation
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#-------------------------------------------------------------------------------
+
+# BL2 (MCUboot) target configuration for the Renesas RA platforms.
+#
+# Included from common.cmake when BL2 is ON, after the FSP library
+# (fsp_library, FSP_LIBS_CORE_PATH) and the generic platform_bl2 / bl2 targets
+# exist. It adds the platform sources, the FSP integration and the linker script
+# to those targets.
+
+# BL2 is an FSP flat project: it runs only in the secure state, has no
+# non-secure world and no CMSE entry functions, so it is built without
+# _RA_TZ_SECURE and without the CMSE compiler flag. In a flat build the FSP
+# start-up skips R_BSP_SecurityInit (no SAR / SAU partitioning) and only puts
+# the peripherals (PSARB..E) and the port pins (PMSAR) in secure mode, which is
+# all BL2 needs. The SAU is left disabled with ALLNS set (core startup.c), so
+# the IDAU alone attributes addresses by alias. The TF-M secure image does the
+# full security init with its real configuration after BL2 jumps to it.
+
+# fsp_library_config holds the FSP memory map macros (fsp_library_config
+# applies them to the FSP sources only), fsp_library the build selectors. Drop
+# the secure-build selector so the FSP sources compiled into platform_bl2 are a
+# flat build.
+get_target_property(_ra_fsp_defs fsp_library_config INTERFACE_COMPILE_DEFINITIONS)
+get_target_property(_ra_fsp_build_defs fsp_library INTERFACE_COMPILE_DEFINITIONS)
+set(RA_BL2_FSP_DEFINITIONS ${_ra_fsp_defs} ${_ra_fsp_build_defs})
+list(REMOVE_ITEM RA_BL2_FSP_DEFINITIONS _RA_TZ_SECURE)
+list(REMOVE_DUPLICATES RA_BL2_FSP_DEFINITIONS)
+
+# .ram_from_flash holds MRAM programming code that must run from SRAM, so
+# the RAM load segment is intentionally executable.
+target_link_options(platform_bl2
+    PUBLIC
+    ${BL2_LINKER_CP_OPTION}
+    $<$<C_COMPILER_ID:GNU>:-Wl,--no-warn-rwx-segments>
+)
+
+target_sources(platform_bl2
+    PRIVATE
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/CMSIS_Driver/Driver_USART.c
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/CMSIS_Driver/Driver_Flash.c
+)
+
+# The FSP sources are added to platform_bl2 only (not by linking
+# fsp_library, which would also apply the secure-build selector and the CMSE
+# flag and pull every FSP source into the signing_layout_* object
+# libraries that link platform_bl2). hal_warmstart.c is excluded: it is linked
+# directly into bl2 below.
+get_target_property(_ra_fsp_sources fsp_library SOURCES)
+list(FILTER _ra_fsp_sources EXCLUDE REGEX "/hal_warmstart\\.c$")
+get_target_property(_ra_fsp_includes fsp_library INCLUDE_DIRECTORIES)
+target_sources(platform_bl2 PRIVATE ${_ra_fsp_sources})
+target_include_directories(platform_bl2 PUBLIC ${_ra_fsp_includes})
+target_compile_definitions(platform_bl2 PUBLIC ${RA_BL2_FSP_DEFINITIONS})
+target_link_libraries(platform_bl2 PUBLIC cmsis)
+
+# hal_warmstart.c holds the strong R_BSP_WarmStart that configures the pins
+# (UART TX/RX) after the clocks are up. FSP system.c has a weak empty
+# R_BSP_WarmStart, so if this object only sat inside the platform_bl2
+# static library the linker would never extract it and BL2 would run with
+# unconfigured pins (no UART log). Link it directly into the bl2 image.
+target_sources(bl2
+    PRIVATE
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/Device/Source/startup.c
+    ${FSP_LIBS_CORE_PATH}/ra_gen/hal_warmstart.c
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/bl2/flash_map_bl2.c
+)
+
+# startup.c is the only BL2 source built with the CMSE flag: it programs the
+# SAU, which CMSIS declares only for CMSE builds (__ARM_FEATURE_CMSE == 3). It
+# defines no cmse_nonsecure_entry function, so no CMSE veneer is generated.
+# Not for the rest of BL2: with __ARM_FEATURE_CMSE == 3, BSP_CMSE_NONSECURE_ENTRY
+# turns FSP functions into entry functions. startup.c tells BL2 (program the
+# SAU, no stack sealing) from the TF-M secure image by CONFIG_TFM_USE_TRUSTZONE,
+# defined for the secure image only. TARGET_DIRECTORY: bl2 is created in
+# another directory, and tfm_s (which also builds startup.c) is not affected.
+set_source_files_properties(${RENESAS_RA_COMMON_SOURCE_DIR}/core/Device/Source/startup.c
+    TARGET_DIRECTORY bl2
+    PROPERTIES COMPILE_OPTIONS "${COMPILER_CMSE_FLAG}"
+)
+
+# Signing layout of the CPU1 NS image (MCUboot image 2, flash area 4). The
+# generic TF-M layouts only cover the S and CPU0 NS images. The layout is
+# installed next to them for the CPU1 NS build, which signs its image with it
+# (core/ns/common.cmake). The _ns.o suffix makes the signing wrapper record the
+# image as non-secure for measured boot.
+if(MCUBOOT_IMAGE_NUMBER EQUAL 3)
+    set(IMAGE_TYPE "CPU1_NS_IMAGE")
+    set(FLASH_AREA_NUM 4)
+    configure_file(${CMAKE_SOURCE_DIR}/bl2/ext/mcuboot/signing_layout.c.in
+                   ${CMAKE_CURRENT_BINARY_DIR}/signing_layout_cpu1_ns.c @ONLY)
+
+    add_library(signing_layout_cpu1_ns OBJECT ${CMAKE_CURRENT_BINARY_DIR}/signing_layout_cpu1_ns.c)
+    target_compile_options(signing_layout_cpu1_ns
+        PRIVATE
+            $<$<C_COMPILER_ID:GNU,Clang>:-E\;-xc>
+            $<$<C_COMPILER_ID:ARMClang>:-E\;-xc>
+            $<$<C_COMPILER_ID:IAR>:--preprocess=ns\;$<TARGET_OBJECTS:signing_layout_cpu1_ns>>
+    )
+    target_compile_definitions(signing_layout_cpu1_ns
+        PRIVATE
+            BL2
+            MCUBOOT_IMAGE_NUMBER=${MCUBOOT_IMAGE_NUMBER}
+    )
+    target_link_libraries(signing_layout_cpu1_ns
+        PRIVATE
+            platform_bl2
+    )
+
+    if(PLATFORM_DEFAULT_IMAGE_SIGNING)
+        add_custom_target(signed_images_cpu1_ns ALL DEPENDS signing_layout_cpu1_ns)
+        install(FILES $<TARGET_OBJECTS:signing_layout_cpu1_ns>
+                DESTINATION ${INSTALL_IMAGE_SIGNING_DIR}/layout_files
+                RENAME signing_layout_cpu1_ns.o)
+    endif()
+endif()
+
+target_add_scatter_file(bl2
+    $<$<C_COMPILER_ID:ARMClang>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/scripts/armclang/tfm_common_bl2.sct>
+    $<$<C_COMPILER_ID:GNU>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/scripts/gcc/tfm_common_bl2.ld>
+    $<$<C_COMPILER_ID:Clang>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/scripts/atfe/tfm_common_bl2.ld>
+)
diff --git a/platform/ext/target/renesas/ra/common/core/bl2/flash_map_bl2.c b/platform/ext/target/renesas/ra/common/core/bl2/flash_map_bl2.c
new file mode 100644
index 000000000..c40eb601e
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/bl2/flash_map_bl2.c
@@ -0,0 +1,139 @@
+/*
+ * Copyright (c) 2026 Renesas Electronics Corporation
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ */
+
+/* Platform MCUboot flash map. The default TF-M flash map handles at most two
+ * images; the RA platform also manages the CPU1 (Cortex-M33) NS image.
+ *
+ * As in the default flash map, FLASH_DEV_NAME_<n> and FLASH_DEVICE_ID_<n> can
+ * be defined by the platform (flash_layout.h) to place FLASH_AREA_<n> on
+ * another flash device, e.g. external flash for the NS images. FLASH_DRIVER_LIST
+ * must then list every driver to initialize, each one once.
+ */
+
+#include <stdbool.h>
+#include "flash_map/flash_map.h"
+#include "target.h"
+#include "Driver_Flash.h"
+#include "tfm_utils.h"
+
+/* target.h only checks areas 0 to 3 */
+#if defined(FLASH_DEV_NAME_4) != defined(FLASH_DEVICE_ID_4)
+#error "FLASH DEV_NAME_4 and DEVICE_ID_4 must be simultaneously defined or not by target"
+#endif
+
+#if defined(FLASH_DEV_NAME_5) != defined(FLASH_DEVICE_ID_5)
+#error "FLASH DEV_NAME_5 and DEVICE_ID_5 must be simultaneously defined or not by target"
+#endif
+
+/* When undefined FLASH_DEV_NAME_0 or FLASH_DEVICE_ID_0 , default */
+#if !defined(FLASH_DEV_NAME_0) || !defined(FLASH_DEVICE_ID_0)
+#define FLASH_DEV_NAME_0  FLASH_DEV_NAME
+#define FLASH_DEVICE_ID_0 FLASH_DEVICE_ID
+#endif
+
+/* When undefined FLASH_DEV_NAME_1 or FLASH_DEVICE_ID_1 , default */
+#if !defined(FLASH_DEV_NAME_1) || !defined(FLASH_DEVICE_ID_1)
+#define FLASH_DEV_NAME_1  FLASH_DEV_NAME
+#define FLASH_DEVICE_ID_1 FLASH_DEVICE_ID
+#endif
+
+/* When undefined FLASH_DEV_NAME_2 or FLASH_DEVICE_ID_2 , default */
+#if !defined(FLASH_DEV_NAME_2) || !defined(FLASH_DEVICE_ID_2)
+#define FLASH_DEV_NAME_2  FLASH_DEV_NAME
+#define FLASH_DEVICE_ID_2 FLASH_DEVICE_ID
+#endif
+
+/* When undefined FLASH_DEV_NAME_3 or FLASH_DEVICE_ID_3 , default */
+#if !defined(FLASH_DEV_NAME_3) || !defined(FLASH_DEVICE_ID_3)
+#define FLASH_DEV_NAME_3  FLASH_DEV_NAME
+#define FLASH_DEVICE_ID_3 FLASH_DEVICE_ID
+#endif
+
+#if (MCUBOOT_IMAGE_NUMBER == 3)
+/* When undefined FLASH_DEV_NAME_4 or FLASH_DEVICE_ID_4 , default */
+#if !defined(FLASH_DEV_NAME_4) || !defined(FLASH_DEVICE_ID_4)
+#define FLASH_DEV_NAME_4  FLASH_DEV_NAME
+#define FLASH_DEVICE_ID_4 FLASH_DEVICE_ID
+#endif
+
+/* When undefined FLASH_DEV_NAME_5 or FLASH_DEVICE_ID_5 , default */
+#if !defined(FLASH_DEV_NAME_5) || !defined(FLASH_DEVICE_ID_5)
+#define FLASH_DEV_NAME_5  FLASH_DEV_NAME
+#define FLASH_DEVICE_ID_5 FLASH_DEVICE_ID
+#endif
+#endif /* (MCUBOOT_IMAGE_NUMBER == 3) */
+
+/* Flash device names must be specified by target */
+extern ARM_DRIVER_FLASH FLASH_DEV_NAME;
+extern ARM_DRIVER_FLASH FLASH_DEV_NAME_0;
+extern ARM_DRIVER_FLASH FLASH_DEV_NAME_1;
+extern ARM_DRIVER_FLASH FLASH_DEV_NAME_2;
+extern ARM_DRIVER_FLASH FLASH_DEV_NAME_3;
+#if (MCUBOOT_IMAGE_NUMBER == 3)
+extern ARM_DRIVER_FLASH FLASH_DEV_NAME_4;
+extern ARM_DRIVER_FLASH FLASH_DEV_NAME_5;
+#endif
+
+#if !defined(FLASH_DRIVER_LIST)
+/* Default Drivers list */
+const ARM_DRIVER_FLASH *flash_driver[] = {
+    &FLASH_DEV_NAME,
+};
+#else
+/* Platform driver list */
+const ARM_DRIVER_FLASH *flash_driver[] = FLASH_DRIVER_LIST;
+#endif /* !defined(FLASH_DRIVER_LIST) */
+const int flash_driver_entry_num = ARRAY_SIZE(flash_driver);
+
+const struct flash_area flash_map[] = {
+    {
+        .fa_id = FLASH_AREA_0_ID,
+        .fa_device_id = FLASH_DEVICE_ID_0,
+        .fa_driver = &FLASH_DEV_NAME_0,
+        .fa_off = FLASH_AREA_0_OFFSET,
+        .fa_size = FLASH_AREA_0_SIZE,
+    },
+    {
+        .fa_id = FLASH_AREA_1_ID,
+        .fa_device_id = FLASH_DEVICE_ID_1,
+        .fa_driver = &FLASH_DEV_NAME_1,
+        .fa_off = FLASH_AREA_1_OFFSET,
+        .fa_size = FLASH_AREA_1_SIZE,
+    },
+    {
+        .fa_id = FLASH_AREA_2_ID,
+        .fa_device_id = FLASH_DEVICE_ID_2,
+        .fa_driver = &FLASH_DEV_NAME_2,
+        .fa_off = FLASH_AREA_2_OFFSET,
+        .fa_size = FLASH_AREA_2_SIZE,
+    },
+    {
+        .fa_id = FLASH_AREA_3_ID,
+        .fa_device_id = FLASH_DEVICE_ID_3,
+        .fa_driver = &FLASH_DEV_NAME_3,
+        .fa_off = FLASH_AREA_3_OFFSET,
+        .fa_size = FLASH_AREA_3_SIZE,
+    },
+#if (MCUBOOT_IMAGE_NUMBER == 3)
+    {
+        .fa_id = FLASH_AREA_4_ID,
+        .fa_device_id = FLASH_DEVICE_ID_4,
+        .fa_driver = &FLASH_DEV_NAME_4,
+        .fa_off = FLASH_AREA_4_OFFSET,
+        .fa_size = FLASH_AREA_4_SIZE,
+    },
+    {
+        .fa_id = FLASH_AREA_5_ID,
+        .fa_device_id = FLASH_DEVICE_ID_5,
+        .fa_driver = &FLASH_DEV_NAME_5,
+        .fa_off = FLASH_AREA_5_OFFSET,
+        .fa_size = FLASH_AREA_5_SIZE,
+    },
+#endif /* (MCUBOOT_IMAGE_NUMBER == 3) */
+};
+
+const int flash_map_entry_num = ARRAY_SIZE(flash_map);
diff --git a/platform/ext/target/renesas/ra/common/core/check_config.cmake b/platform/ext/target/renesas/ra/common/core/check_config.cmake
new file mode 100644
index 000000000..3644d9a63
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/check_config.cmake
@@ -0,0 +1,296 @@
+#-------------------------------------------------------------------------------
+# Copyright (c) 2026 Renesas Electronics Corporation
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#-------------------------------------------------------------------------------
+
+# Configure-time validation of the RA flash/RAM map declared in config.cmake.
+#
+# Each board's check_config.cmake (<board>/check_config.cmake) will also have their specific
+# check logic and will include its SoC-specific check_config.cmake.
+#
+# Each SoC's check_config.cmake (common/<soc>/check_config.cmake) will have their specific
+# check logic for their specific hardware, and will include this common check file.
+
+if(NOT RA_CM85_NS_PRESENT)
+    message(FATAL_ERROR "${RA_SOC_NAME}: RA_CM85_NS_PRESENT OFF is not supported.")
+endif()
+
+if(DEFINED MCUBOOT_IMAGE_NUMBER AND MCUBOOT_IMAGE_NUMBER GREATER 3)
+    message(FATAL_ERROR "${RA_SOC_NAME}: only MCUBOOT_IMAGE_NUMBER 1, 2 and 3 are supported.")
+endif()
+
+# The MCUboot options come from the SPE build; the NS build does not set them.
+if(BL2 AND S_BUILD)
+    # With the CPU1 image, S, CPU0 NS and CPU1 NS are separate images.
+    if(RA_CM33_NS_PRESENT)
+        set(_ra_expected_images 3)
+        set(_ra_cpu1_msg ", CPU1 NS")
+    else()
+        set(_ra_expected_images 2)
+        set(_ra_cpu1_msg "")
+    endif()
+    if(NOT MCUBOOT_IMAGE_NUMBER EQUAL _ra_expected_images)
+        message(FATAL_ERROR "${RA_SOC_NAME}: BL2 requires MCUBOOT_IMAGE_NUMBER ${_ra_expected_images} (separate S, CPU0 NS${_ra_cpu1_msg} images), got ${MCUBOOT_IMAGE_NUMBER}.")
+    endif()
+    # Secondary slots live in MRAM next to the primary ones and MRAM has no
+    # scratch area / bank swap: only overwrite upgrades are supported.
+    if(NOT MCUBOOT_UPGRADE_STRATEGY STREQUAL "OVERWRITE_ONLY")
+        message(FATAL_ERROR "${RA_SOC_NAME}: BL2 supports only MCUBOOT_UPGRADE_STRATEGY=OVERWRITE_ONLY (got ${MCUBOOT_UPGRADE_STRATEGY}).")
+    endif()
+    # Image trailer writes must be a multiple of the MRAM program unit.
+    math(EXPR _align_rem "${MCUBOOT_ALIGN_VAL} % ${FLASH_PROGRAM_UNIT}")
+    if(MCUBOOT_ALIGN_VAL LESS FLASH_PROGRAM_UNIT OR NOT _align_rem EQUAL 0)
+        message(FATAL_ERROR "${RA_SOC_NAME}: MCUBOOT_ALIGN_VAL (${MCUBOOT_ALIGN_VAL}) must be a multiple of FLASH_PROGRAM_UNIT (${FLASH_PROGRAM_UNIT}).")
+    endif()
+    # The default MCUboot flash map handles at most 2 images; the platform
+    # provides its own map (common/core/bl2/flash_map_bl2.c).
+    if(DEFAULT_MCUBOOT_FLASH_MAP)
+        message(FATAL_ERROR "${RA_SOC_NAME}: BL2 uses the platform flash map (DEFAULT_MCUBOOT_FLASH_MAP=OFF).")
+    endif()
+endif()
+
+# The external OSPI/SDRAM/CS address space is hardwired non-secure in the
+# IDAU and this cannot be overridden by software. Secure code must stay in
+# on-chip ROM.
+if(NOT S_ROM_ALIAS_BASE STREQUAL FLASH_BASE_ADDRESS)
+    message(FATAL_ERROR "${RA_SOC_NAME}: S_ROM_ALIAS_BASE (${S_ROM_ALIAS_BASE}) must be the on-chip ROM secure alias (${FLASH_BASE_ADDRESS}) -- the external address space is hardwired non-secure and cannot host SPE code.")
+endif()
+
+# Checks whether [_base, _base + _size) falls within one of the known
+# non-secure external windows (OSPI0/1 CS0/CS1, SDRAM; RA_NS_WINDOW_STARTS/
+# RA_NS_WINDOW_ENDS, set in config.cmake). Used to validate any image
+# relocated off-chip (e.g. the NS image on external flash).
+# Sets _out_var to TRUE/FALSE in the caller's scope.
+function(_ra_check_in_ns_window _base _size _out_var)
+    math(EXPR _base_dec "${_base}")
+    math(EXPR _end_dec "${_base} + ${_size}")
+
+    set(_in_window FALSE)
+    list(LENGTH RA_NS_WINDOW_STARTS _window_count)
+    math(EXPR _window_last "${_window_count} - 1")
+    foreach(_win_idx RANGE ${_window_last})
+        list(GET RA_NS_WINDOW_STARTS ${_win_idx} _win_start)
+        list(GET RA_NS_WINDOW_ENDS ${_win_idx} _win_end)
+        math(EXPR _win_start_dec "${_win_start}")
+        math(EXPR _win_end_dec "${_win_end}")
+        if(NOT (_base_dec LESS _win_start_dec) AND NOT (_end_dec GREATER _win_end_dec))
+            set(_in_window TRUE)
+        endif()
+    endforeach()
+
+    set(${_out_var} ${_in_window} PARENT_SCOPE)
+endfunction()
+
+# ---- Flash instances ---------------------------------------------------------
+# The generic MCUboot flash map code uses FLASH_AREA_IMAGE_SECTOR_SIZE and
+# FLASH_PROGRAM_UNIT, the largest values of the flash instances that hold an
+# image (post_config.cmake), for every flash area. Each instance's own value
+# must divide them, so that every area is a whole number of sectors and program
+# units of the device it is in.
+# Instance 0 is the MRAM (FLASH0_*), instance 1 the external flash (FLASH1_*),
+# which only counts when an NS image is in it.
+set(_ra_geom_checks
+    "FLASH0_SECTOR_SIZE|FLASH_AREA_IMAGE_SECTOR_SIZE"
+    "FLASH0_PROGRAM_UNIT|FLASH_PROGRAM_UNIT")
+if(RA_CPU0_NS_EXTERNAL OR RA_CPU1_NS_EXTERNAL)
+    list(APPEND _ra_geom_checks
+        "FLASH1_SECTOR_SIZE|FLASH_AREA_IMAGE_SECTOR_SIZE"
+        "FLASH1_PROGRAM_UNIT|FLASH_PROGRAM_UNIT")
+endif()
+foreach(_ra_check IN LISTS _ra_geom_checks)
+    string(REPLACE "|" ";" _ra_check "${_ra_check}")
+    list(GET _ra_check 0 _ra_name)
+    list(GET _ra_check 1 _ra_global_name)
+    set(_ra_val "${${_ra_name}}")
+    set(_ra_global "${${_ra_global_name}}")
+    if(_ra_val LESS 1)
+        message(FATAL_ERROR "${RA_SOC_NAME}: ${_ra_name} (${_ra_val}) must be at least 1.")
+    endif()
+    math(EXPR _ra_rem "${_ra_global} % ${_ra_val}")
+    if(NOT _ra_rem EQUAL 0)
+        message(FATAL_ERROR "${RA_SOC_NAME}: ${_ra_name} (${_ra_val}) must divide ${_ra_global_name} (${_ra_global}), the largest value of the flash instances.")
+    endif()
+endforeach()
+
+# With no external flash driver the external areas use the MRAM driver (see
+# flash_layout.h): the build works, but BL2 cannot access the image in the
+# external flash.
+if(BL2 AND S_BUILD AND (RA_CPU0_NS_EXTERNAL OR RA_CPU1_NS_EXTERNAL) AND NOT FLASH1_DEV_NAME)
+    message(WARNING "${RA_SOC_NAME}: an NS image is in the external flash but FLASH1_DEV_NAME is empty: BL2 falls back to the MRAM driver for it and cannot read it. Set FLASH1_DEV_NAME to the CMSIS driver of the external flash.")
+endif()
+
+# An NS image whose ROM alias is not the MRAM one (RA_CPU0_NS_EXTERNAL /
+# RA_CPU1_NS_EXTERNAL, derived by post_config.cmake) lives in the external flash
+# (flash instance 1). All its slots (primary and, with BL2, secondary) must fall
+# within one non-secure OSPI/SDRAM window, and they are not counted against the
+# MRAM budget below. The slot sizes can be changed on the command line, so the
+# window is checked with the final values.
+function(_ra_check_ext_image _name _alias _offset _slot_size _out_base _out_end)
+    math(EXPR _base "${_alias} + ${_offset}")
+    math(EXPR _size "${FLASH_SLOTS_PER_IMAGE} * ${_slot_size}")
+    _ra_check_in_ns_window("${_base}" "${_size}" _in_window)
+    if(NOT _in_window)
+        message(FATAL_ERROR "${RA_SOC_NAME}: the ${_name} NS image (ROM alias ${_alias} + offset ${_offset}, ${FLASH_SLOTS_PER_IMAGE} slot(s) of ${_slot_size}) does not fall within a known non-secure external window (OSPI0/1 CS0/CS1 or SDRAM).")
+    endif()
+    math(EXPR _end "${_base} + ${_size}")
+    set(${_out_base} ${_base} PARENT_SCOPE)
+    set(${_out_end} ${_end} PARENT_SCOPE)
+endfunction()
+
+if(RA_CPU0_NS_EXTERNAL)
+    _ra_check_ext_image("CPU0" "${CPU0_NS_ROM_ALIAS_BASE}" "${CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET}"
+                        "${FLASH_CPU0_NS_PARTITION_SIZE}" _ra_cpu0_ext_base _ra_cpu0_ext_end)
+endif()
+
+# ---- CPU1 (multi-core) map checks --------------------------------------------
+# Keyed on RA_CM33_NS_PRESENT rather than TFM_MULTI_CORE_TOPOLOGY: the generated
+# NS config.cmake forces TFM_MULTI_CORE_TOPOLOGY off for a CPU0 TrustZone NS
+# build, but the CPU1 slots the SPE reserved still exist and must still be
+# validated on that side.
+if(RA_CM33_NS_PRESENT)
+    if(RA_CPU1_NS_EXTERNAL)
+        _ra_check_ext_image("CPU1" "${CPU1_NS_ROM_ALIAS_BASE}" "${CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET}"
+                            "${FLASH_CPU1_NS_PARTITION_SIZE}" _ra_cpu1_ext_base _ra_cpu1_ext_end)
+        if(RA_CPU0_NS_EXTERNAL AND (_ra_cpu1_ext_base LESS _ra_cpu0_ext_end) AND (_ra_cpu0_ext_base LESS _ra_cpu1_ext_end))
+            message(FATAL_ERROR "${RA_SOC_NAME}: the CPU0 and CPU1 NS images overlap in the external flash (CPU0 [${_ra_cpu0_ext_base}, ${_ra_cpu0_ext_end}), CPU1 [${_ra_cpu1_ext_base}, ${_ra_cpu1_ext_end})).")
+        endif()
+    endif()
+
+    # CPU1's SRAM window must not overlap the S/NS data regions it shares the
+    # bank with. S_RAM_ALIAS_BASE and CPU0_NS_RAM_ALIAS_BASE (and CPU1_NS_RAM_ALIAS_BASE)
+    # are different *aliases* of the same physical SRAM (HW manual Address
+    # Space 5.1), so comparisons must be done in bank-relative offsets, not
+    # raw aliased addresses.
+    set(_s_ram_offset 0)
+    math(EXPR _s_ram_end_offset "${_s_ram_offset} + ${S_DATA_SIZE}")
+    set(_ns_cpu0_ram_offset "${CPU0_NS_RAM_OFFSET}")
+    math(EXPR _ns_cpu0_ram_end_offset "${_ns_cpu0_ram_offset} + ${CPU0_NS_RAM_DATA_SIZE}")
+    set(_ns_cpu1_ram_offset "${CPU1_NS_RAM_OFFSET}")
+    math(EXPR _ns_cpu1_ram_end_offset "${_ns_cpu1_ram_offset} + ${CPU1_NS_RAM_DATA_SIZE}")
+
+    if((_ns_cpu1_ram_offset LESS _s_ram_end_offset) AND (_ns_cpu1_ram_end_offset GREATER _s_ram_offset))
+        message(FATAL_ERROR "${RA_SOC_NAME}: CPU1 RAM window (bank offset [${_ns_cpu1_ram_offset}, +${CPU1_NS_RAM_DATA_SIZE})) overlaps the secure data region (bank offset [${_s_ram_offset}, +${S_DATA_SIZE})).")
+    endif()
+    if((_ns_cpu1_ram_offset LESS _ns_cpu0_ram_end_offset) AND (_ns_cpu1_ram_end_offset GREATER _ns_cpu0_ram_offset))
+        message(FATAL_ERROR "${RA_SOC_NAME}: CPU1 RAM window (bank offset [${_ns_cpu1_ram_offset}, +${CPU1_NS_RAM_DATA_SIZE})) overlaps the non-secure data region (bank offset [${_ns_cpu0_ram_offset}, +${CPU0_NS_RAM_DATA_SIZE})).")
+    endif()
+
+endif()
+
+# ---- Alignment checks --------------------------------------------------------
+
+# The S/NS flash boundary (end of BL2, S slot(s) and storage, i.e.
+# FLASH_S_REGION_SIZE) must land on one of the on-chip ROM
+# security-attribution granular boundaries (HW manual Security Features).
+math(EXPR _s_attr_rem "${FLASH_S_REGION_SIZE} % ${RA_ROM_ATTR_GRANULARITY}")
+if(NOT _s_attr_rem EQUAL 0)
+    message(FATAL_ERROR "${RA_SOC_NAME}: the secure MRAM region (BL2 + S slots + storage = ${FLASH_S_REGION_SIZE}) must be a multiple of ${RA_ROM_ATTR_GRANULARITY} (on-chip ROM security-attribution granularity).")
+endif()
+
+# The MRAM FS block needs to align to the on-chip ROM attribution granularity when
+# it is at least as large as that granularity.
+if(FLASH0_SECTOR_SIZE GREATER_EQUAL RA_ROM_ATTR_GRANULARITY)
+    math(EXPR _sector_attr_rem "${FLASH0_SECTOR_SIZE} % ${RA_ROM_ATTR_GRANULARITY}")
+    if(NOT _sector_attr_rem EQUAL 0)
+        message(FATAL_ERROR "${RA_SOC_NAME}: FLASH0_SECTOR_SIZE (${FLASH0_SECTOR_SIZE}) must be a multiple of ${RA_ROM_ATTR_GRANULARITY} (on-chip ROM security-attribution granularity).")
+    endif()
+endif()
+
+# SRAM security attribution is expressed in RA_SRAM_ATTR_GRANULARITY units
+# (BA units, HW manual Security Features).
+math(EXPR _sdata_attr_rem "${S_DATA_SIZE} % ${RA_SRAM_ATTR_GRANULARITY}")
+if(NOT _sdata_attr_rem EQUAL 0)
+    message(FATAL_ERROR "${RA_SOC_NAME}: S_DATA_SIZE (${S_DATA_SIZE}) must be a multiple of ${RA_SRAM_ATTR_GRANULARITY} (SRAM security-attribution granularity).")
+endif()
+
+# The RAM-resident on-chip ROM programming code carve-out (S_RAM_CODE_SIZE,
+# used by .ER_CODE_SRAM) must be word-aligned and leave room for the secure
+# data. Secure-side only: the carve-out lives inside the secure data region and
+# only the secure linker script places it.
+if(S_BUILD)
+    math(EXPR _ram_code_rem "${S_RAM_CODE_SIZE} % 4")
+    if(NOT _ram_code_rem EQUAL 0)
+        message(FATAL_ERROR "${RA_SOC_NAME}: S_RAM_CODE_SIZE (${S_RAM_CODE_SIZE}) must be a multiple of 4.")
+    endif()
+    if(S_RAM_CODE_SIZE GREATER_EQUAL S_DATA_SIZE)
+        message(FATAL_ERROR "${RA_SOC_NAME}: S_RAM_CODE_SIZE (${S_RAM_CODE_SIZE}) must be smaller than S_DATA_SIZE (${S_DATA_SIZE}).")
+    endif()
+endif()
+
+math(EXPR _punit_sector_rem "${FLASH_AREA_IMAGE_SECTOR_SIZE} % ${FLASH_PROGRAM_UNIT}")
+if(NOT _punit_sector_rem EQUAL 0)
+    message(FATAL_ERROR "${RA_SOC_NAME}: FLASH_AREA_IMAGE_SECTOR_SIZE (${FLASH_AREA_IMAGE_SECTOR_SIZE}) must be a multiple of FLASH_PROGRAM_UNIT (${FLASH_PROGRAM_UNIT}).")
+endif()
+
+# The image slots are a whole number of the sectors the MCUboot flash map code
+# uses; BL2 and the storage areas are in MRAM, so they follow its FS block.
+foreach(_area_size IN ITEMS FLASH_S_PARTITION_SIZE FLASH_CPU0_NS_PARTITION_SIZE FLASH_CPU1_NS_PARTITION_SIZE)
+    math(EXPR _rem "${${_area_size}} % ${FLASH_AREA_IMAGE_SECTOR_SIZE}")
+    if(NOT _rem EQUAL 0)
+        message(FATAL_ERROR "${RA_SOC_NAME}: ${_area_size} (${${_area_size}}) must be a multiple of FLASH_AREA_IMAGE_SECTOR_SIZE (${FLASH_AREA_IMAGE_SECTOR_SIZE}).")
+    endif()
+endforeach()
+
+foreach(_area_size IN ITEMS FLASH_AREA_BL2_SIZE FLASH_PS_AREA_SIZE FLASH_ITS_AREA_SIZE FLASH_OTP_NV_COUNTERS_AREA_SIZE)
+    math(EXPR _rem "${${_area_size}} % ${FLASH0_SECTOR_SIZE}")
+    if(NOT _rem EQUAL 0)
+        message(FATAL_ERROR "${RA_SOC_NAME}: ${_area_size} (${${_area_size}}) must be a multiple of FLASH0_SECTOR_SIZE (${FLASH0_SECTOR_SIZE}).")
+    endif()
+endforeach()
+
+# ---- Fit checks --------------------------------------------------------------
+
+# The on-chip ROM chain is: BL2, S slot(s) (code + CMSE veneers), the storage
+# areas (together FLASH_S_REGION_SIZE), then CPU0 NS starts at
+# CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET (primary, plus secondary with BL2),
+# then the CPU1 NS image. Each on-chip ROM region is validated against its real
+# [offset, offset+size) end, so an offset larger than the preceding chain cannot
+# silently overflow on-chip ROM, and a smaller offset cannot silently overlap
+# the chain before it.
+set(_ns_chain_end "${FLASH_S_REGION_SIZE}")
+if(NOT RA_CPU0_NS_EXTERNAL)
+    if(CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET LESS _ns_chain_end)
+        message(FATAL_ERROR "${RA_SOC_NAME}: CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET (${CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET}) is before the end of the S slots/storage areas (${_ns_chain_end}); the NS image would overlap S/storages.")
+    endif()
+    math(EXPR _ns_chain_end "${CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET} + ${FLASH_SLOTS_PER_IMAGE} * ${FLASH_CPU0_NS_PARTITION_SIZE}")
+endif()
+
+# The CMSE veneer region is placed by the linker script at the top of the S code area.
+# Secure-side only: FLASH_CPU0_C_SIZE is produced by fsp/s_ns_memory.cmake
+# during the platform build, so it is only in scope here because TF-M includes
+# this chain after add_subdirectory(platform). The NS build includes the chain
+# from its config.cmake, long before any FSP CMake has run.
+if(S_BUILD AND FLASH_CPU0_C_SIZE GREATER FLASH_S_PARTITION_SIZE)
+    message(FATAL_ERROR "${RA_SOC_NAME}: the CMSE veneer region (${FLASH_CPU0_C_SIZE} bytes) exceeds the S slot (${FLASH_S_PARTITION_SIZE}).")
+endif()
+
+set(_rom_end "${_ns_chain_end}")
+if(RA_CM33_NS_PRESENT AND NOT RA_CPU1_NS_EXTERNAL)
+    if(CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET LESS _ns_chain_end)
+        message(FATAL_ERROR "${RA_SOC_NAME}: CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET (${CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET}) is before the end of the S+NS chain (${_ns_chain_end}); CPU1 would overlap.")
+    endif()
+    math(EXPR _cpu1_end "${CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET} + ${FLASH_SLOTS_PER_IMAGE} * ${FLASH_CPU1_NS_PARTITION_SIZE}")
+    if(_cpu1_end GREATER _rom_end)
+        set(_rom_end "${_cpu1_end}")
+    endif()
+endif()
+
+if(_rom_end GREATER FLASH_TOTAL_SIZE)
+    math(EXPR _shortfall "${_rom_end} - ${FLASH_TOTAL_SIZE}")
+    message(FATAL_ERROR "${RA_SOC_NAME}: flash map does not fit on-chip ROM: high-water mark ${_rom_end} (${_rom_end} decimal), have FLASH_TOTAL_SIZE=${FLASH_TOTAL_SIZE}, short by ${_shortfall} bytes.")
+endif()
+
+math(EXPR _ram_used "${S_DATA_SIZE} + ${CPU0_NS_RAM_DATA_SIZE}")
+if(RA_CM33_NS_PRESENT)
+    math(EXPR _ram_used "${_ram_used} + ${CPU1_NS_RAM_DATA_SIZE}")
+endif()
+if(_ram_used GREATER TOTAL_RAM_SIZE)
+    math(EXPR _ram_shortfall "${_ram_used} - ${TOTAL_RAM_SIZE}")
+    if(RA_CM33_NS_PRESENT)
+        message(FATAL_ERROR "${RA_SOC_NAME}: S_DATA_SIZE + CPU0_NS_RAM_DATA_SIZE + CPU1_NS_RAM_DATA_SIZE (${_ram_used}) exceeds TOTAL_RAM_SIZE (${TOTAL_RAM_SIZE}), short by ${_ram_shortfall} bytes.")
+    else()
+        message(FATAL_ERROR "${RA_SOC_NAME}: S_DATA_SIZE + CPU0_NS_RAM_DATA_SIZE (${_ram_used}) exceeds TOTAL_RAM_SIZE (${TOTAL_RAM_SIZE}), short by ${_ram_shortfall} bytes.")
+    endif()
+endif()
diff --git a/platform/ext/target/renesas/ra/common/core/common.cmake b/platform/ext/target/renesas/ra/common/core/common.cmake
new file mode 100644
index 000000000..271290b9b
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/common.cmake
@@ -0,0 +1,258 @@
+#-------------------------------------------------------------------------------
+# Copyright (c) 2026 Renesas Electronics Corporation
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#-------------------------------------------------------------------------------
+
+# Shared RA platform build/install logic, included from each board's
+# CMakeLists.txt. The board file must set FSP_SOC_TARGET (e.g. ra8p1) and
+# FSP_BOARD_TARGET (e.g. ra8p1_ek) before including this file.
+
+cmake_policy(SET CMP0076 NEW)
+set(CMAKE_FSP_LIBS_PATH ${CMAKE_CURRENT_SOURCE_DIR}/../common/core/fsp)
+
+#========================= FSP library configuration options ==================#
+
+# Include FSP library configuration for platform_s code
+include(${CMAKE_FSP_LIBS_PATH}/fsp_s_lib.cmake)
+
+#========================= platform_region_defs ===============================#
+
+target_include_directories(platform_region_defs
+    INTERFACE
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/Native_Driver
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/${FSP_SOC_TARGET}/partition
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/inc
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_CURRENT_SOURCE_DIR}/CMSIS_Driver/Config
+)
+
+# Memory map values are defined once on tfm_config below, which
+# platform_region_defs links and which is exported to the NS build. Only the
+# S-only values are added here.
+target_compile_definitions(platform_region_defs
+    INTERFACE
+    S_RAM_CODE_SIZE=${S_RAM_CODE_SIZE}
+)
+
+target_compile_definitions(tfm_config
+    INTERFACE
+    FLASH_BASE_ADDRESS=${FLASH_BASE_ADDRESS}
+    FLASH_TOTAL_SIZE=${FLASH_TOTAL_SIZE}
+    FLASH_AREA_IMAGE_SECTOR_SIZE=${FLASH_AREA_IMAGE_SECTOR_SIZE}
+    FLASH_PAGE_SIZE=${FLASH_PAGE_SIZE}
+    FLASH0_SECTOR_SIZE=${FLASH0_SECTOR_SIZE}
+    FLASH0_PROGRAM_UNIT=${FLASH0_PROGRAM_UNIT}
+    FLASH1_SECTOR_SIZE=${FLASH1_SECTOR_SIZE}
+    FLASH1_PROGRAM_UNIT=${FLASH1_PROGRAM_UNIT}
+    $<$<BOOL:${FLASH1_DEV_NAME}>:FLASH1_DEV_NAME=${FLASH1_DEV_NAME}>
+    $<$<BOOL:${RA_CPU0_NS_EXTERNAL}>:RA_CPU0_NS_EXTERNAL=1>
+    $<$<BOOL:${RA_CPU1_NS_EXTERNAL}>:RA_CPU1_NS_EXTERNAL=1>
+    $<$<BOOL:${RA_CM33_NS_PRESENT}>:RA_CM33_NS_PRESENT=1>
+    FLASH_S_REGION_SIZE=${FLASH_S_REGION_SIZE}
+    FLASH_AREA_BL2_OFFSET=${FLASH_AREA_BL2_OFFSET}
+    FLASH_AREA_BL2_SIZE=${FLASH_AREA_BL2_SIZE}
+    FLASH_S_PARTITION_SIZE=${FLASH_S_PARTITION_SIZE}
+    FLASH_CPU0_NS_PARTITION_SIZE=${FLASH_CPU0_NS_PARTITION_SIZE}
+    FLASH_CPU1_NS_PARTITION_SIZE=${FLASH_CPU1_NS_PARTITION_SIZE}
+    CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET=${CPU0_NS_IMAGE_PRIMARY_PARTITION_OFFSET}
+    CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET=${CPU1_NS_IMAGE_PRIMARY_PARTITION_OFFSET}
+    FLASH_PS_AREA_SIZE=${FLASH_PS_AREA_SIZE}
+    FLASH_ITS_AREA_SIZE=${FLASH_ITS_AREA_SIZE}
+    FLASH_OTP_NV_COUNTERS_AREA_SIZE=${FLASH_OTP_NV_COUNTERS_AREA_SIZE}
+    TOTAL_RAM_SIZE=${TOTAL_RAM_SIZE}
+    S_DATA_SIZE=${S_DATA_SIZE}
+    CPU0_NS_RAM_DATA_SIZE=${CPU0_NS_RAM_DATA_SIZE}
+    CPU1_NS_RAM_DATA_SIZE=${CPU1_NS_RAM_DATA_SIZE}
+    S_ROM_ALIAS_BASE=${S_ROM_ALIAS_BASE}
+    CPU0_NS_ROM_ALIAS_BASE=${CPU0_NS_ROM_ALIAS_BASE}
+    CPU1_NS_ROM_ALIAS_BASE=${CPU1_NS_ROM_ALIAS_BASE}
+    S_RAM_ALIAS_BASE=${S_RAM_ALIAS_BASE}
+    CPU0_NS_RAM_ALIAS_BASE=${CPU0_NS_RAM_ALIAS_BASE}
+    CPU1_NS_RAM_ALIAS_BASE=${CPU1_NS_RAM_ALIAS_BASE}
+    CPU0_NS_RAM_OFFSET=${CPU0_NS_RAM_OFFSET}
+    CPU1_NS_RAM_OFFSET=${CPU1_NS_RAM_OFFSET}
+    CMSE_VENEER_REGION_SIZE=${FLASH_CPU0_C_SIZE}
+)
+
+#========================= Platform common defs ===============================#
+
+set(RENESAS_RA_SCRIPT_DIR ${CMAKE_BINARY_DIR}/generated/platform/ext/target/renesas/ra/common/core/scripts)
+
+target_add_scatter_file(tfm_s
+    $<$<C_COMPILER_ID:ARMClang>:${RENESAS_RA_SCRIPT_DIR}/armclang/tfm_isolation_s.sct>
+    $<$<C_COMPILER_ID:GNU>:${RENESAS_RA_SCRIPT_DIR}/gcc/tfm_isolation_s.ld>
+    $<$<C_COMPILER_ID:Clang>:${RENESAS_RA_SCRIPT_DIR}/atfe/tfm_isolation_s.ld>
+)
+
+target_sources(tfm_s
+    PRIVATE
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/Device/Source/startup.c
+)
+
+# FSP objects are linked directly into the image (not through an archive) so
+# weak overrides and section-only data are kept.
+target_link_libraries(tfm_s
+    PRIVATE
+    fsp_library
+)
+
+#========================= Renesas Partition Data =============================#
+
+# Generates the partition data file next to the first image programmed
+# (tfm_s.rpd next to tfm_s.bin, or bl2.rpd next to bl2.bin with BL2), for the
+# Renesas tools (e2 studio / RFP) to set the security boundaries. Each
+# @NAME@ in the template is a partition variable from the SoC's
+# s_ns_memory.cmake / fsp_post_config.cmake, written out in hex.
+function(ra_generate_rpd _template _output)
+    file(READ ${_template} _content)
+    string(REGEX MATCHALL "@[A-Z0-9_]+@" _refs "${_content}")
+    foreach(_ref IN LISTS _refs)
+        string(REGEX REPLACE "^@(.*)@$" "\\1" _var "${_ref}")
+        if(NOT DEFINED ${_var})
+            message(FATAL_ERROR "${_template}: ${_var} is not defined")
+        endif()
+        # math() results are decimal; normalize to hex. Function scope, so the
+        # caller's value is left untouched.
+        math(EXPR ${_var} "${${_var}}" OUTPUT_FORMAT HEXADECIMAL)
+    endforeach()
+    configure_file(${_template} ${_output} @ONLY)
+endfunction()
+
+if(BL2)
+    set(_ra_rpd_file bl2.rpd)
+else()
+    set(_ra_rpd_file tfm_s.rpd)
+endif()
+
+ra_generate_rpd(${RENESAS_RA_SOC_SOURCE_DIR}/partition/tfm_s.rpd.in
+                ${CMAKE_BINARY_DIR}/bin/${_ra_rpd_file})
+
+#========================= Platform Secure ====================================#
+
+target_compile_options(platform_s
+    PUBLIC
+    ${COMPILER_CP_FLAG}
+    ${COMPILER_CMSE_FLAG}
+)
+
+target_link_options(platform_s
+    PUBLIC
+    ${LINKER_CP_OPTION}
+)
+
+target_link_libraries(platform_s
+    PUBLIC
+    fsp_library
+    cmsis
+)
+
+target_sources(platform_s
+    INTERFACE
+        $<$<STREQUAL:"${TFM_FIH_PROFILE}","HIGH">:${PLATFORM_DIR}/ext/common/template/tfm_fih_platform.c>
+    PRIVATE
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/CMSIS_Driver/Driver_USART.c
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/CMSIS_Driver/Driver_Flash.c
+    ${PLATFORM_DIR}/ext/common/uart_stdout.c
+    $<$<OR:$<BOOL:${TFM_S_REG_TEST}>,$<BOOL:${TFM_NS_REG_TEST}>>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/plat_test.c>
+)
+
+#========================= Platform BL2 =======================================#
+
+if(BL2)
+    include(${CMAKE_CURRENT_LIST_DIR}/bl2.cmake)
+endif()
+
+#========================= Firmware Update partition ==========================#
+
+# DEFAULT_MCUBOOT_FLASH_MAP is OFF, so the FWU partition (bl2/src/flash_map.c)
+# uses the platform flash map, the same one as BL2.
+if(BL2 AND TFM_PARTITION_FIRMWARE_UPDATE)
+    target_sources(tfm_psa_rot_partition_fwu
+        PRIVATE
+        ${RENESAS_RA_COMMON_SOURCE_DIR}/core/bl2/flash_map_bl2.c
+    )
+endif()
+
+#========================= tfm_spm ============================================#
+
+target_sources(tfm_spm
+    PRIVATE
+    target_cfg.c
+    ${PLATFORM_DIR}/ext/common/tfm_hal_platform_v8m.c
+    ${PLATFORM_DIR}/ext/common/tfm_hal_isolation_v8m.c
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_hal_platform.c
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_platform_system.c
+    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_peripherals_def.c
+    $<$<BOOL:${TFM_MULTI_CORE_TOPOLOGY}>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/platform_multicore.c>
+    $<$<BOOL:${TFM_MULTI_CORE_TOPOLOGY}>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_hal_multi_core.c>
+    $<$<BOOL:${TFM_MULTI_CORE_TOPOLOGY}>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_hal_mailbox.c>
+    $<$<OR:$<BOOL:${CONFIG_TFM_FLIH_API}>,$<BOOL:${CONFIG_TFM_SLIH_API}>>:${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_interrupts.c>
+)
+
+#========================= Files for building NS side platform ================#
+
+configure_file(${RENESAS_RA_COMMON_SOURCE_DIR}/core/ns/cpuarch_ns.cmake.in
+               ${CMAKE_BINARY_DIR}/generated/platform/cmake/cpuarch.cmake
+               @ONLY)
+configure_file(${RENESAS_RA_COMMON_SOURCE_DIR}/core/ns/config.cmake.in
+               ${CMAKE_BINARY_DIR}/generated/platform/cmake/config.cmake
+               @ONLY)
+
+install(FILES       ${CMAKE_BINARY_DIR}/generated/platform/cmake/cpuarch.cmake
+                    ${CMAKE_BINARY_DIR}/generated/platform/cmake/config.cmake
+        DESTINATION ${INSTALL_PLATFORM_NS_DIR}
+)
+
+install(FILES       ${CMAKE_BINARY_DIR}/generated/platform/fsp/bsp_clock_cfg.h
+        DESTINATION ${INSTALL_PLATFORM_NS_DIR}/fsp
+)
+
+install(DIRECTORY   ${TARGET_PLATFORM_PATH}/ns/
+        DESTINATION ${INSTALL_PLATFORM_NS_DIR}
+)
+
+install(FILES       ${TARGET_PLATFORM_PATH}/check_config.cmake
+        DESTINATION ${INSTALL_PLATFORM_NS_DIR}
+)
+
+# Install NS linker scripts
+install(FILES       ${RENESAS_RA_COMMON_SOURCE_DIR}/core/scripts/gcc/tfm_common_ns.ld
+                    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/scripts/armclang/tfm_common_ns.sct
+                    ${RENESAS_RA_COMMON_SOURCE_DIR}/core/scripts/atfe/tfm_common_ns.ldc
+        DESTINATION ${INSTALL_PLATFORM_NS_DIR}/linker_scripts
+)
+
+# NS-side mailbox platform source
+if(RA_CM33_NS_PRESENT)
+    install(
+        FILES
+            ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/platform_ns_mailbox.c
+            ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/platform_multicore.c
+        DESTINATION
+            ${INSTALL_PLATFORM_NS_DIR}/../interface/src/multi_core
+    )
+
+    install(
+        FILES
+            ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/inc/platform_multicore.h
+        DESTINATION
+            ${INSTALL_PLATFORM_NS_DIR}/../interface/include/multi_core
+    )
+endif()
+
+# NS-side RA ioctl interface, installed so it can be reused outside the TF-M NS build (e.g. Zephyr driver init)
+install(FILES       ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/inc/tfm_ioctl_api.h
+        DESTINATION ${INSTALL_PLATFORM_NS_DIR}/../interface/include
+)
+
+install(FILES       ${RENESAS_RA_COMMON_SOURCE_DIR}/core/services/src/tfm_ioctl_ns_api.c
+        DESTINATION ${INSTALL_PLATFORM_NS_DIR}/../interface/src
+)
+
+# Install test configs if present
+if(EXISTS ${TARGET_PLATFORM_PATH}/tests)
+    install(DIRECTORY   ${TARGET_PLATFORM_PATH}/tests
+            DESTINATION ${INSTALL_PLATFORM_NS_DIR})
+endif()
diff --git a/platform/ext/target/renesas/ra/common/core/config.cmake b/platform/ext/target/renesas/ra/common/core/config.cmake
new file mode 100644
index 000000000..532f34a59
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/config.cmake
@@ -0,0 +1,100 @@
+#-------------------------------------------------------------------------------
+# Copyright (c) 2026 Renesas Electronics Corporation
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#-------------------------------------------------------------------------------
+
+# Configuration shared by every Renesas RA board, included last by each board's
+# config.cmake
+
+#===================== Which non-secure clients the SPE serves =================#
+#
+# These two are the platform's view of its topology, and everything else is
+# derived from them:
+#
+#   RA_CM85_NS_PRESENT  CPU0 (Cortex-M85) runs a local non-secure image that
+#                       calls into the SPE across the TrustZone transition.
+#   RA_CM33_NS_PRESENT  CPU1 (Cortex-M33) runs a remote non-secure image that
+#                       calls into the SPE over the mailbox.
+
+#===================== Derived TF-M switches ===================================#
+
+set(CONFIG_TFM_USE_TRUSTZONE   ${RA_CM85_NS_PRESENT} CACHE BOOL "Use TrustZone to transition between NSPE and SPE")
+set(TFM_MULTI_CORE_TOPOLOGY    ${RA_CM33_NS_PRESENT} CACHE BOOL "Build for a dual-cpu architecture (CPU1 as a remote PSA client)")
+
+#===================== Flash instances =========================================#
+#
+# Instance 0 is the on-chip MRAM (FLASH0_*, the SoC config.cmake). Instance 1
+# (FLASH1_*) is the flash an NS image is relocated to by moving its ROM alias
+# off the MRAM alias, e.g. -DCPU0_NS_ROM_ALIAS_BASE=0x88000000 (see
+# RA_NS_WINDOW_* in the SoC config.cmake). Which device it is (MRAM or OSPI
+# flash) is a build time choice made through its driver and geometry. Its
+# geometry defaults to the MRAM one and is overridable on the command line.
+#
+# FLASH1_DEV_NAME is the name of its CMSIS flash driver. While it is empty no
+# driver exists for it, so the areas in it fall back to the MRAM driver
+# (check_config.cmake warns about that with BL2).
+set(FLASH1_DEV_NAME     ""                        CACHE STRING "CMSIS flash driver of flash instance 1 (empty: fall back to the MRAM driver)")
+set(FLASH1_SECTOR_SIZE  "${FLASH0_SECTOR_SIZE}"   CACHE STRING "Flash instance 1 FS block granularity")
+set(FLASH1_PROGRAM_UNIT "${FLASH0_PROGRAM_UNIT}"  CACHE STRING "Flash instance 1 minimum write size in bytes")
+
+#===================== Platform-wide TF-M configuration ========================#
+
+# BL2 (MCUboot) is opt-in. With BL2 every image is signed separately: S, the
+# CPU0 NS image and, with RA_CM33_NS_PRESENT, the CPU1 NS image
+# (MCUBOOT_IMAGE_NUMBER 2 or 3). BL2 only verifies the CPU1 image, the SPE
+# starts CPU1. Only overwrite upgrades are supported: MRAM has no scratch area
+# or bank swap, and the secondary slot of an image sits next to its primary
+# slot, in the same flash instance. The default MCUboot flash map handles at
+# most 2 images, so the platform provides its own
+# (common/core/bl2/flash_map_bl2.c). check_config.cmake enforces this.
+# BL2 and the SPE sign every image separately, so no combined S+NS image is
+# built (see core/ns/common.cmake).
+set(BL2                        OFF   CACHE BOOL   "Whether to build BL2")
+
+if(BL2)
+    set(FLASH_AREA_BL2_OFFSET   "0x0"     CACHE STRING "BL2 offset")
+    set(FLASH_AREA_BL2_SIZE     "0x10000" CACHE STRING "BL2 size")
+
+    if(RA_CM33_NS_PRESENT)
+        set(MCUBOOT_IMAGE_NUMBER 3                CACHE STRING "Number of images managed by MCUboot (S, CPU0 NS, CPU1 NS)")
+    else()
+        set(MCUBOOT_IMAGE_NUMBER 2                CACHE STRING "Whether to combine S and NS into either 1 image, or sign each seperately")
+    endif()
+    set(DEFAULT_MCUBOOT_FLASH_MAP OFF             CACHE BOOL   "Whether to use the default flash map defined by TF-M project")
+    set(MCUBOOT_UPGRADE_STRATEGY "OVERWRITE_ONLY" CACHE STRING "Upgrade strategy for images")
+    set(MCUBOOT_SIGNATURE_TYPE   "EC-P256"        CACHE STRING "Algorithm to use for signature validation [RSA-2048, RSA-3072, EC-P256, EC-P384]")
+    set(MCUBOOT_HW_KEY           ON               CACHE BOOL   "Whether to embed the entire public key in the image metadata instead of the hash only")
+    # MCUboot trailer writes must be a multiple of the program unit of every
+    # flash instance (FLASH_PROGRAM_UNIT, the largest one); check_config.cmake
+    # enforces this.
+    set(MCUBOOT_ALIGN_VAL        4                CACHE STRING "align option for mcuboot and build image with imgtool [1, 2, 4, 8, 16, 32]")
+    # CPU1 NS image (MCUboot image 2). It is signed with the S key: the default
+    # provisioning stores the S key hash in BL2_ROTPK_2.
+    set(MCUBOOT_IMAGE_VERSION_CPU1_NS    0.0.0    CACHE STRING "Version number of the CPU1 NS image")
+    set(MCUBOOT_SECURITY_COUNTER_CPU1_NS 1        CACHE STRING "Security counter for the CPU1 NS image. auto sets it to MCUBOOT_IMAGE_VERSION_CPU1_NS")
+    # The FWU partition (TFM_PARTITION_FIRMWARE_UPDATE) writes the secondary
+    # slots through the platform flash map; one FWU component per MCUboot image.
+    set(PLATFORM_HAS_FIRMWARE_UPDATE_SUPPORT ON)
+else()
+    set(FLASH_AREA_BL2_OFFSET   "0x0"    CACHE STRING "BL2 offset")
+    set(FLASH_AREA_BL2_SIZE     "0x0"    CACHE STRING "BL2 size")
+endif()
+
+set(CONFIG_TFM_SPM_BACKEND     IPC CACHE STRING "The SPM backend")
+set(CONFIG_TFM_INCLUDE_STDLIBC ON  CACHE BOOL   "Include standard C libraries and startup code or not")
+set(CONFIG_TFM_ENABLE_FP       ON  CACHE BOOL   "Enable floating point support")
+set(TFM_PARTITION_PLATFORM     ON  CACHE BOOL   "Enable Platform partition" FORCE)
+
+#===================== Generated sources =======================================#
+
+# The RA linker-script templates are only generated for the secure image; the
+# path below points into the TF-M source tree and is meaningless to an NS build.
+if(S_BUILD)
+    if(NOT TFM_EXTRA_GENERATED_FILE_LIST_PATH)
+        set(TFM_EXTRA_GENERATED_FILE_LIST_PATH "" CACHE PATH "List of Paths to extra generated file list. Appended to standard TFM generated file list.")
+    endif()
+
+    list(APPEND TFM_EXTRA_GENERATED_FILE_LIST_PATH "${RENESAS_RA_COMMON_SOURCE_DIR}/core/generated_file_list.yaml")
+endif()
