+# ---- Non-secure external windows (OSPI0/1 CS0/CS1, SDRAM) --------------------
+# The *_CPU0_N_* partition bases are the non-secure external address windows,
+# single-sourced from RA_NS_WINDOW_STARTS/ENDS (config.cmake, also consumed by
+# check_config.cmake to validate off-chip image placement).
+
+# Helper: expand one window into its CPU0_N partition variables (fixed hardware facts, not cache).
+function(_ra_define_n_window _prefix _start _end)
+    math(EXPR _size "${_end} - ${_start}" OUTPUT_FORMAT HEXADECIMAL)
+    set(${_prefix}_CPU0_N_START "${_start}" PARENT_SCOPE)
+    set(${_prefix}_CPU0_N_SIZE "${_size}" PARENT_SCOPE)
+endfunction()
