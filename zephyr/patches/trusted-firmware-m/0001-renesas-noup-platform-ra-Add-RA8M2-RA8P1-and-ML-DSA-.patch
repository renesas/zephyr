diff --git a/platform/ext/target/renesas/ra/common/core/fsp/0001-Initial-support-for-TF-M.patch b/platform/ext/target/renesas/ra/common/core/fsp/0001-Initial-support-for-TF-M.patch
new file mode 100644
index 000000000..62f102690
--- /dev/null
+++ b/platform/ext/target/renesas/ra/common/core/fsp/0001-Initial-support-for-TF-M.patch
@@ -0,0 +1,115 @@
+From 49fe745a7b45862f91f2e11a3cae169489cb1152 Mon Sep 17 00:00:00 2001
+From: Khai Cao <khai.cao.xk@renesas.com>
+Date: Thu, 17 Sep 2026 07:41:58 +0000
+Subject: [PATCH] [tfm patch] Initial support for TF-M
+
+Initial commit to support TF-M
+
+Signed-off-by: Khai Cao <khai.cao.xk@renesas.com>
+---
+ .../bsp/cmsis/Device/RENESAS/Source/system.c  | 37 ++++++++++++++-----
+ 1 file changed, 27 insertions(+), 10 deletions(-)
+
+diff --git a/ra/fsp/src/bsp/cmsis/Device/RENESAS/Source/system.c b/ra/fsp/src/bsp/cmsis/Device/RENESAS/Source/system.c
+index dd17e90f7..d06fd5707 100644
+--- a/ra/fsp/src/bsp/cmsis/Device/RENESAS/Source/system.c
++++ b/ra/fsp/src/bsp/cmsis/Device/RENESAS/Source/system.c
+@@ -40,8 +40,15 @@
+ #define BSP_PRV_PRCR_KEY                              (0xA500U)
+ #define BSP_PRV_PRCR_PRC1_UNLOCK                      ((BSP_PRV_PRCR_KEY) | 0x2U)
+ #define BSP_PRV_PRCR_LOCK                             ((BSP_PRV_PRCR_KEY) | 0x0U)
+-#define BSP_PRV_STACK_LIMIT                           ((uint32_t) &g_main_stack[0])
+-#define BSP_PRV_STACK_TOP                             ((uint32_t) (uint32_t) &g_main_stack[BSP_CFG_STACK_MAIN_BYTES])
++/* Use CMSIS toolchain-provided stack boundary symbols when available. */
++#if defined(__STACK_LIMIT) && defined(__INITIAL_SP)
++ #define BSP_PRV_STACK_LIMIT                           ((uint32_t) &__STACK_LIMIT)
++ #define BSP_PRV_STACK_TOP                             ((uint32_t) &__INITIAL_SP)
++#else
++/* Fallback to use FSP main stack variable. */
++ #define BSP_PRV_STACK_LIMIT                           ((uint32_t) &g_main_stack[0])
++ #define BSP_PRV_STACK_TOP                             ((uint32_t) (uint32_t) &g_main_stack[BSP_CFG_STACK_MAIN_BYTES])
++#endif
+ #define BSP_TZ_STACK_SEAL_VALUE                       (0xFEF5EDA5)
+ 
+ #define ARMV8_MPU_REGION_MIN_SIZE                     (32U)
+@@ -86,7 +93,15 @@ extern void __call_ctors(void const *, void const *);
+ #endif
+ 
+ extern void  * __VECTOR_TABLE[];
++
++/* Use CMSIS toolchain-provided stack boundary symbols when available. */
++#if defined(__STACK_LIMIT) && defined(__INITIAL_SP)
++extern uint32_t __INITIAL_SP;
++extern uint32_t __STACK_LIMIT;
++#else
++/* Fallback to use FSP main stack variable. */
+ extern uint8_t g_main_stack[];
++#endif
+ 
+ extern void R_BSP_SAUInit(void);
+ extern void R_BSP_SecurityInit(void);
+@@ -218,7 +233,7 @@ void SystemInit (void)
+     /* Seal the main stack for secure projects. Reference:
+      * https://developer.arm.com/documentation/100720/0300
+      * https://developer.arm.com/support/arm-security-updates/armv8-m-stack-sealing */
+-    uint32_t * p_main_stack_top = (uint32_t *) &g_main_stack[BSP_CFG_STACK_MAIN_BYTES];
++    uint32_t * p_main_stack_top = (uint32_t *) BSP_PRV_STACK_TOP;
+     *p_main_stack_top = BSP_TZ_STACK_SEAL_VALUE;
+ 
+  #if BSP_SECONDARY_CORE_BUILD
+@@ -481,15 +496,15 @@ void SystemInit (void)
+     _init_tls(&__tls_base);
+     _set_tls(&__tls_base);
+  #endif
+-#endif
+ 
+-#if defined(__ICCARM__)
++ #if defined(__ICCARM__)
+ 
+     /* Copy main thread TLS to RAM. */
+  #pragma section="__DLIB_PERTHREAD_init"
+  #pragma section="__DLIB_PERTHREAD"
+     memcpy((uint32_t *) __section_begin("__DLIB_PERTHREAD"), (uint32_t *) __section_begin("__DLIB_PERTHREAD_init"),
+            (uint32_t) __section_size("__DLIB_PERTHREAD_init"));
++ #endif
+ #endif
+ 
+ #if defined(RENESAS_CORTEX_M85)
+@@ -498,27 +513,29 @@ void SystemInit (void)
+     SCB_InvalidateICache();
+ #endif
+ 
