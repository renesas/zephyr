+/**
+ * @brief Test ML-DSA-87 NIST KeyGen KAT and PSA sign/verify flow.
+ *
+ * The test imports a NIST ACVP 32-byte seed as an ML-DSA-87
+ * key pair, exports and compares the derived public key with the
+ * expected NIST public key, signs a fixed message, and verifies
+ * the generated signature using the NIST public key.
+ *
+ * The signature verification is also tested with a corrupted
+ * signature to confirm that it is rejected.
+ *
+ * @note A NIST ACVP SigVer KAT is not included because the available
+ *       valid ML-DSA-87 SigVer vectors use non-empty contexts, while
+ *       the current PSA/PQCP driver uses an empty context.
+ *
+ * @note A NIST ACVP SigGen KAT is not included because the SigGen
+ *       vectors provide an expanded secret key, while the current
+ *       PSA/PQCP driver imports a 32-byte seed as the key-pair
+ *       representation.
+ *
+ * @param[out] ret Test result
+ */
+void tfm_crypto_test_mldsa87_sign_verify(struct test_result_t *ret)
+{
+    static const uint8_t message[] = {
+        'T', 'F', '-', 'M', ' ',
+        'M', 'L', '-', 'D', 'S', 'A', '-', '8', '7'
+    };
+
+    /*
+     * Keep these buffers out of the test thread stack.
+     * Their combined size is 7219 bytes.
+     */
+    static uint8_t generated_public_key[MLDSA87_PUBLIC_KEY_BYTES];
+    static uint8_t signature[MLDSA87_SIGNATURE_BYTES];
+
+    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+    mbedtls_svc_key_id_t sign_key_id = MBEDTLS_SVC_KEY_ID_INIT;
+    mbedtls_svc_key_id_t verify_key_id = MBEDTLS_SVC_KEY_ID_INIT;
+
+    bool sign_key_created = false;
+    bool verify_key_created = false;
+
+    size_t public_key_length = 0u;
+    size_t signature_length = 0u;
+    psa_status_t status;
+
+    ret->val = TEST_FAILED;
+
+    /*
+     * Step 1: Import the NIST ACVP 32-byte seed as a volatile
+     * ML-DSA-87 key pair.
+     */
+    psa_set_key_type(&attributes, PSA_KEY_TYPE_ML_DSA_KEY_PAIR);
+    psa_set_key_bits(&attributes, MLDSA87_KEY_BITS);
+    psa_set_key_lifetime(&attributes, PSA_KEY_LIFETIME_VOLATILE);
+    psa_set_key_algorithm(&attributes,
+                          PSA_ALG_DETERMINISTIC_ML_DSA);
+    psa_set_key_usage_flags(&attributes,
+                            PSA_KEY_USAGE_SIGN_MESSAGE |
+                            PSA_KEY_USAGE_EXPORT);
+
+    status = psa_import_key(&attributes,
+                            mldsa87_keygen_seed,
+                            sizeof(mldsa87_keygen_seed),
+                            &sign_key_id);
+    if (status != PSA_SUCCESS) {
+        TEST_LOG("ML-DSA-87 NIST seed import failed: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    sign_key_created = true;
+
+    /*
+     * Step 2: Export the public key derived from the NIST seed.
+     */
+    status = psa_export_public_key(sign_key_id,
+                                   generated_public_key,
+                                   sizeof(generated_public_key),
+                                   &public_key_length);
+    if (status != PSA_SUCCESS) {
+        TEST_LOG("ML-DSA-87 public-key export failed: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    if (public_key_length !=
+        sizeof(mldsa87_keygen_expected_public_key)) {
+        TEST_LOG("Unexpected ML-DSA-87 public-key length: %u\r\n",
+                 (unsigned int)public_key_length);
+        goto cleanup;
+    }
+
+    /*
+     * Step 3: Compare the generated public key with the expected
+     * NIST ACVP public key.
+     */
+    if (memcmp(generated_public_key,
+               mldsa87_keygen_expected_public_key,
+               sizeof(mldsa87_keygen_expected_public_key)) != 0) {
+        TEST_LOG("Generated ML-DSA-87 public key does not match "
+                 "the NIST ACVP KeyGen vector\r\n");
+        goto cleanup;
+    }
+
+    /*
+     * Step 4: Sign a fixed message using deterministic
+     * Pure ML-DSA-87.
+     *
+     * This step validates the PSA sign integration. It is not a
+     * NIST ACVP SigGen KAT.
+     */
+    status = psa_sign_message(sign_key_id,
+                              PSA_ALG_DETERMINISTIC_ML_DSA,
+                              message,
+                              sizeof(message),
+                              signature,
+                              sizeof(signature),
+                              &signature_length);
+    if (status != PSA_SUCCESS) {
+        TEST_LOG("ML-DSA-87 message signing failed: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    if (signature_length != MLDSA87_SIGNATURE_BYTES) {
+        TEST_LOG("Unexpected ML-DSA-87 signature length: %u\r\n",
+                 (unsigned int)signature_length);
+        goto cleanup;
+    }
+
+    /*
+     * Step 5: Destroy the signing key before importing the
+     * public verification key.
+     */
+    status = psa_destroy_key(sign_key_id);
+    if (status != PSA_SUCCESS) {
+        TEST_LOG("ML-DSA-87 signing-key destruction failed: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    sign_key_created = false;
+    sign_key_id = MBEDTLS_SVC_KEY_ID_INIT;
+
+    psa_reset_key_attributes(&attributes);
+
+    /*
+     * Step 6: Import the expected NIST public key as a separate
+     * volatile verification key.
+     */
+    psa_set_key_type(&attributes, PSA_KEY_TYPE_ML_DSA_PUBLIC_KEY);
+    psa_set_key_bits(&attributes, MLDSA87_KEY_BITS);
+    psa_set_key_lifetime(&attributes, PSA_KEY_LIFETIME_VOLATILE);
+    psa_set_key_algorithm(&attributes,
+                          PSA_ALG_DETERMINISTIC_ML_DSA);
+    psa_set_key_usage_flags(&attributes,
+                            PSA_KEY_USAGE_VERIFY_MESSAGE);
+
+    status = psa_import_key(&attributes,
+                            mldsa87_keygen_expected_public_key,
+                            sizeof(mldsa87_keygen_expected_public_key),
+                            &verify_key_id);
+    if (status != PSA_SUCCESS) {
+        TEST_LOG("ML-DSA-87 public-key import failed: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    verify_key_created = true;
+
+    /*
+     * Step 7: Verify the generated signature.
+     *
+     * This step validates the PSA verify integration. It is not a
+     * NIST ACVP SigVer KAT.
+     */
+    status = psa_verify_message(verify_key_id,
+                                PSA_ALG_DETERMINISTIC_ML_DSA,
+                                message,
+                                sizeof(message),
+                                signature,
+                                signature_length);
+    if (status != PSA_SUCCESS) {
+        TEST_LOG("ML-DSA-87 valid-signature verification failed: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    /*
+     * Step 8: Corrupt one signature byte and confirm that the
+     * signature is rejected.
+     */
+    signature[0] ^= 0x01u;
+
+    status = psa_verify_message(verify_key_id,
+                                PSA_ALG_DETERMINISTIC_ML_DSA,
+                                message,
+                                sizeof(message),
+                                signature,
+                                signature_length);
+
+    /* Restore the original signature. */
+    signature[0] ^= 0x01u;
+
+    if (status != PSA_ERROR_INVALID_SIGNATURE) {
+        TEST_LOG("Corrupted ML-DSA-87 signature returned: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    /*
+     * Step 9: Destroy the public verification key.
+     */
+    status = psa_destroy_key(verify_key_id);
+    if (status != PSA_SUCCESS) {
+        TEST_LOG("ML-DSA-87 verification-key destruction failed: %d\r\n",
+                 (int)status);
+        goto cleanup;
+    }
+
+    verify_key_created = false;
+    verify_key_id = MBEDTLS_SVC_KEY_ID_INIT;
+
+    ret->val = TEST_PASSED;
+
+cleanup:
+    if (sign_key_created) {
+        status = psa_destroy_key(sign_key_id);
+        if (status != PSA_SUCCESS) {
+            TEST_LOG("ML-DSA-87 signing-key cleanup failed: %d\r\n",
+                     (int)status);
+            ret->val = TEST_FAILED;
+        }
+    }
+
+    if (verify_key_created) {
+        status = psa_destroy_key(verify_key_id);
+        if (status != PSA_SUCCESS) {
+            TEST_LOG("ML-DSA-87 verification-key cleanup failed: %d\r\n",
+                     (int)status);
+            ret->val = TEST_FAILED;
+        }
+    }
+
+    psa_reset_key_attributes(&attributes);
+}
