if BOARD_EK_RA8P1

if DISK_DRIVER_SDMMC

config SD_CMD_TIMEOUT
	default 1000

endif # DISK_DRIVER_SDMMC

configdefault ETH_DRIVER
	default y

# Enable fixed clock for ethernet phy
config CLOCK_CONTROL_FIXED_RATE_CLOCK
	default y if ETH_PHY_DRIVER

if BUILD_WITH_TFM

# Flash the merged TF-M (Secure) and Zephyr (Non-Secure) image by default
config TFM_FLASH_MERGED_BINARY
	default y

endif # BUILD_WITH_TFM

endif # BOARD_EK_RA8P1
