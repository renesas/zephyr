# Enable GPIO
CONFIG_GPIO=y

# Enable Console
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y

# The application (and MCUboot) execute XIP directly out of the OSPI flash
# on this board variant (see zephyr,code-partition in the .dts). Relocate
# the OSPI_B driver, jesd216.c, and the FSP HAL to RAM so they remain
# reachable once OSPI_B leaves memory-mapped mode to service an
# erase/write/status command. FLASH_RENESAS_RA_OSPI_B is gated behind
# CONFIG_FLASH; without it enabled here, CODE_DATA_RELOCATION has nothing
# to relocate and the build fails outright (even for apps, like
# hello_world, that never touch the flash API themselves).
CONFIG_FLASH=y
CONFIG_CODE_DATA_RELOCATION=y

# CODE_DATA_RELOCATION alone only copies the relocated sections into RAM; it
# does not grant the MPU execute permission on that RAM range. Without this,
# the static MPU regions (arch/arm/core/mpu/arm_core_mpu.c) never cover
# .ram_text_reloc, so any relocated function faults/hangs the moment it's
# called.
CONFIG_CODE_DATA_RELOCATION_SRAM=y

# MCUboot hands off its already-derived OSPI_B XIP configuration to the
# application via the "zephyr,ospi-xip-handoff" retention area (see the
# sram@220ffe00 node in this board's .dts and flash_ospi_b_xip_handoff_export()
# in flash_renesas_ra_ospi_b.c), so the application never re-toggles OM_RESET
# or re-reads SFDP on this flash part (mx25lw51245g reports
# JESD216_SFDP_BFP_DW18_BYTE_ORDER_SWAPPED, which makes that reprobe corrupt
# already-programmed XIP content - see the driver for details). Both MCUboot
# and the application need the retention driver enabled to write/read it.
CONFIG_RETENTION=y
CONFIG_RETAINED_MEM=y
