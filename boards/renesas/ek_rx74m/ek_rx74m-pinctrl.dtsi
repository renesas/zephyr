&pinctrl {
	sci12_default: sci12_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_SCI_12, 1, 14)>, /* TX */
				<RX_PSEL(RX_PSEL_SCI_12, 1, 15)>; /* RX */
		};
	};

	xspi0_default: xspi0_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_XSPI0_1A, 0xD, 1)>, /* SCLK */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xD, 6)>, /* DQS */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xD, 2)>, /* SIO0 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xD, 3)>, /* SIO1 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xD, 4)>, /* SIO2 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xD, 5)>, /* SIO3 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x6, 0)>, /* SIO4 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x6, 1)>, /* SIO5 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x6, 2)>, /* SIO6 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x6, 3)>; /* SIO7 */
			drive-strength = "DRV6";
		};

		group2 {
			psels = <RX_PSEL(RX_PSEL_XSPI0_1A, 0xD, 7)>, /* CS0 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x6, 6)>, /* RST */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x6, 5)>; /* INT0 */
			drive-strength = "DRV3";
		};
	};

	xspi1_default: xspi1_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_XSPI0_1A, 0xE, 1)>, /* SCLK */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xE, 6)>, /* DQS */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xE, 2)>, /* SIO0 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xE, 3)>, /* SIO1 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xE, 4)>, /* SIO2 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xE, 5)>, /* SIO3 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x7, 8)>, /* SIO4 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x7, 9)>, /* SIO5 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x7, 10)>, /* SIO6 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0x7, 11)>; /* SIO7 */
			drive-strength = "DRV6";
		};

		group2 {
			psels = <RX_PSEL(RX_PSEL_XSPI0_1A, 0xE, 7)>, /* CS0 */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xF, 8)>, /* RST */
				<RX_PSEL(RX_PSEL_XSPI0_1A, 0xF, 9)>; /* INT0 */
			drive-strength = "DRV3";
		};
	};

	canfd0_default: canfd0_default {
		group1 {
			/* CRX0 CTX0 */
			psels = <RX_PSEL(RX_PSEL_CANFD, 8, 5)>,
				<RX_PSEL(RX_PSEL_CANFD, 8, 4)>;
			drive-strength = "DRV4";
		};
	};

	mdio_default: mdio_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 4)>, /* MDC PG04 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 5)>, /* MDIO PG05 */
			        <RX_PSEL(RX_PSEL_CLKOUT, 3, 4)>; /* P304 as ETHPHYCLK. */
		};
	};

	rmac0_default: rmac0_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 8)>, /* RXD4 P508 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 9)>, /* RXD5 P509 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 10)>, /* RXD6 P510 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 11)>, /* RXD7 P511 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 12)>, /* TXD4 PC512 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 13)>, /* TXD5 PC513 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 14)>, /* TXD6 PC514 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 5, 15)>, /* TXD7 PC515 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 11, 0)>, /* RXD0 PB00 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 11, 1)>, /* RXD1 PB01 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 11, 2)>, /* RXD2 PB02 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 11, 3)>, /* RXD3 PB03 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 11, 4)>, /* RX_CLK PB04 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 11, 5)>, /* RX_CTRL PB05 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 11, 6)>, /* RX_ER PB06 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 0)>, /* TX_CLK PC00 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 1)>, /* TXD0 PC01 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 2)>, /* TXD1 PC02 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 3)>, /* TXD2 PC03 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 4)>, /* TXD3 PC04 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 5)>, /* TX_EN/TX_CTL PC05 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 6)>, /* SOS */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 12, 7)>, /* GTX_CLK PC07 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 6)>, /* COL PG06 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 7)>, /* CRS PG07 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 3)>; /* MDINT PG03 */
		};
	};

	rmac1_default: rmac1_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 12)>, /* RXD4 P712 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 13)>, /* RXD5 P713 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 14)>, /* RXD6 P714 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 15)>, /* RXD7 P715 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 8)>, /* TXD4 PG08 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 9)>, /* TXD5 PG09 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 10)>, /* TXD6 PG10 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 11)>, /* TXD7 PG11 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 4)>, /* RXD0 P704 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 5)>, /* RXD1 P705 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 6)>, /* RXD2 P706 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 7)>, /* RXD3 P707 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 0)>, /* RX_CLK PG00 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 1)>, /* RX_CTRL PG01 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 2)>, /* RX_ER PG02 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 10, 2)>, /* TX_CLK PA02 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 10, 3)>, /* TXD0 PA03 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 10, 4)>, /* TXD1 PA04 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 10, 5)>, /* TXD2 PA05 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 10, 6)>, /* TXD3 PA06 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 10, 1)>, /* TX_EN/TX_CTL PA01 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 10, 0)>, /* GTX_CLK PA00 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 12)>, /* COL PG12 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 16, 15)>, /* CRS PG15 */
			        <RX_PSEL(RX_PSEL_ETH_RMAC_GMII_MII, 7, 0)>; /* MDINT P700 */
		};
	};

	usbhs_default: usbhs_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_USBHS, 2, 4)>; /* VBUS-DS */
			drive-strength = "DRV4";
		};
	};

	usbfs_default: usbfs_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_USBFS, 0x1, 1)>, /* VBUS */
				<RX_PSEL(RX_PSEL_USBFS, 0xF, 0)>, /* D+ */
				<RX_PSEL(RX_PSEL_USBFS, 0xF, 1)>; /* D- */
			drive-strength = "DRV4";
		};
	};

	sci1_default: sci1_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_SCI_1, 9, 1)>, /* SDA P901*/
				<RX_PSEL(RX_PSEL_SCI_1, 9, 0)>; /* SCL P900*/
		};
	};

	spi1_default: spi1_default {
		group1 {
			/* MISO MOSI RSPCK SSL*/
			psels = <RX_PSEL(RX_PSEL_SPI, 2, 7)>,
				<RX_PSEL(RX_PSEL_SPI, 2, 6)>,
				<RX_PSEL(RX_PSEL_SPI, 2, 5)>,
				<RX_PSEL(RX_PSEL_SPI, 2, 4)>;
			drive-strength = "DRV4";
		};
	};
};

