/dts-v1/;

#include <renesas/r5k574x.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "ek_rx74m-pinctrl.dtsi"

/ {
	model = "Renesas EK-RX74M";
	compatible = "renesas,ek_rx74m";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &mram0;
		zephyr,console = &uart12;
		zephyr,shell-uart = &uart12;
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&ioportf 5 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};

		led2: led2 {
			gpios = <&ioport8 7 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};

		led3: led3 {
			gpios = <&ioport6 4 GPIO_ACTIVE_HIGH>;
			label = "LED3";
		};
	};

	buttons {
		compatible = "gpio-keys";

		sw1: sw1 {
			label = "sw1";
			gpios = <&ioport4 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		sw2: sw2 {
			label = "sw2";
			gpios = <&ioport1 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		sw0 = &sw1;
		sw1 = &sw2;
	};
};

&xtal {
	clock-frequency = <DT_FREQ_M(24)>;
	mosel = <0>;
	#clock-cells = <0>;
	status = "okay";
};

&subclk {
	status = "okay";
};

&pll {
	status = "okay";
	freq = <DT_FREQ_M(1200)>;

	pllp: pllp {
		div = <3>;
		freq = <DT_FREQ_M(400)>;
		status = "okay";
	};

	pllq: pllq {
		div = <4>;
		freq = <DT_FREQ_M(300)>;
		status = "okay";
	};

	pllr: pllr {
		div = <5>;
		freq = <DT_FREQ_M(240)>;
		status = "okay";
	};
};

&pll2 {
	status = "okay";

	/* PLL */
	clocks = <&xtal>;
	div = <3>;
	mul = <125 0>;
	freq = <DT_FREQ_M(1000)>;

	pll2p: pll2p {
		div = <2>;
		freq = <DT_FREQ_M(500)>;
		status = "okay";
	};
};

&uclk {
	clocks = <&pllr>;
	div = <5>;
	status = "okay";
};

&usb60clk {
	clocks = <&pllr>;
	div = <4>;
	status = "okay";
};

&sciclk {
	clocks = <&pllp>;
	status = "okay";
};

&cmt {
	clock-frequency = <6250000>;
	status = "okay";
};

&eswclk {
	compatible = "renesas,rx-cgc-pclk";
	clocks = <&pllq>;
	div = <2>;
	#clock-cells = <2>;
	status = "okay";
};

&eswphyclk {
	compatible = "renesas,rx-cgc-pclk";
	clocks = <&pll2p>;
	div = <1>;
	#clock-cells = <2>;
	status = "okay";
};

&ethphyclk {
	compatible = "renesas,rx-cgc-pclk";
	clocks = <&pllp>;
	div = <16>;
	#clock-cells = <2>;
	status = "okay";
};

&sci12 {
	pinctrl-0 = <&sci12_default>;
	pinctrl-names = "default";
	status = "okay";

	uart12: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&ioport6 {
	status = "okay";
};

&ioport8 {
	status = "okay";
};

&ioportf {
	status = "okay";
};

&ioport4 {
	status = "okay";
};

&ioport1 {
	status = "okay";
};

&port_irq17 {
	status = "okay";
};

&port_irq30 {
	status = "okay";
};

&group_irq_al4 {
	status = "okay";
};

&eswm {
	status = "okay";
};

&rmac0 {
	local-mac-address = [74 90 50 A8 60 6A];
	status = "okay";
};

&mdio0 {
	pinctrl-0 = <&mdio_default>;
	pinctrl-names = "default";
	status = "okay";

	phy: ethernet-phy@0 {
		compatible = "microchip,vsc8541";
		reg = <0x0>;
		status = "okay";

		reset-gpios = <&ioport4 13 GPIO_ACTIVE_LOW>;

		microchip,interface-type = "gmii";
		microchip,rgmii-tx-clk-delay = <0x4>;
		microchip,rgmii-rx-clk-delay = <0x4>;
	};
};

&usbhs {
	pinctrl-0 = <&usbhs_default>;
	pinctrl-names = "default";
	maximum-speed = "high-speed";
	status = "okay";

	zephyr_udc0: udc {
		status = "okay";
	};
};

&usbfs {
	pinctrl-0 = <&usbfs_default>;
	pinctrl-names = "default";
	maximum-speed = "full-speed";
};

&usbhs_phy {
	phys-clock-src = "xtal";
};

&group_irq_al1 {
	status = "okay";
};
