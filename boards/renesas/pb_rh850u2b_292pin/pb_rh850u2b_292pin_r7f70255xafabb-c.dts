/dts-v1/;

#include <rh850/renesas/rh850u2b/r7f70255xxfabb-c.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>

#include "pb_rh850u2b_292pin-pinctrl.dtsi"

/ {
	model = "Renesas RH850 U2B 292pin";
	compatible = "renesas,u2b10", "renesas,u2b";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,system-timer = &ostm0;
		zephyr,crc = &crc0;
		zephyr,canbus = &canfd0;
	};

	aliases {
		led0 = &led2;
		watchdog0 = &wdtb0;
		pwm-led0 = &pwm_led_0;
		pwm-led1 = &pwm_led_1;
	};

	leds {
		compatible = "gpio-leds";

		led2: led2 {
			gpios = <&ioport11 0 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led_0: pwm_led_0 {
			pwms = <&pwm0_slave 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM LED 0";
		};

		pwm_led_1: pwm_led_1 {
			pwms = <&pwm1_slave 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "PWM LED 1";
		};
	};
};

&pwm0_master {
	status = "okay";
};

&pwm0_slave {
	pinctrl-0 = <&pwm0_slave_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pwm1_slave {
	pinctrl-0 = <&pwm1_slave_default>;
	pinctrl-names = "default";
	status = "okay";
};

&taud3p0 {
	pinctrl-0 = <&taud3p0_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&taud3p1 {
	pinctrl-0 = <&taud3p1_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&taud3p2 {
	pinctrl-0 = <&taud3p2_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&ostm0 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&rlin30 {
	pinctrl-0 = <&rlin30_default>;
	pinctrl-names = "default";
	status = "okay";

	uart0: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&irq35 {
	trigger-type = "falling";
	pinctrl-0 = <&irq35_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&irq36 {
	trigger-type = "falling";
	pinctrl-0 = <&irq36_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&ioport11 {
	status = "okay";
};

&mspi0 {
	pinctrl-0 = <&mspi0_default>;
	pinctrl-names = "default";
	channel = <0>;
	status = "okay";
};

&mspi1 {
	pinctrl-0 = <&mspi1_default>;
	pinctrl-names = "default";
	channel = <0>;
	status = "okay";
};

&wdtb0 {
	status = "okay";
};

&crc0 {
	status = "okay";
};

&canfd_global {
	status = "okay";
};

&canfd0 {
	pinctrl-0 = <&canfd0_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd1 {
	pinctrl-0 = <&canfd1_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&etnd0_mdio {
	pinctrl-0 = <&etnd0_mdio_default>;
	pinctrl-names = "default";

	eth_phy0: ethernet-phy@1f {
		compatible = "ethernet-phy";
		reg = <0x1f>;
		reset-gpios = <&ioport10 8 GPIO_ACTIVE_LOW>;
		reset-assert-duration-us = <1000>;
		reset-deassertion-timeout-ms = <10>;
		default-speeds = "10BASE Full-Duplex", "100BASE Full-Duplex";
		status = "disabled";
	};
};

&etnd0 {
	pinctrl-0 = <&etnd0_mii_default>;
	pinctrl-names = "default";
	phy-handle = <&eth_phy0>;
	phy-connection-type = "mii";
	local-mac-address = [74 90 50 54 53 4e];
};
