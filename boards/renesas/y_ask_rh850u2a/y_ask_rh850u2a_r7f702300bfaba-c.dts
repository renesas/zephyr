/dts-v1/;

#include <rh850/renesas/rh850u2a/r7f702300xxaba-c.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>

#include "y_ask_rh850u2a-pinctrl.dtsi"

/ {
	model = "Renesas RH850 U2A 292pin";
	compatible = "renesas,y-ask-rh850u2a", "renesas,u2a";

	chosen {
		zephyr,console = &uart9;
		zephyr,shell-uart = &uart9;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,system-timer = &ostm0;
		zephyr,canbus = &canfd0;
		zephyr,display = &oled_display;
	};

	aliases {
		led0 = &led0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&ioport2 1 GPIO_ACTIVE_HIGH>;
			label = "LED0";
		};
	};
};

&ostm0 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&rlin39 {
	pinctrl-0 = <&rlin39_default>;
	pinctrl-names = "default";
	status = "okay";

	uart9: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&ioport2 {
	status = "okay";
};

&canfd_global {
	status = "okay";
};

&canfd0 {
	pinctrl-0 = <&canfd0_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd1 {
	pinctrl-0 = <&canfd1_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&iic0 {
	pinctrl-0 = <&iic0_default>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "okay";

	oled_display: display-controller@3d {
		compatible = "solomon,ssd1306";
		reg = <0x3d>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		inversion-on;
		prechargep = <0x22>;
		reset-gpios = <&ioport2 14 GPIO_ACTIVE_LOW>;
	};
};
