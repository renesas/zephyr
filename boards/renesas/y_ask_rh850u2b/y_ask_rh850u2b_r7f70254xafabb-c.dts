/dts-v1/;

#include <rh850/renesas/rh850u2b/r7f70254xxfabb-c.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/input/input-event-codes.h>

#include "y_ask_rh850u2b-pinctrl.dtsi"

/ {
	model = "Renesas RH850 U2B Starter Kit";
	compatible = "renesas,u2b10", "renesas,u2b";

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,system-timer = &ostm0;
		zephyr,canbus = &canfd0;
		zephyr,display = &oled_display;
	};

	aliases {
		led0 = &led20;
		sw0 = &sw2;
	};

	leds {
		compatible = "gpio-leds";

		led20: led20 {
			gpios = <&ioport32 1 GPIO_ACTIVE_HIGH>;
			label = "LED20";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		sw2: sw2 {
			label = "sw2";
			gpios = <&ioport10 6 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		sw3: sw3 {
			label = "sw3";
			gpios = <&ioport14 0 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	mdio_gpio: mdio {
		compatible = "zephyr,mdio-gpio";
		mdc-gpios = <&ioport25 5 GPIO_ACTIVE_HIGH>;
		mdio-gpios = <&ioport25 6 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		eth_phy0: ethernet-phy@1f {
			compatible = "ethernet-phy";
			reg = <0x1f>;
			reset-gpios = <&ioport10 8 GPIO_ACTIVE_LOW>;
			reset-assert-duration-us = <1000>;
			reset-deassertion-timeout-ms = <10>;
			default-speeds = "10BASE Full-Duplex", "100BASE Full-Duplex";
			status = "disabled";
		};
	};
};

&ostm0 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&rlin31 {
	pinctrl-0 = <&rlin31_default>;
	pinctrl-names = "default";
	status = "okay";

	uart1: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&ioport32 {
	status = "okay";
};

&ioport10 {
	irqs = <&irq4 6>;
	status = "okay";
};

&ioport14 {
	irqs = <&irq13 0>;
	status = "okay";
};

&irq4 {
	trigger-type = "falling";
	pinctrl-0 = <&irq4_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&irq13 {
	trigger-type = "falling";
	pinctrl-0 = <&irq13_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&canfd_global {
	status = "okay";
};

&canfd0 {
	pinctrl-0 = <&canfd0_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd6 {
	pinctrl-0 = <&canfd6_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&ioport25 {
	status = "okay";
};

&etnd0 {
	pinctrl-0 = <&etnd0_rmii_default>;
	pinctrl-names = "default";
	phy-handle = <&eth_phy0>;
	phy-connection-type = "rmii";
	local-mac-address = [74 90 50 54 53 4e];
};

&ioport20 {
	status = "okay";
};

&ioport23 {
	status = "okay";
};

&ioport33 {
	status = "okay";
};

&mspi5 {
	pinctrl-0 = <&mspi5_oled_default>;
	pinctrl-names = "default";
	cs-gpios = <&ioport23 2 GPIO_ACTIVE_LOW>;
	status = "okay";

	oled_display: display-controller@0 {
		compatible = "solomon,ssd1306";
		reg = <0>;
		spi-max-frequency = <1000000>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		inversion-on;
		prechargep = <0x22>;
		data-cmd-gpios = <&ioport20 6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&ioport33 8 GPIO_ACTIVE_LOW>;
	};
};
