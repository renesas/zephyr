/dts-v1/;

#include <dt-bindings/input/input-event-codes.h>
#include <rh850/renesas/rh850u2c/r7f702600afabb-c.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>

#include "pb_rh850u2c_292pin-pinctrl.dtsi"

/ {
	model = "Renesas RH850 U2C 292pin";
	compatible = "renesas,pb-rh850u2c-292pin", "renesas,u2c";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,system-timer = &ostm0;
		zephyr,crc = &crc0;
		zephyr,canbus = &canfd0;
	};

	aliases {
		led0 = &led10;
		watchdog0 = &wdtb0;
		pwm-led0 = &pwm_led_0;
		pwm-led1 = &pwm_led_1;
		i2s0 = &ssif0;
	};

	leds {
		compatible = "gpio-leds";

		led10: led10 {
			gpios = <&ioaport4 0 GPIO_ACTIVE_HIGH>;
			label = "LED10";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led_0: pwm_led_0 {
			pwms = <&pwm0_slave 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM LED 0";
		};

		pwm_led_1: pwm_led_1 {
			pwms = <&pwm1_slave 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "PWM LED 1";
		};
	};
};

&pwm0_master {
	status = "okay";
};

&pwm0_slave {
	pinctrl-0 = <&pwm0_slave_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pwm1_slave {
	pinctrl-0 = <&pwm1_slave_default>;
	pinctrl-names = "default";
	status = "okay";
};

&taud3p0 {
	pinctrl-0 = <&taud3p0_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&taud3p1 {
	pinctrl-0 = <&taud3p1_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&ostm0 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&rlin30 {
	pinctrl-0 = <&rlin30_default>;
	pinctrl-names = "default";
	status = "okay";

	uart0: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&etnf0 {
	pinctrl-0 = <&etnf0_default>;
	pinctrl-names = "default";
	local-mac-address = [74 90 50 12 34 56];
	mdio-interface = "shared";
	pma-filtered;
};

&ct25205 {
	plca-enable;
	plca-node-id = <0>;
	plca-node-count = <8>;
	plca-burst-count = <0>;
	plca-burst-timer = <128>;
	plca-to-timer = <32>;
};

&irq17 {
	trigger-type = "falling";
	pinctrl-0 = <&irq17_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&irq35 {
	trigger-type = "falling";
	pinctrl-0 = <&irq35_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&ioport2 {
	irqs = <&irq35 4>;
	status = "okay";
};

&ioaport4 {
	status = "okay";
};

&mspitx_ored0 {
	status = "okay";
};

&mspirx_ored0 {
	status = "okay";
};

&mspite_ored0 {
	status = "okay";
};

&mspier_ored0 {
	status = "okay";
};

&mspitx_ored1 {
	status = "okay";
};

&mspirx_ored1 {
	status = "okay";
};

&mspite_ored1 {
	status = "okay";
};

&mspier_ored1 {
	status = "okay";
};

&canfderi_ored0 {
	status = "okay";
};

&canfdtxi_ored0 {
	status = "okay";
};

&canfdrxi_ored0 {
	status = "okay";
};

&mspi0 {
	pinctrl-0 = <&mspi0_default>;
	pinctrl-names = "default";
	interrupts-extended = <&intc2 76 1>,
			      <&intc2 79 1>,
			      <&mspite_ored0>,
			      <&mspier_ored0>;
	interrupt-names = "txi", "rxi", "tei", "eri";
	channel = <0>;
	status = "okay";
};

&mspi1 {
	pinctrl-0 = <&mspi1_default>;
	pinctrl-names = "default";
	interrupts-extended = <&mspitx_ored1>,
			      <&mspirx_ored1>,
			      <&mspite_ored1>,
			      <&mspier_ored1>;
	interrupt-names = "txi", "rxi", "tei", "eri";
	channel = <0>;
	status = "okay";
};

&wdtb0 {
	status = "okay";
};

&crc0 {
	status = "okay";
};

&canfd_global {
	status = "okay";
};

&canfd1_global {
	status = "okay";
};

&canfd0 {
	pinctrl-0 = <&canfd0_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd1 {
	pinctrl-0 = <&canfd1_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd8 {
	pinctrl-0 = <&canfd8_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd9 {
	pinctrl-0 = <&canfd9_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&iic0 {
	pinctrl-0 = <&iic0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&iic1 {
	pinctrl-0 = <&iic1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&iic2 {
	pinctrl-0 = <&iic2_default>;
	pinctrl-names = "default";
	status = "okay";
};

&ssif0 {
	pinctrl-0 = <&ssif0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&ssif1 {
	pinctrl-0 = <&ssif1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&etnd0_mdio {
	pinctrl-0 = <&etnd0_mdio_default>;
	pinctrl-names = "default";

	eth_phy0: ethernet-phy@1f {
		compatible = "ethernet-phy";
		reg = <0x1f>;
		reset-gpios = <&ioport21 10 GPIO_ACTIVE_LOW>;
		reset-assert-duration-us = <1000>;
		reset-deassertion-timeout-ms = <10>;
		default-speeds = "10BASE Full-Duplex", "100BASE Full-Duplex";
		status = "disabled";
	};
};

&etnd0 {
	pinctrl-0 = <&etnd0_mii_default>;
	pinctrl-names = "default";
	phy-handle = <&eth_phy0>;
	phy-connection-type = "mii";
	local-mac-address = [74 90 50 54 53 4e];
};

&sent0 {
	pinctrl-0 = <&sent0_default>;
	pinctrl-names = "default";
	status = "disabled";

	channel@0 {
		status = "disabled";
	};
};

&sent1 {
	pinctrl-0 = <&sent1_default>;
	pinctrl-names = "default";
	status = "disabled";

	channel@0 {
		status = "disabled";
	};
};
