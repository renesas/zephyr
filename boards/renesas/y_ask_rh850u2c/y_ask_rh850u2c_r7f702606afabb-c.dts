/dts-v1/;

#include <rh850/renesas/rh850u2c/r7f702606afabb-c.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/input/input-event-codes.h>

#include "y_ask_rh850u2c-pinctrl.dtsi"

/ {
	model = "Renesas RH850 U2C Starter Kit";
	compatible = "renesas,u2c4", "renesas,u2c";

	chosen {
		zephyr,console = &uart11;
		zephyr,shell-uart = &uart11;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,system-timer = &ostm0;
		zephyr,canbus = &canfd2;
	};

	aliases {
		led0 = &led10;
		sw0 = &sw2;
	};

	leds {
		compatible = "gpio-leds";

		led10: led10 {
			gpios = <&ioport4 0 GPIO_ACTIVE_HIGH>;
			label = "LED10";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		sw2: sw2 {
			label = "sw2";
			gpios = <&ioport4 10 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		sw3: sw3 {
			label = "sw3";
			gpios = <&ioport24 6 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&ostm0 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&rlin311 {
	pinctrl-0 = <&rlin311_default>;
	pinctrl-names = "default";
	status = "okay";

	uart11: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&ioport4 {
	irqs = <&irq25 10>;
	status = "okay";
};

&ioport24 {
	irqs = <&irq33 6>;
	status = "okay";
};

&irq25 {
	trigger-type = "falling";
	pinctrl-0 = <&irq25_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&irq33 {
	trigger-type = "falling";
	pinctrl-0 = <&irq33_ioport>;
	pinctrl-names = "default";
	status = "okay";
};

&canfd_global {
	status = "okay";
};

&canfd2 {
	pinctrl-0 = <&canfd2_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd1 {
	pinctrl-0 = <&canfd1_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfderi_ored0 {
	status = "okay";
};

&canfdrxi_ored0 {
	status = "okay";
};

&canfdtxi_ored0 {
	status = "okay";
};

&ioport17 {
	status = "okay";

	/*
	 * Change to output-low in an application overlay when the board is
	 * not at an end of the bus.
	 */
	ets0_term: ets0_term {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&etnf0 {
	pinctrl-0 = <&etnf0_default>;
	pinctrl-names = "default";
	local-mac-address = [74 90 50 12 34 56];
	mdio-interface = "shared";
	pma-filtered;
};

&ct25205 {
	plca-enable;
	plca-node-id = <0>;
	plca-node-count = <8>;
	plca-burst-count = <0>;
	plca-burst-timer = <128>;
	plca-to-timer = <32>;
};

&etnd0_mdio {
	pinctrl-0 = <&etnd0_mdio_default>;
	pinctrl-names = "default";

	eth_phy0: ethernet-phy@1f {
		compatible = "ethernet-phy";
		reg = <0x1f>;
		reset-gpios = <&ioport17 13 GPIO_ACTIVE_LOW>;
		reset-assert-duration-us = <1000>;
		reset-deassertion-timeout-ms = <10>;
		default-speeds = "10BASE Full-Duplex", "100BASE Full-Duplex";
		status = "disabled";
	};
};

&etnd0 {
	pinctrl-0 = <&etnd0_mii_default>;
	pinctrl-names = "default";
	phy-handle = <&eth_phy0>;
	phy-connection-type = "mii";
	local-mac-address = [74 90 50 54 53 4e];
};
