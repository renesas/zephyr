# Enable GPIO
CONFIG_GPIO=y

# Enable Console
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y

# Using the code partition for the non-secure image
CONFIG_USE_DT_CODE_PARTITION=y

# This board implies building Non-Secure firmware
CONFIG_TRUSTED_EXECUTION_NONSECURE=y

# Build with TF-M as the Secure Execution Environment
CONFIG_BUILD_WITH_TFM=y
# The shared NS partition map reserves BL2 (MCUboot) and secondary slots
CONFIG_TFM_BL2=y

# Use ML-DSA-87 (post-quantum, FIPS 204) as the MCUboot image signature algorithm
CONFIG_TFM_MCUBOOT_SIGNATURE_TYPE="ML-DSA-87"
