&pinctrl {
	sci12_default: sci12_default {
		group1 {
			psels = <RX_PSEL(RX_PSEL_SCI_12, 1, 14)>, /* TX */
				<RX_PSEL(RX_PSEL_SCI_12, 1, 15)>; /* RX */
		};
	};

	sci1_default: sci1_default {
		group1 {
			psels = <RX_PSEL(0xD, 9, 1)>, /* SDA P901*/
				<RX_PSEL(0xD, 9, 0)>; /* SCL P900*/
		};
	};

	spi1_default: spi1_default {
		group1 {
			/* MISO MOSI RSPCK SSL*/
			psels = <RX_PSEL(0x10, 2, 7)>,
				<RX_PSEL(0x10, 2, 6)>,
				<RX_PSEL(0x10, 2, 5)>,
				<RX_PSEL(0x10, 2, 4)>;
			drive-strength = "DRV4";
		};
	};

	canfd0_default: canfd0_default {
		group1 {
			/* CRX0 CTX0 */
			psels = <RX_PSEL(RX_PSEL_CANFD, 8, 5)>,
				<RX_PSEL(RX_PSEL_CANFD, 8, 4)>;
			drive-strength = "DRV4";
		};
	};
};
