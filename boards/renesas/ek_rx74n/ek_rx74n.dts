/dts-v1/;

#include <renesas/r5k574ncx.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include "ek_rx74n-pinctrl.dtsi"

/ {
	compatible = "renesas,ek_rx74n";
	model = "Renesas EK-RX74N";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &mram0;
		zephyr,console = &uart12;
		zephyr,shell-uart = &uart12;
<<<<<<< HEAD
=======
		zephyr,flash-controller = &code_flash_ctrl;
		zephyr,code-partition = &slot0_partition;
		zephyr,canbus = &canfdg0;
>>>>>>> 46722ea6b51 (board: renesas: rx: Add CANFD support for EK-RX74N)
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&ioportf 5 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};

		led2: led2 {
			gpios = <&ioport8 7 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};

		led3: led3 {
			gpios = <&ioport6 4 GPIO_ACTIVE_HIGH>;
			label = "LED3";
		};
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
	};

	transceiver0: can-phy0 {
		compatible = "can-transceiver-gpio";
		standby-gpios = <&ioport8 1 GPIO_ACTIVE_HIGH>;
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};
};

&xtal {
	clock-frequency = <DT_FREQ_M(24)>;
	mosel = <0>;
	#clock-cells = <0>;
	status = "okay";
};

&subclk {
	status = "okay";
};

&pll {
	status = "okay";
	freq = <DT_FREQ_M(1200)>;

	pllp: pllp {
		div = <2>;
		freq = <DT_FREQ_M(600)>;
		status = "okay";
	};

	pllq: pllq {
		div = <3>;
		freq = <DT_FREQ_M(400)>;
		status = "okay";
	};
};

&sciclk {
	clocks = <&pllp>;
	status = "okay";
};

&canfdclk {
	clocks = <&pllq>;
	div = <5>;
	status = "okay";
};

&cmt {
	clock-frequency = <9375000>;
	status = "okay";
};

&sci12 {
	pinctrl-0 = <&sci12_default>;
	pinctrl-names = "default";
	status = "okay";

	uart12: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&canfdg_global {
	status = "okay";

	canfdg0: canfdg0 {
		pinctrl-0 = <&canfdg0_default>;
		pinctrl-names = "default";
		rx-max-filters = <64>;
		phys = <&transceiver0>;
		status = "okay";
	};
};

&group_irq_al2 {
	status = "okay";
};

&ioport6 {
	status = "okay";
};

&ioport8 {
	status = "okay";
};

&ioportf {
	status = "okay";
};
