/dts-v1/;

#include <renesas/r5k574ncx.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include "ek_rx74n-pinctrl.dtsi"

/ {
	model = "Renesas EK-RX74N";
	compatible = "renesas,ek_rx74n";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &code_mram;
		zephyr,console = &uart12;
		zephyr,shell-uart = &uart12;
		zephyr,flash-controller = &code_flash_ctrl;
		zephyr,code-partition = &slot0_partition;
		zephyr,canbus = &canfdg0;
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&ioportf 5 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};

		led2: led2 {
			gpios = <&ioport8 7 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};

		led3: led3 {
			gpios = <&ioport6 4 GPIO_ACTIVE_HIGH>;
			label = "LED3";
		};
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		rtc = &rtc;
	};

	transceiver0: can-phy0 {
		compatible = "can-transceiver-gpio";
		standby-gpios = <&ioport8 1 GPIO_ACTIVE_HIGH>;
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};
};

&xtal {
	clock-frequency = <DT_FREQ_M(24)>;
	mosel = <0>;
	#clock-cells = <0>;
	status = "okay";
};

&subclk {
	status = "okay";
};

&pll {
	status = "okay";
	freq = <DT_FREQ_M(1200)>;

	pllp: pllp {
		div = <2>;
		freq = <DT_FREQ_M(600)>;
		status = "okay";
	};

	pllq: pllq {
		div = <3>;
		freq = <DT_FREQ_M(400)>;
		status = "okay";
	};
};

&sciclk {
	clocks = <&pllp>;
	status = "okay";
};

&canfdclk {
	clocks = <&pllq>;
	div = <5>;
	status = "okay";
};

&cmt {
	clock-frequency = <9375000>;
	status = "okay";
};

&sci12 {
	pinctrl-0 = <&sci12_default>;
	pinctrl-names = "default";
	status = "okay";

	uart12: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&code_mram {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		slot0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x0 DT_SIZE_K(448)>;
		};

		slot1_partition: partition@70000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x70000 DT_SIZE_K(448)>;
		};

		boot_partition: partition@e0000 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0xe0000 DT_SIZE_K(128)>;
		};
	};
};

&spi1 {
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&group_irq_al0 {
	status = "okay";
};

&group_irq_al1 {
	status = "okay";
};

&sci1 {
	pinctrl-0 = <&sci1_default>;
	pinctrl-names = "default";

	i2c1: i2c {
		sda-output-delay = <300>;
		noise-filter-clock-select = <1>;
		bit-rate-modulation;
	};
};

&canfdg_global {
	status = "okay";

	canfdg0: canfdg0 {
		pinctrl-0 = <&canfd0_default>;
		pinctrl-names = "default";
		rx-max-filters = <64>;
		phys = <&transceiver0>;
		status = "okay";
	};
};

&group_irq_al2 {
	status = "okay";
};

&ioport6 {
	status = "okay";
};

&ioport8 {
	status = "okay";
};

&ioportf {
	status = "okay";
};

&rtc {
	status = "okay";
};
