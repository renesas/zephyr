/dts-v1/;

#include <renesas/r5k574ncx.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/flash_controller/xspi.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr.h>
#include "ek_rx74n-pinctrl.dtsi"

/ {
	model = "Renesas EK-RX74N";
	compatible = "renesas,ek_rx74n";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &code_mram;
		zephyr,console = &uart12;
		zephyr,shell-uart = &uart12;
		zephyr,flash-controller = &code_flash_ctrl;
		zephyr,code-partition = &slot0_partition;
		zephyr,canbus = &canfdg0;
		zephyr,entropy = &trng;
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&ioportf 5 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};

		led2: led2 {
			gpios = <&ioport8 7 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};

		led3: led3 {
			gpios = <&ioport6 4 GPIO_ACTIVE_HIGH>;
			label = "LED3";
		};
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		rtc = &rtc;
	};

	transceiver0: can-phy0 {
		compatible = "can-transceiver-gpio";
		standby-gpios = <&ioport8 1 GPIO_ACTIVE_HIGH>;
		max-bitrate = <5000000>;
		#phy-cells = <0>;
	};

	psram: memory@50000000 {
		compatible = "zephyr,memory-region";
		reg = <0x50000000 DT_SIZE_M(32)>;
		zephyr,memory-region = "PSRAM";
		status = "okay";
	};
};

&xtal {
	clock-frequency = <DT_FREQ_M(24)>;
	mosel = <0>;
	#clock-cells = <0>;
	status = "okay";
};

&subclk {
	status = "okay";
};

&pll {
	status = "okay";
	freq = <DT_FREQ_M(1200)>;

	pllp: pllp {
		div = <2>;
		freq = <DT_FREQ_M(600)>;
		status = "okay";
	};

	pllq: pllq {
		div = <3>;
		freq = <DT_FREQ_M(400)>;
		status = "okay";
	};
};

&sciclk {
	clocks = <&pllp>;
	status = "okay";
};

&canfdclk {
	clocks = <&pllq>;
	div = <5>;
	status = "okay";
};

&octaspiclk {
	clocks = <&pllp>;
	div = <3>;
	status = "okay";
};

&cmt {
	clock-frequency = <9375000>;
	status = "okay";
};

&sci12 {
	pinctrl-0 = <&sci12_default>;
	pinctrl-names = "default";
	status = "okay";

	uart12: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&code_mram {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		slot0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x0 DT_SIZE_K(448)>;
		};

		slot1_partition: partition@70000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x70000 DT_SIZE_K(448)>;
		};

		boot_partition: partition@e0000 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0xe0000 DT_SIZE_K(128)>;
		};
	};
};

&spi1 {
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&group_irq_al0 {
	status = "okay";
};

&group_irq_al1 {
	status = "okay";
};

&group_irq_al5 {
	status = "okay";
};

&sci1 {
	pinctrl-0 = <&sci1_default>;
	pinctrl-names = "default";

	i2c1: i2c {
		sda-output-delay = <300>;
		noise-filter-clock-select = <1>;
		bit-rate-modulation;
	};
};

&canfdg_global {
	status = "okay";

	canfdg0: canfdg0 {
		pinctrl-0 = <&canfd0_default>;
		pinctrl-names = "default";
		rx-max-filters = <64>;
		phys = <&transceiver0>;
		status = "okay";
	};
};

&group_irq_al2 {
	status = "okay";
};

&ioport6 {
	status = "okay";
};

&ioport8 {
	status = "okay";
};

&ioportf {
	status = "okay";
};

&rtc {
	status = "okay";
};

&trng {
	status = "okay";
};

&xspi0 {
	pinctrl-0 = <&xspi0_default>;
	pinctrl-names = "default";
	ranges = <0x00000000 0x20000000 DT_SIZE_M(512)>;
	status = "okay";

	mx25lw51245g_ctrl: nor-flash-controller@10000000 {
		compatible = "renesas,rx-xspi-nor";
		reg = <0x10000000 DT_SIZE_M(64)>;
		size = <DT_SIZE_M(64)>; /* 512 Megabits = 64 Megabytes */
		ospi-max-frequency = <DT_FREQ_M(133)>;
		protocol-mode = <XSPI_OCTO_MODE>;
		data-rate = <XSPI_DTR_TRANSFER>;
		write-block-size = <2>;
		output-assert-delay = "ASSERTION_DELAY_ENABLED";
		ddr-sampling-extension = <3>;
		cs = <0>;
		auto-calib-pattern-address-sector = <3>;
		jedec-id = [c2 86 3a];
		rdsr-addr-4bytes;
		default-8d-dummy-cycles = <20>;
		status = "okay";

		#address-cells = <1>;
		#size-cells = <1>;

		mx25lw51245g: nor-flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(64)>;
			erase-block-size = <DT_SIZE_K(64)>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				partition@0 {
					label = "nor";
					reg = <0x00000000 DT_SIZE_M(64)>;
				};
			};
		};
	};
};

&xspi1 {
	pinctrl-0 = <&xspi1_default>;
	pinctrl-names = "default";
	ranges = <0x00000000 0x40000000 DT_SIZE_M(512)>;
	status = "okay";

	memc: is66wvo32m8d: memory@10000000 {
		compatible = "renesas,rx-xspi-psram";
		variable-latency;
		reg = <0x10000000 DT_SIZE_M(32)>;
		cs = <0>;
		size = <DT_SIZE_M(32)>; /* 32 Megabytes */
		ospi-max-frequency = <DT_FREQ_M(200)>;
		spi-protocol = "8D_8D_8D";
		address-mode = "ARRAY";
		frame-format = "XSPI_PROFILE_1";
		write-size-bytes = <32>;
		ds-latch-delay = <22>;
		address-bytes = <4>;
		command-to-command-interval = <2>;
		ddr-sampling-extension = <0>;
		command-bytes = <2>;
		read-dummy-cycles = <5>;
		write-dummy-cycles = <5>;
		write-command = <0x2000>;
		read-command = <0xA000>;
		write-data-mask-enable;
		status = "okay";
	};
};
