/dts-v1/;

#include <rh850/renesas/rh850u2a/r7f702300.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>

#include "pb_rh850u2a_516pin-pinctrl.dtsi"

/ {
	model = "Renesas RH850 U2A 516pin";
	compatible = "renesas,pb-rh850u2a-516pin", "renesas,u2a";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,system-timer = &ostm0;
		zephyr,crc = &crc0;
		zephyr,canbus = &canfd0;
	};

	aliases {
		led0 = &led0;
		watchdog0 = &wdtba;
		pwm-led0 = &pwm_led_0;
		pwm-led1 = &pwm_led_1;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&ioport11 0 GPIO_ACTIVE_HIGH>;
			label = "LED0";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led_0: pwm_led_0 {
			pwms = <&pwm0_ch0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM LED 0";
		};

		pwm_led_1: pwm_led_1 {
			pwms = <&pwm0_ch0 2 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "PWM LED 1";
		};
	};
};

&pwm0_ch0 {
	pinctrl-0 = <&pwm_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pwm0_ch1 {
	status = "okay";
};

&pwm0_ch2 {
	status = "okay";
};

&taud3p0 {
	pinctrl-0 = <&taud3p0_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&taud3p1 {
	pinctrl-0 = <&taud3p1_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&ostm0 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&rlin30 {
	pinctrl-0 = <&rlin30_default>;
	pinctrl-names = "default";
	status = "okay";

	uart0: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&mspi0 {
	pinctrl-0 = <&mspi0_default>;
	pinctrl-names = "default";
	channel = <0>;
	status = "okay";
};

&mspi1 {
	pinctrl-0 = <&mspi1_default>;
	pinctrl-names = "default";
	channel = <0>;
	status = "okay";
};

&canfd_global {
	status = "okay";
};

&canfd1_global {
	status = "okay";
};

&canfd0 {
	pinctrl-0 = <&canfd0_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd1 {
	pinctrl-0 = <&canfd1_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd8 {
	pinctrl-0 = <&canfd8_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&canfd9 {
	pinctrl-0 = <&canfd9_default>;
	pinctrl-names = "default";
	status = "okay";
	rx-max-filters = <128>;
};

&ioport11 {
	status = "okay";
};

&iic0 {
	pinctrl-0 = <&iic0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&iic1 {
	pinctrl-0 = <&iic1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&wdtba {
	status = "okay";
};

&crc0 {
	status = "okay";
};

&ioport10 {
	status = "okay";
};

&sent1 {
	pinctrl-0 = <&sent1_default>;
	pinctrl-names = "default";
	status = "disabled";

	channel@0 {
		status = "disabled";
	};
};
