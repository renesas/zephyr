#include <dt-bindings/pinctrl/renesas/pinctrl-rh850u2a.h>

&pinctrl {
	rlin30_default: rlin30_default {
		group1 {
			psels = <RH850_PSEL(PORT_10, 0, ALT_OUT4)>,
				<RH850_PSEL(PORT_10, 5, ALT_IN7)>;
		};
	};

	iic0_default: iic0_default {
		group1 {
			psels = <RH850_PSEL(PORT_17, 2, ALT_OUT4)>,
				<RH850_PSEL(PORT_17, 3, ALT_OUT4)>;
			drive-strength = "low";
			renesas,bidirect-control;
			bias-pull-up;
			drive-open-drain;
		};
	};

	iic1_default: iic1_default {
		group1 {
			psels = <RH850_PSEL(PORT_22, 3, ALT_OUT5)>,
				<RH850_PSEL(PORT_22, 4, ALT_OUT5)>;
			drive-strength = "low";
			renesas,bidirect-control;
			bias-pull-up;
			drive-open-drain;
		};
	};

	mspi0_default: mspi0_default {
		group1 {
			psels = <RH850_PSEL(PORT_04, 5, ALT_OUT2)>,
				<RH850_PSEL(PORT_02, 3, ALT_OUT3)>,
				<RH850_PSEL(PORT_04, 6, ALT_OUT2)>;
			drive-strength = "medium";
		};

		group2 {
			psels = <RH850_PSEL(PORT_04, 7, ALT_IN2)>;
			drive-strength = "very low";
		};
	};

	mspi1_default: mspi1_default {
		group1 {
			psels = <RH850_PSEL(PORT_02, 2, ALT_IN3)>,
				<RH850_PSEL(PORT_02, 0, ALT_OUT2)>,
				<RH850_PSEL(PORT_05, 2, ALT_OUT3)>;
			drive-strength = "medium";
		};

		group2 {
			psels = <RH850_PSEL(PORT_02, 1, ALT_IN3)>;
			drive-strength = "very low";
		};
	};

	pwm_default: pwm_default {
		group1 {
			psels = <RH850_PSEL(PORT_02, 1, ALT_OUT6)>,	/* ch1 */
				<RH850_PSEL(PORT_02, 2, ALT_OUT6)>;	/* ch2 */
			drive-strength = "medium";
		};

		group2 {
			psels = <RH850_PSEL(PORT_11, 6, ALT_IN6)>;	/* ch6 */
		};
	};

	taud3p0_default: taud3p0_default {
		group1 {
			psels = <RH850_PSEL(PORT_02, 2, ALT_OUT7)>,  /* U high */
				<RH850_PSEL(PORT_02, 3, ALT_OUT7)>,  /* U low  */
				<RH850_PSEL(PORT_02, 4, ALT_OUT7)>,  /* V high */
				<RH850_PSEL(PORT_02, 5, ALT_OUT7)>,  /* V low  */
				<RH850_PSEL(PORT_02, 6, ALT_OUT7)>,  /* W high */
				<RH850_PSEL(PORT_02, 7, ALT_OUT7)>;  /* W low  */
			renesas,direct-control;
		};
	};

	taud3p1_default: taud3p1_default {
		group1 {
			psels = <RH850_PSEL(PORT_21, 2, ALT_OUT6)>,  /* U high */
				<RH850_PSEL(PORT_21, 3, ALT_OUT6)>,  /* U low  */
				<RH850_PSEL(PORT_21, 4, ALT_OUT6)>,  /* V high */
				<RH850_PSEL(PORT_21, 5, ALT_OUT6)>,  /* V low  */
				<RH850_PSEL(PORT_21, 6, ALT_OUT6)>,  /* W high */
				<RH850_PSEL(PORT_21, 7, ALT_OUT6)>;  /* W low  */
			renesas,direct-control;
			drive-strength = "medium";
		};
	};

	canfd0_default: canfd0_default {
		group1 {
			psels = <RH850_PSEL(PORT_02, 7, ALT_OUT3)>,	/* TX */
				<RH850_PSEL(PORT_02, 6, ALT_IN8)>;	/* RX */
			drive-strength = "medium";
		};
	};

	canfd1_default: canfd1_default {
		group1 {
			psels = <RH850_PSEL(PORT_06, 8, ALT_OUT2)>,	/* TX */
				<RH850_PSEL(PORT_06, 7, ALT_IN7)>;	/* RX */
			drive-strength = "medium";
		};
	};

	canfd8_default: canfd8_default {
		group1 {
			psels = <RH850_PSEL(PORT_01, 0, ALT_OUT2)>,	/* TX */
				<RH850_PSEL(PORT_01, 1, ALT_IN7)>;	/* RX */
			drive-strength = "medium";
		};
	};

	canfd9_default: canfd9_default {
		group1 {
			psels = <RH850_PSEL(PORT_01, 2, ALT_OUT2)>,	/* TX */
				<RH850_PSEL(PORT_01, 3, ALT_IN7)>;	/* RX */
			drive-strength = "medium";
		};
	};

	sent0_default: sent0_default {
		group1 {
			psels = <RH850_PSEL(PORT_03, 4, ALT_IN3)>;
		};
	};

	sent1_default: sent1_default {
		group1 {
			psels = <RH850_PSEL(PORT_03, 5, ALT_IN3)>;
		};
	};
};
